{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome-types",
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@addins/*": [
        "src/addins/*"
      ],
      "@manifest/*": [
        "src/manifest/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@background/*": [
        "src/background/*"
      ],
      "@content/*": [
        "src/content/*"
      ],
      "@type/*": [
        "src/types/*"
      ],
      "@scripts/*": [
        "scripts/*"
      ]
    }
  },
  "include": [
    "src",
    "pages",
    "scripts",
    "vite.config.ts",
    "global.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}