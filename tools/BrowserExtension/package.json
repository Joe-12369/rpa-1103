{
  "name": "browserextension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "e": "npm run ext:build",
    "ep": "npm run ext:publish",
    "epk": "cross-env NODE_ENV=production tsx scripts/build-ext.ts --with-addins=off --no-pages --enable --no-minify --clean --key",
    "ez": "npm run ext:zip",
    "eu": "npm run ext:upload",
    "et": "npm run ext:test",
    "a": "npm run addins:build",
    "ap": "npm run addins:publish",
    "aps": "npm run addins:push",
    "p": "npm run pages:build",
    "pp": "npm run pages:publish",
    "pw": "npm run pages:watch",
    "dev": "npm install && npm run addins && npm run ext",
    "pages:watch": "tsx scripts/build-pages.ts watch",
    "pages": "npm run pages:build",
    "pages:build": "tsx scripts/build-pages.ts build",
    "pages:publish": "tsx scripts/build-pages.ts publish",
    "clean": "node node_modules/del-cli/cli.js dist/scripts dist/extensions \"dist/*.json\"",
    "addins": "npm run addins:build",
    "addins:build": "tsx scripts/build-addins.ts --clean",
    "addins:publish": "tsx scripts/build-addins.ts --clean --phase=publish",
    "addins:push": "tsx scripts/push-addins.ts",
    "addins:pull": "",
    "ext": "npm run ext:build",
    "ext:build": "cross-env NODE_ENV=development tsx scripts/build-ext.ts --enable --with-addins=inline --no-pages --clean --no-minify",
    "ext:publish": "cross-env NODE_ENV=production tsx scripts/build-ext.ts --with-addins=off --no-pages --enable --minify --clean",
    "ext:reload:ws": "node scripts/dev-reload-ws.js",
    "ext:zip": "tsx scripts/zip-ext.ts",
    "ext:upload": "tsx scripts/upload-ext.ts",
    "ext:test": "tsx scripts/test-ext.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^5.27.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsc": "^2.0.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/javascript-obfuscator": "^0.0.5",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin": "^5.0.1",
    "archiver": "^5.3.2",
    "chokidar": "^4.0.3",
    "chrome-types": "^0.1.377",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "javascript-obfuscator": "^4.1.1",
    "jszip": "^3.10.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "unplugin-antd-resolver": "^0.0.2",
    "vite": "^5.2.0",
    "ws": "^8.18.3"
  },
  "overrides": {
    "@ant-design/cssinjs": "1.24.0"
  },
  "exports": {
    ".": "./dist"
  }
}
