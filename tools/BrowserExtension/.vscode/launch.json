{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug addins",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "addins"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Release addins",
            "runtimeExecutable": "npm",
