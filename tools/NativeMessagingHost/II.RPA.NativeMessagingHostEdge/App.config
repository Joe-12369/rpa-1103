<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
	<appSettings>
		<add key="servicekey" value="8440b9eb7d03917b2509b5baeab2a299ce257eb0"/>
		<add key="processname" value="II.RPA.NativeMessagingHostEdge"/>
		<add key="logfile" value="II.RPA.NativeMessagHostEdge.txt"/>
    <add key="defTimeout" value="5000"/>
    <!--配置最低级别-->
    <add key="serilog:minimum-level" value="Information" />
    <!--日志保留天数（按文件夹）-->
    <add key="serilog:log-hold-days" value="5" />
    <!--单日最大文件数-->
    <add key="serilog:log-remain-file-count" value="10" />
	</appSettings>
  <runtime>
	<generatePublisherEvidence enabled="false" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-1.1.2.0" newVersion="1.1.2.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
