{
  "manifest_version": 3,
  "name": "实在Agent：AI智能体助理，开启智能办公新范式",
  "version": "4.0.0.134",
  "description": "实在Agent插件，v3版本能力再升级，查询数据、处理文档、填报表单、网页交互等各类网页操作场景轻松应对",
  "background": {
    "service_worker": "iirpa/service_worker.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "iirpa/content.js",
        "iirpa/contentscript.js",
        "iirpa/common.js",
        "iirpa/datacollection.js",
        "iirpa/webselect.js"
      ],
      "match_about_blank": true,
      "matches": [
        "http://*/*",
        "https://*/*",
        "ftp://*/*",
        "file://*/*"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "iirpa/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' ; object-src 'self'; font-src 'self' https://fonts.gstatic.com/ https://res-1.cdn.office.net/;"
  },
  "permissions": [
    "storage",
    "cookies",
    "management",
    "tabs",
    "debugger",
    "nativeMessaging",
    "webNavigation",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "\u003Call_urls>"
  ],
  "icons": {
    "16": "icons/indeed-16x16.png",
    "32": "icons/indeed-32x32.png",
    "48": "icons/indeed-48x48.png",
    "128": "icons/indeed-128x128.png"
  }
}
