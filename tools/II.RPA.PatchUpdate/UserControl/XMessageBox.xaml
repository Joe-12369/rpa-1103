<local:BaseWindow x:Class="II.RPA.PatchUpdate.UserControl.XMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.PatchUpdate"
        mc:Ignorable="d"
        MinHeight="210" MinWidth="468" Width="600"  WindowStartupLocation="CenterScreen"
        SizeToContent="Height" WindowStyle="None" BorderThickness="1" Style="{DynamicResource MsgWindowStyle}">
    <Window.Resources>
        <SolidColorBrush x:Key="MsgTitle_Brush" Color="White"></SolidColorBrush>
        <SolidColorBrush x:Key="CloseBrush" Color="Transparent"></SolidColorBrush>
        <SolidColorBrush x:Key="FontColor" Color="Black"></SolidColorBrush>
        <SolidColorBrush x:Key="BlueBtnBG" Color="#ff8910"></SolidColorBrush>
        <SolidColorBrush x:Key="WhiteBG" Color="White"></SolidColorBrush>
        <SolidColorBrush x:Key="ButtonStyle" Color="White"></SolidColorBrush>

        <Style x:Key="MsgQuestion_Brush" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Util.Controls;component/Resources/#SF2015"></Setter>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        
        <Style x:Key="MsgWindowStyle" TargetType="{x:Type local:BaseWindow}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="BorderBrush" Value="#ff666666"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:BaseWindow}">
                        <Grid Background="#fff3f7f9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="40"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="White">
                                <Label  RenderOptions.BitmapScalingMode="Fant"  UseLayoutRounding="True"  Height="26" HorizontalAlignment="Left" Margin="12,-6,0,0" Width="26" Background="{StaticResource MsgTitle_Brush}">
                                    <Canvas Name="logo" Canvas.Left="0" Canvas.Top="0" Width="22" Height="22">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </Canvas.RenderTransform>
                                        <Canvas.Resources>
                                            <LinearGradientBrush xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="SVGID_1_" MappingMode="Absolute" StartPoint="11,2" EndPoint="11,16">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="#272727" Offset="0"/>
                                                        <GradientStop Color="#343434" Offset="1"/>
                                                    </GradientStopCollection>
                                                </LinearGradientBrush.GradientStops>
                                                <LinearGradientBrush.Transform>
                                                    <MatrixTransform Matrix="1 0 0 -1 0 22"/>
                                                </LinearGradientBrush.Transform>
                                            </LinearGradientBrush>
                                            <LinearGradientBrush xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="SVGID_2_" MappingMode="Absolute" StartPoint="8,20" EndPoint="18,11">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="#FFC610" Offset="0"/>
                                                        <GradientStop Color="#FF7110" Offset="1"/>
                                                    </GradientStopCollection>
                                                </LinearGradientBrush.GradientStops>
                                                <LinearGradientBrush.Transform>
                                                    <MatrixTransform Matrix="1 0 0 -1 0 22"/>
                                                </LinearGradientBrush.Transform>
                                            </LinearGradientBrush>
                                            <LinearGradientBrush xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="SVGID_3_" MappingMode="Absolute" StartPoint="10,18" EndPoint="17,18">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#FFF1CB" Offset="1"/>
                                                    </GradientStopCollection>
                                                </LinearGradientBrush.GradientStops>
                                                <LinearGradientBrush.Transform>
                                                    <MatrixTransform Matrix="1 0 0 -1 0 22"/>
                                                </LinearGradientBrush.Transform>
                                            </LinearGradientBrush>
                                        </Canvas.Resources>
                                        <!--Unknown tag: sodipodi:namedview-->
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path49" Fill="#000000">
                                            <Path.Data>
                                                <PathGeometry Figures="M19.1 21H2.9C1.3 21 0 19.7 0 18.1V8.4c0-1.6 1.3-2.9 2.9-2.9H19c1.6 0 2.9 1.3 2.9 2.9V18  C22 19.7 20.7 21 19.1 21z" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path56" Fill="#000000">
                                            <Path.Data>
                                                <PathGeometry Figures="M1 18V8.5c0-1.1 0.9-2 2-2h16c1.1 0 2 0.9 2 2V18c0 1.1-0.9 2-2 2H3C1.9 20 1 19.1 1 18z" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path63" Fill="#ff8910">
                                            <Path.Data>
                                                <PathGeometry Figures="M20 8.8C19.9 8.3 19.5 8 19 8c-0.5 0.1-0.9-0.2-1.1-0.6c-0.1-0.2 0-0.5 0-0.6c0.3-0.7 0.5-1.5 0.5-2.3  s-0.1-1.3-0.4-2c-0.2-0.5-0.6-0.9-1-1.3C16.1 0.4 14.8 0 13.5 0S10.9 0.4 10 1.2C9.6 1.6 9.2 2 9 2.5c-0.3 0.7-0.4 1.2-0.4 2  s0.2 1.6 0.5 2.3c0.1 0.2 0.1 0.4 0 0.6C9 7.8 8.5 8.1 8 8C7.5 8 7.1 8.3 7 8.8c-0.3 1.1 1 2.3 2.2 1.9l0 0c0.4-0.1 0.7-0.3 0.9-0.6  c0.7 1.2 2.7 1.1 3.3 0.3c0.7 0.9 2.6 1 3.3-0.3c0.2 0.3 0.5 0.5 0.9 0.6l0 0c0.9 0.3 1.9-0.3 2.2-1.1C20 9.3 20 9 20 8.8" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path70" Fill="#ffffff">
                                            <Path.Data>
                                                <PathGeometry Figures="M15 6h-3c-1.1 0-2-0.9-2-2l0 0c0-1.1 0.9-2 2-2h3c1.1 0 2 0.9 2 2l0 0C17 5.1 16.1 6 15 6z" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path72" Fill="#000000">
                                            <Path.Data>
                                                <PathGeometry Figures="M12 3.4c-0.3 0-0.5 0.2-0.5 0.5v0.2c0 0.3 0.2 0.5 0.5 0.5s0.5-0.2 0.5-0.5V3.9C12.5 3.6 12.3 3.4 12 3.4z   M15 3.4c-0.3 0-0.5 0.2-0.5 0.5v0.2c0 0.3 0.2 0.5 0.5 0.5s0.5-0.2 0.5-0.5V3.9C15.5 3.6 15.3 3.4 15 3.4z" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path74" Fill="Red">
                                            <Path.Data>
                                                <PathGeometry Figures="M3.9 10.5H2.6C2.3 10.5 2 10.2 2 9.9V8.6C2 8.3 2.3 8 2.6 8h1.3c0.3 0 0.6 0.3 0.6 0.6v1.3  C4.5 10.2 4.2 10.5 3.9 10.5z" FillRule="NonZero"/>
                                            </Path.Data>
                                        </Path>
