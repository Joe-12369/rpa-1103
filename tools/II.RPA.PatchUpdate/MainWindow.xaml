        <!--弃用-->
        <!--<ProgressBar Height="0" Width="0" Name="progressBar1"   Visibility="Collapsed" />-->
        <Border
            x:Name="GlobalBorder"
            Margin="5"
            Panel.ZIndex="-1"
            Background="White"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="7"
                    ShadowDepth="0"
                    Color="Gray" />
            </Border.Effect>

        </Border>
        <Border    Background="Transparent"   BorderThickness="0" CornerRadius="8" Height="57" Width="248" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"></RowDefinition>
                    <RowDefinition  Height="7"></RowDefinition>
                </Grid.RowDefinitions>
                <!--<StackPanel Orientation="Horizontal" >-->
                <TextBlock Grid.Row="0" x:Name="updateTips"  Margin="36,18,0,0"  HorizontalAlignment="Left" Foreground="#161923" FontSize="14">
                   正在启动<Run Text="设计器" x:Name="deviceType"></Run>，请稍等...
                </TextBlock>
                <!--</StackPanel>-->
                <ProgressBar Grid.Row="1" Value="50" Margin="6,0,7,-7" Height="7"   Name="progressBar1" VerticalAlignment="Bottom"   />
            </Grid>

