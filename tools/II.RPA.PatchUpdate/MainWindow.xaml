            <StackPanel Background="#F7F8F9" Grid.Row="1">
                
                -->
        <!--<Label x:Name="label1" FontSize="8" Content="" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="365"/>-->
        <!--
                <ProgressBar Height="20" HorizontalAlignment="Left" Margin="10,20,10,0" 
                                         Name="progressBar1" VerticalAlignment="Top" Width="370"  />
                <TextBlock x:Name="label1" FontSize="12" TextTrimming="CharacterEllipsis"  TextWrapping="Wrap"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" MaxHeight="70" MaxWidth="380"/>
            </StackPanel>
