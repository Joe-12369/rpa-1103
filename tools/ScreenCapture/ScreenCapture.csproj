<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>Library</OutputType>
    <RootNamespace>ScreenCapture</RootNamespace>
    <AssemblyName>ScreenCapture</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DynamicData" Version="9.0.4" />
    <PackageReference Include="IPA.Ubases" Version="1.0.0.22" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\II.RPA.Observable\II.RPA.Observable.csproj" />
    <ProjectReference Include="..\..\src\II.RPA.WinAutomation.CommonUtility\II.RPA.WinAutomation.CommonUtility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CutOption.cs" />
    <Compile Include="DebugHelper.cs" />
    <Compile Include="DirectShowDevices.cs" />
    <Compile Include="EnumExtensions.cs" />
    <Compile Include="Enums.cs" />
    <Compile Include="ExternalCLIManager.cs" />
    <Compile Include="FFmpegCLIManager.cs" />
    <Compile Include="FFmpegOptions.cs" />
    <Compile Include="Helpers.cs" />
    <Compile Include="HelpersOptions.cs" />
    <Compile Include="LastCutOption.cs" />
    <Compile Include="MathHelpers.cs" />
    <Compile Include="MergeOption.cs" />
    <Compile Include="MethodOptions.cs" />
    <Compile Include="NameParser.cs" />
    <Compile Include="NumberExtensions.cs" />
    <Compile Include="ProxyInfo.cs" />
    <Compile Include="RecorderWrapper.cs" />
    <Compile Include="ScreencastOptions.cs" />
    <Compile Include="ScreenHelper.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ScreenHelperWrapper.cs" />
    <Compile Include="ScreenRecorder.cs" />
    <Compile Include="StringExtensions.cs" />
    <Compile Include="User32Ex.cs" />
    <Compile Include="Vector2.cs" />
    <Compile Include="VideoInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="NLog.dll.nlog">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
