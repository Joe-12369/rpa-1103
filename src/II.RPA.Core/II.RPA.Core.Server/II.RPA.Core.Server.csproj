    </None>
    <None Include="Configs\iconfont.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>iconfont.json</TargetPath>
    </None>
    <None Include="Configs\iconfont_component.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
