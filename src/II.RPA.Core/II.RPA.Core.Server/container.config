<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection,Unity.Configuration"/>
	</configSections>
	<unity>
		<sectionExtension type="Microsoft.Practices.Unity.InterceptionExtension.Configuration.InterceptionConfigurationExtension, Unity.Interception.Configuration"/>
		<aliases>
			<!-- LifetimeDefiniton -->
			<typeAlias alias="ContainerControlled" type="Unity.Lifetime.ContainerControlledLifetimeManager,Unity.Abstractions" />
			<typeAlias alias="Singleton" type="Unity.Lifetime.SingletonLifetimeManager, Unity.Abstractions" />
			<!-- ExceptionHandlerDefiniton -->
			<add alias="ExceptionHandler" type="II.RPA.Core.ExceptionHandler, II.RPA.Core" />
			<add alias="ClientActionProviderFactory" type="II.RPA.Core.Provider.PluginLoaderProvider.ClientAction.ClientActionProviderFactory, II.RPA.Core.Provider" />
			<!-- AbstractDefiniton -->
			<add alias="IServiceBoot" type="II.RPA.Core.Abstract.IServiceBoot,II.RPA.Core" />
			<add alias="IEndPointProvider" type="II.RPA.Core.Abstract.IEndPointProvider,II.RPA.Core" />
			<add alias="IAdbStartupSignal" type="II.RPA.Core.Abstract.IAdbStartupSignal,II.RPA.Core.Abstractions" />
			<add alias="AdbStartupSignal" type="II.RPA.Core.Services.AdbStartupSignal,II.RPA.Core" />
			<add alias="ILogger" type="II.RPA.Core.Log.ILogger,II.RPA.Core.Abstractions" />
			<add alias="IRpaRuntimeContext" type="II.RPA.Core.Runtime.IRpaRuntimeContext,II.RPA.Core.Abstractions" />
			<add alias="GlobalRpaRuntimeContext" type="II.RPA.Core.Runtime.GlobalRpaRuntimeContext,II.RPA.Core" />
			<add alias="IEnviromentAccesor" type="II.RPA.Core.Locals.IEnviromentAccesor,II.RPA.Core" />
			<add alias="GRPCInterceptor" type="Grpc.Core.Interceptors.Interceptor,Grpc.Core.Api" />
			<!--<add alias="IPluginLoaderProvider" type="II.RPA.Core.Provider.PluginLoaderProvider.IPluginLoaderProvider,II.RPA.Core.Provider" />-->
			<add alias="IActionService" type="II.RPA.Core.IPCExtension.IPC.IActionService,II.RPA.Core.IPCExtension" />
			<!-- ProviderDefiniton -->
			<!--<add alias="InstanceProvider" type="II.RPA.Core.Provider.PluginLoaderProvider.InstanceProvider,II.RPA.Core.Provider" />-->
			<add alias="AppDomainProvider" type="II.RPA.Core.Provider.PluginLoaderProvider.AppDomainProvider,II.RPA.Core.Provider" />
			<!--<add alias="PluginProcessProvider" type="II.RPA.Core.Provider.PluginLoaderProvider.PluginProcess.PluginProcessProvider,II.RPA.Core.Provider" />-->
			<!--<add alias="PluginProcessFacade" type="II.RPA.Core.Provider.PluginLoaderProvider.PluginProcess.PluginProcessFacade,II.RPA.Core.Provider" />-->
			<add alias="ScreenRecordProvider" type="II.RPA.Core.Provider.ScreenRecordProvider.ScreenRecordProvider,II.RPA.Core.Provider" />
			<add alias="ZBrainProxyProvider" type="II.RPA.Core.Provider.ZBrainProxyProvider.ZBrainProxyProvider,II.RPA.Core.Provider" />
			<add alias="IZBrainChildProxyLauncher" type="II.RPA.Core.Runtime.IZBrainChildProxyLauncher,II.RPA.Core.Abstractions" />
			<add alias="EngineProxyProvider" type="II.RPA.Core.Provider.EngineProxyProvider.EngineProxyProvider,II.RPA.Core.Provider" />
			<add alias="IWorkerTalkerRegistrar" type="II.RPA.Core.Abstract.IWorkerTalkerRegistrar,II.RPA.Core.Abstractions" />
			<add alias="IRuntimeHostController" type="II.RPA.Core.Runtime.IRuntimeHostController,II.RPA.Core.Abstractions" />
			<add alias="IZBrainController" type="II.RPA.Core.Runtime.IZBrainController,II.RPA.Core.Abstractions" />
			<add alias="IMobileProviderController" type="II.RPA.Core.Runtime.IMobileProviderController,II.RPA.Core.Abstractions" />
			<add alias="IRuntimeStateAccessor" type="II.RPA.Core.Runtime.IRuntimeStateAccessor,II.RPA.Core.Abstractions" />
			<add alias="IWorkerControlController" type="II.RPA.Core.Runtime.IWorkerControlController,II.RPA.Core.Abstractions" />
			<add alias="CoreTalkerManager" type="II.RPA.Core.Talker.TalkerManager,II.RPA.Core.Talker" />
			<!-- EnviromentAccesorDefinition -->
			<add alias="EnviromentAccesor" type="II.RPA.Core.Locals.EnviromentAccesor,II.RPA.Core" />
			<!-- NLogDefinition -->
			<add alias="AdaptedLogger" type="II.RPA.Core.Log.AdaptedLogger,II.RPA.Core" />
			<!-- MessageBroker -->
			<!--<add alias="IPublisher" type="II.RPA.Core.IPCExtension.Message.IPublisher,II.RPA.Core.IPCExtension" />
			<add alias="ISubscriber" type="II.RPA.Core.IPCExtension.Message.ISubscriber,II.RPA.Core.IPCExtension" />
			<add alias="MessageBroker" type="II.RPA.Core.IPCExtension.Message.MessageBroker,II.RPA.Core.IPCExtension" />-->
			<!-- IPCDefinition -->
			<!--<add alias="IPCService" type="II.RPA.Core.Provider.PluginLoaderProvider.PluginProcess.IPCService,II.RPA.Core.Provider" />
			<add alias="PluginServiceConnection" type="II.RPA.Core.Provider.PluginLoaderProvider.PluginProcess.PluginServiceConnection,II.RPA.Core.Provider" />-->
			<!-- GRPCInterceptorDefinition -->
			<add alias="ServiceLogInterceptor" type="II.RPA.Core.GRPCService.Interception.ServiceLogInterceptor,II.RPA.Core.GRPCService" />
			<add alias="ServicePollyInterceptor" type="II.RPA.Core.GRPCService.Interception.ServicePollyInterceptor,II.RPA.Core.GRPCService" />
			<add alias="AdminServiceAuthorityInterceptor" type="II.RPA.Core.GRPCService.Interception.AdminServiceAuthorityInterceptor,II.RPA.Core.GRPCService" />
			<!-- GRPCServiceDefiniton -->
			<add alias="IMessageNotify" type="II.RPA.Core.Abstract.IMessageNotify,II.RPA.Core" />
			<add alias="IGRPCService" type="II.RPA.Core.Abstract.IGRPCService,II.RPA.Core" />
			<add alias="PluginGRPCService" type="II.RPA.Core.GRPCService.Service.PluginGRPCService,II.RPA.Core.GRPCService" />
			<add alias="BeepGRPCService" type="II.RPA.Core.GRPCService.Service.BeepGRPCService,II.RPA.Core.GRPCService" />
			<add alias="AdminGRPCService" type="II.RPA.Core.GRPCService.Service.AdminGRPCService,II.RPA.Core.GRPCService" />
			<add alias="MessageGRPCService" type="II.RPA.Core.GRPCService.Service.MessageGRPCService,II.RPA.Core.GRPCService" />
			<add alias="Win32GRPCService" type="II.RPA.Core.GRPCService.Service.Win32GRPCService,II.RPA.Core.GRPCService" />
			<add alias="VisualDataGRPCService" type="II.RPA.Core.GRPCService.Service.VisualDataGRPCService,II.RPA.Core.GRPCService" />
			<add alias="ScreenRecordGRPCService" type="II.RPA.Core.GRPCService.Service.ScreenRecordGRPCService,II.RPA.Core.GRPCService" />
			<add alias="ChildSessionGRPCService" type="II.RPA.Core.GRPCService.Service.ChildSessionGRPCService,II.RPA.Core.GRPCService" />
			<add alias="MobileDeviceManagerGRPCService" type="II.RPA.Core.GRPCService.Service.MobileDeviceManagerGRPCService,II.RPA.Core.GRPCService" />
			<!-- GRPCServiceBootDefiniton -->
			<add alias="ProcessGRPCService" type="II.RPA.Core.GRPCService.Service.ProcessGRPCService,II.RPA.Core.GRPCService" />
			<add alias="WorkerGRPCService" type="II.RPA.Core.GRPCService.Service.WorkerGRPCService,II.RPA.Core.GRPCService" />
			<!-- GRPCServiceBootDefiniton -->
			<add alias="GRPCServiceBoot" type="II.RPA.Core.GRPCService.ServiceBoot.GRPCServiceBoot,II.RPA.Core.GRPCService" />
			<add alias="PowerGRPCServiceBoot" type="II.RPA.Core.GRPCService.ServiceBoot.PowerGRPCServiceBoot,II.RPA.Core.GRPCService" />
			<!-- ApplicationContextDefiniton -->
			<add alias="ApplicationContext" type="System.Windows.Forms.ApplicationContext,System.Windows.Forms" />
			<add alias="RPACoreServerBootContext" type="II.RPA.Core.Server.RPACoreServerBootContext,II.RPA.Core.Server" />
			<!-- EndPointProviderDefiniton -->
			<add alias="EndPointProvider" type="II.RPA.Core.Server.Utilities.EndPointProvider,II.RPA.Core.Server" />
			<!-- EndPointProviderDefiniton -->
			<!-- ClientProvider -->
			<add alias="PluginServiceClientProvider" type="II.RPA.Core.GRPCServiceClient.ClientProvider.PluginServiceClientProvider,II.RPA.Core.GRPCServiceClient" />
			<!-- ClientProvider -->
		</aliases>
		<containers>
			<container name="ServiceBootContainer">
				<extension type="Interception"/>
				<!-- ILoggerInjection -->
				<register type="ILogger" mapTo="AdaptedLogger">
					<lifetime type="ContainerControlled" />
				</register>
				<register type="IEnviromentAccesor" mapTo="EnviromentAccesor">
					<lifetime type="ContainerControlled" />
				</register>
				<register type="ExceptionHandler" mapTo="ExceptionHandler">
					<lifetime type="ContainerControlled" />
				</register>
				<!--<register type="PluginServiceConnection" mapTo="PluginServiceConnection">
					<lifetime type="ContainerControlled" />
				</register>-->
				<!--<register type="IActionService" mapTo="IPCService">
					<lifetime type="ContainerControlled" />
				</register>-->
				<register type="IAdbStartupSignal" mapTo="AdbStartupSignal">
					<lifetime type="ContainerControlled" />
				</register>
				<register type="IRpaRuntimeContext" mapTo="GlobalRpaRuntimeContext">
					<lifetime type="ContainerControlled" />
				</register>
				<register type="ClientActionProviderFactory" mapTo="ClientActionProviderFactory">
					<lifetime type="ContainerControlled" />
				</register>
				<!-- IEndPointProvider -->
				<register type="IEndPointProvider" mapTo="EndPointProvider">
					<lifetime type="ContainerControlled" />
				</register>
				<!--<register type="PluginProcessFacade" mapTo="PluginProcessFacade">
					<lifetime type="ContainerControlled" />
				</register>-->
				<!-- ScreenRecordProvider -->
				<register type="ScreenRecordProvider" mapTo="ScreenRecordProvider">
					<lifetime type="ContainerControlled" />
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
					</constructor>
				</register>
				<!-- ZBrainProxyProvider -->
				<register type="ZBrainProxyProvider" mapTo="ZBrainProxyProvider">
					<lifetime type="ContainerControlled" />
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anEndPointProvider" dependencyType="IEndPointProvider">
						</param>
						<param name="startupSignal" dependencyType="IAdbStartupSignal">
						</param>
						<param name="runtimeContext" dependencyType="IRpaRuntimeContext">
						</param>
					</constructor>
				</register>
				<register type="IZBrainChildProxyLauncher" mapTo="ZBrainProxyProvider">
					<lifetime type="ContainerControlled" />
				</register>
				<!-- EngineProxyProvider -->
				<register type="EngineProxyProvider" mapTo="EngineProxyProvider">
					<lifetime type="ContainerControlled" />
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="startupSignal" dependencyType="IAdbStartupSignal">
						</param>
						<param name="runtimeContext" dependencyType="IRpaRuntimeContext">
						</param>
					</constructor>
				</register>
				<register type="CoreTalkerManager" mapTo="CoreTalkerManager">
					<lifetime type="ContainerControlled" />
					<constructor>
						<param name="logger" dependencyType="ILogger">
						</param>
						<param name="runtimeContext" dependencyType="IRpaRuntimeContext">
						</param>
						<param name="startupSignal" dependencyType="IAdbStartupSignal">
						</param>
						<param name="childZBrainProxyLauncher" dependencyType="IZBrainChildProxyLauncher">
						</param>
					</constructor>
				</register>
				<!-- PluginServiceClientProvider -->
				<register type="PluginServiceClientProvider" mapTo="PluginServiceClientProvider">
					<lifetime type="ContainerControlled" />
				</register>
				<!-- GRPCInterceptorInjection -->
				<register type="GRPCInterceptor" mapTo="ServiceLogInterceptor" name="ServiceLogInterceptor"/>
				<register type="GRPCInterceptor" mapTo="ServicePollyInterceptor" name="ServicePollyInterceptor"/>
				<register type="GRPCInterceptor" mapTo="AdminServiceAuthorityInterceptor" name="AdminServiceAuthorityInterceptor"/>
				<!-- GRPCServiceInjection -->
				<register type="IGRPCService" mapTo="PluginGRPCService" name="PluginGRPCService">
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anInterceptor" dependencyName="ServicePollyInterceptor">
						</param>
						<param name="aClientActionProviderFactory" dependencyType="ClientActionProviderFactory">
						</param>
						<param name="aRuntimeHostController" dependencyType="IRuntimeHostController">
						</param>
						<param name="aMobileProviderController" dependencyType="IMobileProviderController">
						</param>
						<param name="aRuntimeStateAccessor" dependencyType="IRuntimeStateAccessor">
						</param>
						<param name="aWorkerControlController" dependencyType="IWorkerControlController">
						</param>
						<param name="aMobileDeviceManagerGRPCService" dependencyName="MobileDeviceManagerGRPCService">
						</param>
					</constructor>
				</register>
				<register type="IGRPCService" mapTo="BeepGRPCService" name="BeepGRPCService">
					<!--<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>-->
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anInterceptor" dependencyName="AdminServiceAuthorityInterceptor">
						</param>
					</constructor>
				</register>
				<register type="IGRPCService" mapTo="AdminGRPCService" name="AdminGRPCService">
					<!--<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>-->
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anInterceptor" dependencyName="AdminServiceAuthorityInterceptor">
						</param>
					</constructor>
				</register>

				<register type="IGRPCService" mapTo="Win32GRPCService" name="Win32GRPCService">
				<interceptor type="VirtualMethodInterceptor"/>
				<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
					</constructor>
				</register>

				<register type="IGRPCService" mapTo="ChildSessionGRPCService" name="ChildSessionGRPCService">
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anInterceptor" dependencyName="ServicePollyInterceptor">
						</param>
					</constructor>
				</register>

				<register type="IGRPCService" mapTo="WorkerGRPCService" name="WorkerGRPCService">
					<constructor>
						<param name="workerTalkerRegistrar" dependencyType="IWorkerTalkerRegistrar">
						</param>
					</constructor>
				</register>

				<register type="IMessageNotify" mapTo="MessageGRPCService" name="MessageGRPCService">
					<lifetime type="singleton" />
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
					</constructor>
				</register>
				<register type="IMessageNotify" mapTo="VisualDataGRPCService" name="VisualDataGRPCService">
				  <lifetime type="singleton" />
				  <interceptor type="VirtualMethodInterceptor"/>
				  <interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
				  <constructor>
					<param name="aLogger" dependencyType="ILogger">
					</param>
					<!--<param name="aPluginLoaderProvider" dependencyType="PluginProcessProvider">
					</param>-->
					  <param name="aRuntimeHostController" dependencyType="IRuntimeHostController">
					  </param>
					<param name="aClientActionProviderFactory" dependencyType="ClientActionProviderFactory">
					</param>
					  <param name="aMessageGRPCService" dependencyName="MessageGRPCService">
					  </param>
				  </constructor>
				</register>
				
				<register type="MobileDeviceManagerGRPCService" mapTo="MobileDeviceManagerGRPCService" name="MobileDeviceManagerGRPCService">
					<lifetime type="singleton" />
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
					</constructor>
				</register>
				
				<register type="IGRPCService" mapTo="ProcessGRPCService" name="ProcessGRPCService">
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anInterceptor" dependencyName="ServicePollyInterceptor">
						</param>
						<param name="aClientActionProviderFactory" dependencyType="ClientActionProviderFactory">
						</param>
						<!--<param name="aPluginProcessProvider" dependencyType="PluginProcessProvider">
						</param>-->
						<param name="aRuntimeHostController" dependencyType="IRuntimeHostController">
						</param>
						<param name="aMessageNotify" dependencyName="MessageGRPCService">
						</param>
						<param name="aVisualDataService" dependencyName="VisualDataGRPCService">
						</param>
					</constructor>
				</register>
				<register type="IGRPCService" mapTo="ScreenRecordGRPCService" name="ScreenRecordGRPCService">
					<interceptor type="VirtualMethodInterceptor"/>
					<interceptionBehavior type="II.RPA.Core.GRPCService.Interception.ServiceTraceBehavior, II.RPA.Core.GRPCService"/>
					<constructor>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="aScreenRecordProvider" dependencyType="ScreenRecordProvider">
						</param>
					</constructor>
				</register>
				<!-- GRPCServiceBootInjection -->
				<register type="IServiceBoot" mapTo="GRPCServiceBoot" name="GRPCServiceBoot">
					<lifetime type="singleton" />
					<constructor>
						<param name="aServices">
							<array>
								<dependency name="PluginGRPCService"/>
								<dependency name="BeepGRPCService"/>
								<dependency name="AdminGRPCService"/>
								<dependency name="Win32GRPCService"/>
								<dependency name="ProcessGRPCService"/>
								<dependency name="ScreenRecordGRPCService"/>
								<dependency name="WorkerGRPCService"/>
								<dependency name="ChildSessionGRPCService"/>
							</array>
						</param>
						<param name="anIP">
							<value value ="localhost"/>
						</param>
						<param name="aPort">
							<value value ="7181,7182,7183,9900"/>
						</param>
						<param name="aLogger" dependencyType="ILogger">
						</param>
						<param name="anEndPointProvider" dependencyType="IEndPointProvider">
						</param>
						<param name="aMessageService" dependencyName="MessageGRPCService">
						</param>
						<param name="aVisualDataService" dependencyName="VisualDataGRPCService">
						</param>
						<param name="aMobileDeviceManagerGRPCService" dependencyName="MobileDeviceManagerGRPCService">
						</param>
					</constructor>
				</register>
				<register type="ApplicationContext" mapTo="RPACoreServerBootContext"/>
			</container>
		</containers>
	</unity>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
	</startup>
</configuration>
