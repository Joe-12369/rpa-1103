<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

  <!-- optional, add some variables
  https://github.com/nlog/NLog/wiki/Configuration-file#variables
  -->
  <variable name="user" value="default"/>
  
  <targets async="true">
    <target name="DefaultLogger" xsi:type="File" fileName="Logs/default/Logs/${shortdate}/${shortdate}.log" 
  layout="[${longdate}] [${threadid}] [${level}]: ${message}${newline}${exception}" archiveFileName="Logs/default/Logs/${shortdate}/${shortdate}.{#####}.log" archiveAboveSize="10240000" archiveNumbering="Sequence" />
   <target name="DefaultLogger" xsi:type="File" fileName="Logs/default/Logs/${shortdate}/${shortdate}.log" 
  layout="[${longdate}] [${threadid}] [${level}]: ${message}${newline}${exception}" archiveFileName="Logs/default/Logs/${shortdate}/${shortdate}.{#####}.log" archiveAboveSize="10240000" archiveNumbering="Sequence" />
   <target name="DefaultLogger" xsi:type="File" fileName="Logs/default/Logs/${shortdate}/${shortdate}.log" 
  layout="[${longdate}] [${threadid}] [${level}]: ${message}${newline}${exception}" archiveFileName="Logs/default/Logs/${shortdate}/${shortdate}.{#####}.log" archiveAboveSize="10240000" archiveNumbering="Sequence" />
  </targets>

<!--Trace，Debug，Info，Warn，Error，Fatal-->
  <rules>
    <logger name="DefaultLogger" minlevel="Trace" maxLevel="Trace" writeTo="DefaultLogger" />
    <logger name="DefaultLogger" minlevel="Debug" maxLevel="Info" writeTo="DefaultLogger" />
    <logger name="DefaultLogger" minlevel="Warn" maxLevel="Fatal" writeTo="DefaultLogger" />
  </rules>
</nlog>
