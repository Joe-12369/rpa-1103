    <Compile Include="Controls\GuiModalWindowAction.cs" />
    <Compile Include="Controls\GuiOKCodeAction.cs" />
    <Compile Include="Controls\GuiPasswordFieldAction.cs" />
    <Compile Include="Controls\GuiRadioButtonAction.cs" />
    <Compile Include="Controls\GuiScrollContainerAction.cs" />
    <Compile Include="Controls\GuiShellAction.cs" />
    <Compile Include="Controls\GuiSimpleContainerAction.cs" />
    <Compile Include="Controls\GuiStatusbarAction.cs" />
    <Compile Include="Controls\GuiTabAction.cs" />
    <Compile Include="Controls\GuiTableCellAction.cs" />
    <Compile Include="Controls\GuiTableColumnAction.cs" />
    <Compile Include="Controls\GuiTableControlAction.cs" />
    <Compile Include="Controls\GuiTableRowAction.cs" />
    <Compile Include="Controls\GuiTabStripAction.cs" />
