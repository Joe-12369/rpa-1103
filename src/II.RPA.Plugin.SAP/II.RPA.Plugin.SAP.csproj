<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  
    <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>Library</OutputType>
    <RootNamespace>II.RPA.Plugin.SAP</RootNamespace>
    <AssemblyName>II.RPA.Plugin.SAP</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
<PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    
    <OutputType>Library</OutputType>
    
    <RootNamespace>II.RPA.Plugin.SAP</RootNamespace>
    <AssemblyName>II.RPA.Plugin.SAP</AssemblyName>
    
    
    <Deterministic>true</Deterministic>
    
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <ItemGroup>
    <!--
      sapfewse.dll contains COM type definitions only; it is embedded into this
      plugin at compile time. Keep the checked-in assembly's CLR header AnyCPU
      (32BITREQUIRED=0), because the plugin is loaded by the x64 .NET 10
      RuntimeHost. A 32-bit-only interop assembly causes MSB3270 and can make
      the x64 host fail before SAP automation starts.
    -->
    <Reference Include="sapfewse">
      <HintPath>..\libs\sapfewse.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
</ItemGroup>
  <ItemGroup>
    <Compile Include="Extensions\SapTypeExtensions.cs" />
    <Compile Include="Internal\SapViewportPreparer.cs" />
    <Compile Include="SapConnectionManager.cs" />
    <Compile Include="Utils\SapComReleaser.cs" />
    <Compile Include="Utils\SapSelectorParser.cs" />
    <Compile Include="Controls\GuiGridCellAction.cs" />
    <Compile Include="Controls\GuiGridColumnAction.cs" />
    <Compile Include="Controls\GuiGridRowAction.cs" />
    <Compile Include="Controls\GuiGridViewAction.cs" />
    <Compile Include="Controls\GuiTreeAction.cs" />
    <Compile Include="Controls\ITable.cs" />
    <Compile Include="Controls\TableBase.cs" />
    <Compile Include="GuiOperator.cs" />
    <Compile Include="GuiModule.cs" />
    <Compile Include="PluginPackage.cs" />
    <Compile Include="ControlFactory.cs" />
    <Compile Include="Controls\GuiBoxAction.cs" />
    <Compile Include="Controls\GuiButtonAction.cs" />
    <Compile Include="Controls\GuiCheckBoxAction.cs" />
    <Compile Include="Controls\GuiComboBoxAction.cs" />
    <Compile Include="Controls\GuiContainerShellAction.cs" />
    <Compile Include="Controls\GuiContextMenuAction.cs" />
    <Compile Include="Controls\GuiCTextFieldAction.cs" />
    <Compile Include="Controls\GuiCustomControlAction.cs" />
    <Compile Include="Controls\GuiDialogShellAction.cs" />
    <Compile Include="Controls\GuiDockShellAction.cs" />
    <Compile Include="Controls\GuiFrameWindowAction.cs" />
    <Compile Include="Controls\GuiGOSShellAction.cs" />
    <Compile Include="Controls\GuiLabelAction.cs" />
    <Compile Include="Controls\GuiMainWindowAction.cs" />
    <Compile Include="Controls\GuiMenuAction.cs" />
