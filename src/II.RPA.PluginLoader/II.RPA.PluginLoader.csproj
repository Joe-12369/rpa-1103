  <Target Name="DeployPluginLoaderLibs" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_LoaderBin>$(SolutionDir)..\bin\II.RPA.PluginLoader\</_LoaderBin>
    </PropertyGroup>
    <MakeDir Directories="$(_LoaderBin);$(_LoaderBin)net35\" />
    <ItemGroup>
      <_LibDevExpress Include="$(SolutionDir)libs\devexpress\**\*.*"
                      Exclude="$(SolutionDir)libs\devexpress\Microsoft.AspNet.SignalR.Client.dll" />
      <_LibDialog Include="$(SolutionDir)libs\dialog\**\*.*" />
      <_LibCdp Include="$(SolutionDir)libs\cdp\**\*.*" />
      <_LibGoogleTable Include="$(SolutionDir)libs\googletable\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibDevExpress)" DestinationFolder="$(_LoaderBin)%(_LibDevExpress.RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_LibDialog)" DestinationFolder="$(_LoaderBin)%(_LibDialog.RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_LibCdp)" DestinationFolder="$(_LoaderBin)%(_LibCdp.RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_LibGoogleTable)" DestinationFolder="$(_LoaderBin)%(_LibGoogleTable.RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(SolutionDir)libs\IndeedInjector.exe" DestinationFolder="$(_LoaderBin)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(SolutionDir)libs\IndeedInjector32.exe" DestinationFolder="$(_LoaderBin)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(Files)" DestinationFolder="$(_LoaderBin)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(Net35Files)" DestinationFolder="$(_LoaderBin)net35\" SkipUnchangedFiles="false" />
    <MSBuild Projects="$(SolutionDir)II.RPA.WebBrowser.Common\II.RPA.WebBrowser.Common.csproj"
             Targets="GetResolvedSignalRClientAssembly"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ResolvedSignalRClientAssembly" />
    </MSBuild>
    <Error Condition="'@(_ResolvedSignalRClientAssembly)' == ''"
           Text="II.RPA.WebBrowser.Common did not resolve Microsoft.AspNet.SignalR.Client.dll." />
    <Copy SourceFiles="@(_ResolvedSignalRClientAssembly)" DestinationFolder="$(_LoaderBin)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_IpcRuntimeFiles Include="$(TargetDir)II.RPA.IPC.dll" />
      <_IpcRuntimeFiles Include="$(TargetDir)II.RPA.IPC.pdb" />
      <_IpcRuntimeFiles Include="$(TargetDir)System.ServiceModel*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IpcRuntimeFiles)" DestinationFolder="$(_LoaderBin)" SkipUnchangedFiles="false" />
  </Target>
  
  
