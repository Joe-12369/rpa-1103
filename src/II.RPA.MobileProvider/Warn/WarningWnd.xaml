<Window
    x:Class="II.RPA.MobileProvider.Warn.WarningWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WarningWnd"
    Width="340"
    MinHeight="158"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="34"
            GlassFrameThickness="-1"
            ResizeBorderThickness="11" />
    </WindowChrome.WindowChrome>

    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid x:Name="backGrid">
                <Border
                    x:Name="contentBorder"
                    Margin="4"
                    Background="#fefefc"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="4"
                            ShadowDepth="0"
                            Color="#B7B7B7" />
                    </Border.Effect>
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                                    Background="Black"
                                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                                    SnapsToDevicePixels="True" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <AdornerDecorator>
                        <ContentPresenter />
                    </AdornerDecorator>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsActive" Value="True">
                    <Setter TargetName="contentBorder" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="4"
                                ShadowDepth="0"
                                Color="#B2B2B2" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Template>

    <Window.Resources>
        <Style x:Key="ImageBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3E8EE" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContentCommonTextBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft Yahei" />
            <!--<Setter Property="FontFamily" Value="思源黑体 VF"/>-->
            <Setter Property="Foreground" Value="#505962" />
            <Setter Property="FontSize" Value="13" />
            <!--<Setter Property="FontWeight" Value="SemiBold" />-->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
            <RowDefinition Height="31" />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Background="#F1F4F7"
            IsHitTestVisible="True"
            MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#161923"
                    Text="{x:Static res:II_RPA_Resource.WarningWnd_D67D16CB}" />
            </StackPanel>

            <!--  窗体右上侧操作按钮  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsHitTestVisible="True"
                Orientation="Horizontal">
                <Border
                    x:Name="btn_Close"
                    Width="20"
                    Height="20"
                    Margin="0,0,13,0"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonDown="btn_Close_Click"
                    Style="{StaticResource ImageBorderStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <!--<Image Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"  UseLayoutRounding="True" Source="../Assets/Images/close.png" Cursor="Hand"/>-->
                    <Path
                        Width="14"
                        Height="14"
                        VerticalAlignment="Top"
                        Data="M1.9,1.1L7,6.3l5.1-5.1C12.3,1,12.6,1,12.8,1.1l0.1,0.1c0.2,0.2,0.2,0.5,0,0.7l0,0L7.7,7   l5.1,5.1c0.2,0.2,0.2,0.5,0,0.7c-0.2,0.2-0.5,0.2-0.7,0L7,7.7l-5.1,5.1C1.7,13,1.4,13,1.2,12.9l-0.1-0.1c-0.2-0.2-0.2-0.5,0-0.7   l0,0L6.3,7L1.1,1.9C1,1.7,1,1.3,1.1,1.1S1.7,1,1.9,1.1z"
                        Fill="#5E5E5E" />
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="True"
            Orientation="Vertical">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--<svgc:SvgViewbox VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="20" Source="../Warning.svg" />-->
                <!--<Path
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M512 85.333333C277.333333 85.333333 85.333333 277.333333 85.333333 512s192 426.666667 426.666667 426.666667 426.666667-192 426.666667-426.666667S746.666667 85.333333 512 85.333333z m21.333333 640h-42.666666c-12.8 0-21.333333-8.533333-21.333334-21.333333v-42.666667c0-12.8 8.533333-21.333333 21.333334-21.333333h42.666666c12.8 0 21.333333 8.533333 21.333334 21.333333v42.666667c0 12.8-8.533333 21.333333-21.333334 21.333333z m-21.333333-170.666666c-25.6 0-42.666667-17.066667-42.666667-42.666667V341.333333c0-25.6 17.066667-42.666667 42.666667-42.666666s42.666667 17.066667 42.666667 42.666666v170.666667c0 25.6-17.066667 42.666667-42.666667 42.666667z"
                    Fill="#FF8900"
                    Stretch="Fill" />-->
                <!--<Image Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Source="../Assets/Images/icon_warn.png"/>-->
                <!--<TextBlock
                    x:Name="tb_WarningContent"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="252"
                    Height="auto"
                    Margin="8,2,0,0"
                    FontSize="14"
                    Foreground="#161923"
                    LineHeight="20"
                    Text="确定关闭手机管理器吗？"
                    TextWrapping="Wrap" />-->
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Width="290"
                    Height="auto"
                    Margin="20,8,0,0"
                    FontSize="12"
                    Foreground="#7A8187"
                    LineHeight="18"
                    Text="{x:Static res:II_RPA_Resource.WarningWnd_7AEDB5DA}"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>


        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="True"
            Orientation="Horizontal">
            <Button
                x:Name="btn_Cancel"
                Width="80"
                Height="30"
                HorizontalAlignment="Right"
                Click="btn_Cancel_Click"
                Cursor="Hand">
                <!--<Grid >
                    <TextBlock  Grid.Column="1" Text="取消" VerticalAlignment="Center" Style="{StaticResource ContentCommonTextBlock}"/>
                </Grid>-->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Name="ButtonBorder"
                            Background="White"
                            BorderBrush="#E7E9EF"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource ContentCommonTextBlock}"
                                Text="{x:Static res:II_RPA_Resource.WarningWnd_D67733DF}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F4F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button
                x:Name="tb_ConfirmContent"
                Width="80"
                Height="30"
                Margin="16,0,20,0"
                HorizontalAlignment="Right"
                Background="#FF8900"
                BorderBrush="#ECEEF2"
                BorderThickness="0"
                Click="btn_Confirm_Click"
                Content="{x:Static res:II_RPA_Resource.WarningWnd_75A35401}"
                Cursor="Hand">
                <!--<Grid >
                    <TextBlock Name="tb_ConfirmContent"  Grid.Column="1" Text="确定" VerticalAlignment="Center" Foreground="#FFFFFF" Style="{StaticResource ContentCommonTextBlock}"/>
                </Grid>-->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Name="ButtonBorder"
                            Background="#FF8900"
                            BorderThickness="0"
                            CornerRadius="3">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#FFFFFF"
                                Style="{StaticResource ContentCommonTextBlock}"
                                Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF9810" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF8900" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>


</Window>
