                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="ButtonBackgroundBrush" Storyboard.TargetProperty="Color">
                                        <ColorAnimation To="#FF6151" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)">
                                        <ColorAnimation To="#FFFFFF" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
