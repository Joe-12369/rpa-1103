        TargetType="Button">
        <Setter Property="ToolTip" Value="{StaticResource MaxWindowTipText}" />
        <Setter Property="Command" Value="{Binding Source={x:Static SystemCommands.MaximizeWindowCommand}}" />
        <Setter Property="Content">
