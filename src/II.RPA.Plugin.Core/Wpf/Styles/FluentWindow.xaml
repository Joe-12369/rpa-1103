                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="ButtonBackgroundBrush" Storyboard.TargetProperty="Color">
                                        <ColorAnimation Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)">
                                        <ColorAnimation Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
