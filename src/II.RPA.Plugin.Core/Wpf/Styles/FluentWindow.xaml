    <Style
        x:Key="CloseButtonWithDefineCommandStyle"
        BasedOn="{StaticResource WindowTitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="ToolTip" Value="{StaticResource CloseWindowTipText}" />
        <Setter Property="Foreground" Value="{StaticResource DefaultForegroundBrush}" />
        <Setter Property="Content">
            <Setter.Value>
                <Viewbox
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    Stretch="Uniform">
                    <Canvas
                        Width="1024.0"
                        Height="1024.0"
                        UseLayoutRounding="False">
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                        </Canvas.Clip>
                        <Path Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}">
