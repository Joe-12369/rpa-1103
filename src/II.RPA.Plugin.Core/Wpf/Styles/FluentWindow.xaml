<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converts="clr-namespace:II.RPA.Plugin.Core.Wpf.Controls.Converters"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:windows="clr-namespace:II.RPA.Plugin.Core.Wpf.Controls.Windows">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.Core;Component/Wpf/Styles/FluentWindowTitleBar.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <converts:NullToVisibilityConverter x:Key="EmptyObjectToVisibilityConverter" />
    <Color x:Key="ButtonMouseOverBackground">#30333C</Color>
    <Color x:Key="RedColor">#ED2424</Color>
    <Color x:Key="GrayColor">#CCCCCC</Color>
    <Color x:Key="DefaultForegroundColor">
        #999DA8
    </Color>
    <Color x:Key="WhiteColor">
        #FFFFFF
    </Color>
    <Color x:Key="TransparentColor">Transparent</Color>
    <sys:String x:Key="MinWindowTipText">最小化</sys:String>
    <sys:String x:Key="MaxWindowTipText">最大化</sys:String>
    <sys:String x:Key="CloseWindowTipText">关闭</sys:String>
    <sys:String x:Key="RestoreWindowTipText">还原</sys:String>


    <SolidColorBrush x:Key="ButtonMouseOverBackgroundDarkBrush" Color="{StaticResource ButtonMouseOverBackground}" />
    <SolidColorBrush x:Key="ButtonMouseOverBackgroundRedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="TitleBarForegroundGrayBrush" Color="{StaticResource GrayColor}" />
    <SolidColorBrush x:Key="TranparentBrush" Color="{StaticResource TransparentColor}" />
    <SolidColorBrush x:Key="DefaultForegroundBrush" Color="{StaticResource DefaultForegroundColor}" />
    <SolidColorBrush x:Key="DefaultTitleBarBrush" Color="{StaticResource WhiteColor}" />


    <Style x:Key="WindowTitleBarButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#5E5E5E" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="23" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Height" Value="23" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="LayoutRoot" Background="{StaticResource TranparentBrush}">
                        <Border
                            x:Name="ButtonBorder"
                            CornerRadius="5"
                            SnapsToDevicePixels="true">
                            <Border.Background>
                                <SolidColorBrush x:Name="ButtonBackgroundBrush" Color="Transparent" />
                            </Border.Background>
                            <ContentPresenter
                                x:Name="TitleBarButtonContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                Focusable="False"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="ButtonBackgroundBrush" Storyboard.TargetProperty="Color">
                                        <ColorAnimation To="#F4F6F8" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="ButtonBackgroundBrush" Storyboard.TargetProperty="Color">
                                        <ColorAnimation To="Transparent" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="MinimizeButtonStyle"
        BasedOn="{StaticResource WindowTitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="ToolTip" Value="{StaticResource MinWindowTipText}" />
        <Setter Property="Command" Value="{Binding Source={x:Static SystemCommands.MinimizeWindowCommand}}" />
        <Setter Property="Content">
            <Setter.Value>
                <Viewbox
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    Stretch="Uniform">
                    <Canvas
                        Width="1024.0"
                        Height="1024.0"
                        UseLayoutRounding="False">
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                        </Canvas.Clip>
                        <Path Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}">
                            <Path.Data>
                                <PathGeometry Figures="M 160 480 h 704 c 19.2 0 32 12.8 32 32 s -12.8 32 -32 32 h -704 c -19.2 0 -32 -12.8 -32 -32 s 12.8 -32 32 -32 z" FillRule="Nonzero" />
                            </Path.Data>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Setter.Value>
        </Setter>
    </Style>

