        TargetType="Button">
        <Setter Property="ToolBar.ToolTip" Value="{StaticResource RestoreWindowTipText}" />
        <Setter Property="Command" Value="{Binding Source={x:Static SystemCommands.RestoreWindowCommand}}" />
        <Setter Property="Content">
