<Window
    x:Class="II.RPA.Plugin.GUI.DataCollection.V2.Windows.DataCollectHighLightWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.DataCollection.V2.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="DataCollectHighLight"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="DataCollectHighLight"
    AutomationProperties.Name="DataCollectHighLight"
    Background="Transparent"
    Deactivated="DataCollectHighLightWnd_Deactivated"
    Loaded="DataCollectHighLightWnd_Loaded"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <!--  SnapsToDevicePixels="True"  -->
    <!--
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="NativeTagBorderColor" Color="#F5000000" />
        <SolidColorBrush x:Key="NativeBorderColor" Color="#FE5402" />
        <SolidColorBrush x:Key="NativeSubColor" Color="#FFFFFFFF" />
        <FontFamily x:Key="IconFont">/II.RPA.Plugin.GUI;component/Styles/FactoryFont/#iconfont</FontFamily>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HLTagRect"
            Grid.Row="{Binding TagRowID}"
            Margin="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            Visibility="{Binding TagContentVisibility}">
            <Grid Height="52">
                <Border
                    BorderBrush="{StaticResource NativeSubColor}"
                    BorderThickness="2"
                    CornerRadius="4" />
                <Border
                    Margin="1"
                    Background="{StaticResource NativeTagBorderColor}"
                    BorderBrush="{StaticResource NativeTagBorderColor}"
                    BorderThickness="0"
                    CornerRadius="4" />
                <StackPanel
                    Margin="1,0,1,0"
                    Background="Transparent"
                    Orientation="Horizontal">
                    <StackPanel
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Name="PART_IconText"
                            Margin="4,0,4,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="14"
                            Foreground="{StaticResource NativeSubColor}"
                            Text="{Binding TagIconCode}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource NativeSubColor}"
                            Text="{Binding TagContent}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                        <StackPanel Margin="0,4,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <Border
                                Width="1"
                                Height="20"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="0" />
                            <Border
                                Width="37"
                                Height="20"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    Foreground="#FFFFFFFF"
                                    Text="Ctrl"
                                    TextAlignment="Center" />
                            </Border>
                            <TextBlock
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFFFFFFF"
                                Text="+" />
                            <Border
                                Width="35"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    Foreground="#FFFFFFFF"
                                    Text="{DynamicResource DataCollectHighLightWnd.xaml_DanJi}"
                                    TextAlignment="Center" />
                            </Border>
                            <TextBlock
                                x:Name="tb_captureTypeTips"
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="14"
                                Foreground="#CCFFFFFF"
                                Text="{DynamicResource DataCollectHighLightWnd.xaml_CaiJiShuJu}"
                                Visibility="{Binding CaptureTypeTipsVisibility}" />
                            <TextBlock
                                x:Name="tb_SimilarCaptureTypeTips"
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="14"
                                Foreground="#CCFFFFFF"
                                Text="{DynamicResource DataCollectHighLightWnd.xaml_BuChongXiangSiShuJu}"
                                Visibility="{Binding SimilarCaptureTypeTipsVisibility}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <Border
                                Width="1"
                                Height="19"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="0" />
                            <Border
                                Width="37"
                                Height="20"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    Foreground="#FFFFFFFF"
                                    Text="Shift"
                                    TextAlignment="Center" />
                            </Border>
                            <TextBlock
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFFFFFFF"
                                Text="+" />
                            <Border
                                Width="35"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF676767"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    Foreground="#FFFFFFFF"
                                    Text="{DynamicResource DataCollectHighLightWnd.xaml_DanJi}"
                                    TextAlignment="Center" />
                            </Border>
                            <TextBlock
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="14"
                                Foreground="#CCFFFFFF"
                                Text="{x:Static res:II_RPA_Resource.DataCollectHighLightWnd_5B5EA282}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Name="HLBorderRect"
            Grid.Row="{Binding BorderRowID}"
            Width="{Binding BorderWidth}"
            Height="{Binding BorderHeight}"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            BorderThickness="0">
            <Grid>
                <Border
                    Margin="0"
                    BorderBrush="{StaticResource NativeSubColor}"
                    BorderThickness="1"
                    CornerRadius="5"
                    SnapsToDevicePixels="True" />
                <Border
                    Margin="1"
                    BorderBrush="{StaticResource NativeBorderColor}"
                    BorderThickness="3"
                    CornerRadius="3"
                    SnapsToDevicePixels="True" />
                <Border
                    x:Name="InnerPanel2"
                    Background="{Binding BorderBackground}"
                    Opacity="0.1" />
            </Grid>
        </Border>
    </Grid>
</Window>
