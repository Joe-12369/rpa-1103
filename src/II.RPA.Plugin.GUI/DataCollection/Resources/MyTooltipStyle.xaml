<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dataConverter="clr-namespace:II.RPA.Plugin.GUI.DataCollection.DataTypeConverter">
    <dataConverter:TrimmedTextBlockVisibilityConverter x:Key="TrimmedTextBlockVisibilityConverter" />
    <ControlTemplate x:Key="DefaultToolTipTemplate" TargetType="ToolTip">
        <Border Background="#F5A623"  BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" CornerRadius="2">
            <ContentPresenter Content="{TemplateBinding ContentControl.Content}" Margin="4,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>

    <Style x:Key="DefaultToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="White"/>
        <!--<Setter Property = "HorizontalOffset" Value="10"/>-->
        <Setter Property = "VerticalOffset" Value="10"/>
        <Setter Property = "VerticalAlignment" Value="Center"/>
        <Setter Property = "HorizontalAlignment" Value="Left"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property = "Background" Value="#F5A623"/>
        <Setter Property = "FontSize" Value="12"/>
        <Setter Property = "FontFamily" Value="Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif,Segoe UI"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource DefaultToolTipTemplate}"/>
    </Style>

    <ControlTemplate x:Key="ToolTipTemplateForCellContent" TargetType="ToolTip">
        <Grid>
            <Border Background="#505962" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" CornerRadius="4">
                <!--<Border.Effect>
                    <DropShadowEffect Direction="0" BlurRadius="7" ShadowDepth="0" Color="Black" Opacity="0.7" />
                </Border.Effect>-->
            </Border>
            <TextBlock      MaxHeight="100"
                            MaxWidth="500"
                            Margin="8,6,8,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="{TemplateBinding ContentControl.Content}"
                            TextTrimming="CharacterEllipsis"
                            />
            <!--TextTrimming="CharacterEllipsis"-->
        </Grid>
    </ControlTemplate>

    <Style x:Key="ToolTipStyleForCellContent" TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="White"/>
        <!--<Setter Property = "HorizontalOffset" Value="10"/>-->
        <Setter Property = "VerticalOffset" Value="15"/>
        <Setter Property = "VerticalAlignment" Value="Center"/>
        <Setter Property = "HorizontalAlignment" Value="Left"/>
        <!--<Setter Property="Height" Value="22"/>-->
        <Setter Property = "Background" Value="#505962"/>
        <Setter Property = "FontSize" Value="12"/>
        <Setter Property = "FontFamily" Value="Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif,Segoe UI"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource ToolTipTemplateForCellContent}"/>
        <!--<Setter Property="Visibility" Value="{Binding RelativeSource={RelativeSource Self},Path= PlacementTarget, Converter={StaticResource TrimmedTextBlockVisibilityConverter}}"/>--> 
        <Style.Triggers>
            <Trigger Property="Content"
                             Value="{x:Static sys:String.Empty}">
                <Setter Property="Visibility"
                              Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>