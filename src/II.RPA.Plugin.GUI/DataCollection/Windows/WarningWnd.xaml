<Window x:Class="II.RPA.Plugin.GUI.DataCollection.Windows.WarningWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.GUI.DataCollection.Windows"
        mc:Ignorable="d"
        Title="WarningWnd" SizeToContent="Height" MinHeight="158" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Topmost="True"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" ResizeBorderThickness="11"  CaptionHeight="34"/>
    </WindowChrome.WindowChrome>

    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid x:Name="backGrid">
                <Border x:Name="contentBorder" Margin="4" CornerRadius="4" Background="#fefefc">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#B7B7B7"/>
                    </Border.Effect>
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="Black"
                                        SnapsToDevicePixels="True"
                                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <AdornerDecorator>
                        <ContentPresenter />
                    </AdornerDecorator>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsActive" Value="True">
                    <Setter TargetName="contentBorder" Property="Effect" >
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#B2B2B2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Template>

    <Window.Resources>
        <Style x:Key="ImageBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3E8EE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContentCommonTextBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif,Segoe UI"/>
            <!--<Setter Property="FontFamily" Value="思源黑体 VF"/>-->
            <Setter Property="Foreground" Value="#505962"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="31"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#F1F4F7"  MouseLeftButtonDown="Grid_MouseLeftButtonDown" IsHitTestVisible="True" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontSize="13" Margin="16,0,0,0" Text="{DynamicResource Tishi}" VerticalAlignment="Center" Foreground="#161923"/>
            </StackPanel>
            
            <!--窗体右上侧操作按钮-->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right" IsHitTestVisible="True">
                <Border Width="20" Height="20" Margin="0,0,13,0" x:Name="btn_Close"  HorizontalAlignment="Right" Style="{StaticResource ImageBorderStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonDown="btn_Close_Click">
                    <Image Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"  UseLayoutRounding="True" Source="../Assets/Images/close.png" Cursor="Hand"/>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Vertical" IsHitTestVisible="True">
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <svgc:SvgViewbox VerticalAlignment="Top" HorizontalAlignment="Right" Height="20" Width="20" Source="../Assets/SvgIcon/Warning.svg"/>
                <!--<Image Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Source="../Assets/Images/icon_warn.png"/>-->
                <TextBlock x:Name="tb_WarningContent" Margin="8,2,0,0" Grid.Column="1" TextWrapping="Wrap" Width="292" Height="auto" LineHeight="20"  FontSize="14" Foreground="#161923" Text="{DynamicResource WarningWnd.xaml_ShiQuShuJuYuYiYouShuJuFei}"/>
            </Grid>
        </StackPanel>


        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" IsHitTestVisible="True">
            <Button Width="80" Height="30" x:Name="btn_Cancel" HorizontalAlignment="Right"  Cursor="Hand" 
                        Click="btn_Cancel_Click">
                <!--<Grid >
                    <TextBlock  Grid.Column="1" Text="取消" VerticalAlignment="Center" Style="{StaticResource ContentCommonTextBlock}"/>
                </Grid>-->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBorder" CornerRadius="3"  BorderBrush="#E7E9EF" BorderThickness="1" Background="White"  >
                            <TextBlock  Grid.Column="1" Text="{DynamicResource XMessageBox.xaml_QuXiao}" VerticalAlignment="Center" Style="{StaticResource ContentCommonTextBlock}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F4F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter  TargetName="ButtonBorder" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Width="80" Height="30" x:Name="tb_ConfirmContent" Content="{DynamicResource Queding}" HorizontalAlignment="Right" Margin="12,0,40,0"  Background="#FF8900"  BorderBrush="#ECEEF2" BorderThickness="0"  Cursor="Hand" 
                        Click="btn_Confirm_Click">
                <!--<Grid >
                    <TextBlock Name="tb_ConfirmContent"  Grid.Column="1" Text="确定" VerticalAlignment="Center" Foreground="#FFFFFF" Style="{StaticResource ContentCommonTextBlock}"/>
                </Grid>-->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBorder" CornerRadius="3" BorderThickness="0"  Background="#FF8900"  >
                            <TextBlock  Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="#FFFFFF" Style="{StaticResource ContentCommonTextBlock}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF9810"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter  TargetName="ButtonBorder" Property="Background" Value="#FF8900"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>


</Window>
