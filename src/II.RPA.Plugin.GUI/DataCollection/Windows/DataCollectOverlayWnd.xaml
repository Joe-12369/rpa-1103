<Window x:Class="II.RPA.Plugin.GUI.DataCollectOverlayWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.GUI"
        Loaded="Window_Loaded"
        IsVisibleChanged="Window_IsVisibleChanged"
        mc:Ignorable="d"
        Title="DataCollectOverlayWnd" 
        WindowStyle="None"
        Background="#00000000"
        Opacity="0.99"
        BorderThickness="0"
        Topmost="True"
        Left="0"
        Top="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        AllowsTransparency="True"
       >
    <!--
    KeyDown="CaptureWindow_KeyDown"
     KeyUp="CaptureWindow_KeyUp"-->
    <Canvas x:Name="CaptureCanvas" IsHitTestVisible="False">
        <Border x:Name="border_Tips" Visibility="Collapsed"  Background="#F0161923" CornerRadius="4" Panel.ZIndex="99" Width="225" VerticalAlignment="Center">
            <StackPanel Orientation="Vertical" >
                <StackPanel Orientation="Horizontal" Margin="0 10 0 10">
                    <Border CornerRadius="2" Width="29" Height="22" Margin="15 0 0 0"  BorderBrush="#4DD9DDE6" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Ctrl" Foreground="#CCFFFFFF" FontSize="12" Width="21" Height="16" />
                    </Border>
                    <TextBlock Text="+" Foreground="#CCFFFFFF" FontSize="12" Width="7" Height="16" Margin="4 0 4 0"/>
                    <Border CornerRadius="2" Width="56" Height="22" BorderBrush="#4DD9DDE6" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource DataCollectOverlayWnd.xaml_ShuBiaoZuoJian}" Foreground="#CCFFFFFF" FontSize="12" Width="48" Height="16" />
                    </Border>
                    <TextBlock x:Name="tb_captureTypeTips" Text="{DynamicResource DataCollectOverlayWnd.xaml_HuoQuCaiJiShuJu}" Foreground="#CCFFFFFF" FontSize="12" Width="96" Height="16" Margin="4 0 0 0"/>
                </StackPanel>
                <StackPanel x:Name="sp_escTips" Orientation="Horizontal" Visibility="Collapsed" Margin="0 0 0 10">
                    <Border CornerRadius="2" Width="29" Height="22" Margin="15 0 0 0"  BorderBrush="#4DD9DDE6" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Esc" Foreground="#CCFFFFFF" FontSize="12" Width="21" Height="16" />
                    </Border>
                    <TextBlock x:Name="tb_excTips" Text="{DynamicResource DataCollectOverlayWnd.xaml_QuXiaoShiQuCaiJiShuJu}" Foreground="#CCFFFFFF" FontSize="12"  Height="16" Margin="18 0 0 0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="border_tagTips" Visibility="Collapsed" Background="#ff8910" Height="20" CornerRadius="2 2 0 0" Padding="4 2 4 2" Panel.ZIndex="98" VerticalAlignment="Center">
            <TextBlock x:Name="txt_tagTips" Text="" Foreground="#FFFFFF" FontSize="12"  Height="16" />
        </Border>
        <DockPanel x:Name="dockPanel"  Visibility="Visible">
            <Rectangle x:Name="lightRect_Left" Width="100" Height="auto"  DockPanel.Dock="Left" ></Rectangle>
            <Rectangle x:Name="lightRect_Top" Height="100"  DockPanel.Dock="Top" ></Rectangle>
            <Rectangle x:Name="lightRect_Right" Width="100"  DockPanel.Dock="Right"></Rectangle>
            <Rectangle x:Name="lightRect_Bottom" Height="100"  DockPanel.Dock="Bottom" ></Rectangle>
            <Rectangle x:Name="lightRect" Fill="#29FF8900" RadiusX="2" RadiusY="2" Stroke="#FFFF8900" StrokeThickness="2"></Rectangle>
        </DockPanel>
    </Canvas>
</Window>
