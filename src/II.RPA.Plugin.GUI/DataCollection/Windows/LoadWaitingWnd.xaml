    <Window.Background>
        <SolidColorBrush Color="Transparent"/>
    </Window.Background>

    <Grid Background="White">
        <Border BorderThickness="1" BorderBrush="#E1E7EE"  CornerRadius="4,4,4,4" >
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
               
                <Image RenderOptions.BitmapScalingMode="HighQuality"  UseLayoutRounding="True" SnapsToDevicePixels="True" 
                       x:Name="im_RunLog" Grid.Column="0"  VerticalAlignment="Center" HorizontalAlignment="Center"
                       Width="40" Height="40"/>

                <StackPanel  VerticalAlignment="Center" Grid.Column="1" Margin="4,0,0,0">
                    <Label Grid.Column="1" x:Name="txt" FontSize="10px" Foreground="#2E2E2E" Content="{DynamicResource LoadWaitingWnd.xaml_ZhengZaiTongBuSheBei}" Margin="0,0,0,0"></Label>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>

