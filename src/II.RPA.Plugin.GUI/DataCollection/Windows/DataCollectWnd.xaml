        mc:Ignorable="d"
        Title="DataCollectWnd"
        Loaded="Window_Loaded"
        xmlns:customControls="https://HIK.Toolkit.WPF.CustomControls"
        Background="Transparent"
        Width="560" Height="442"
        MinWidth="560" MinHeight="442"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Topmost="True"
        
       >
   
