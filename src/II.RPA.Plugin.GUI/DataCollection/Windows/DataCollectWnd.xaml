    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary   Source="..\Resources\CommonStyle.xaml"/>
                <ResourceDictionary   Source="..\Resources\ColumnHeaderOriginStyle.xaml"/>
                <ResourceDictionary   Source="..\Resources\MyDataGridStyle.xaml" />
                <ResourceDictionary   Source="..\Resources\MyTooltipStyle.xaml"/>
                <ResourceDictionary   Source="..\Resources\DefaultTextToolTips.xaml"/>
                <ResourceDictionary   Source="..\Resources\SVGResources.xaml"/>
                <ResourceDictionary>
                    <Storyboard x:Key="HideWindow">
                        <DoubleAnimation Duration="0:0:0.6" From="1" To="0" Storyboard.TargetProperty="Opacity" FillBehavior="Stop" />
                        <DoubleAnimation Duration="0:0:0.3" From="1" To="0.8" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleX)" FillBehavior="Stop" Storyboard.TargetName="MainGrid"/>
                        <DoubleAnimation Duration="0:0:0.3" From="1" To="0.8" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleY)" FillBehavior="Stop" Storyboard.TargetName="MainGrid"/>
                    </Storyboard>
                    <Storyboard x:Key="ShowWindow">
                        <DoubleAnimation Duration="0:0:0.4" From="0.2" To="1" Storyboard.TargetProperty="Opacity" FillBehavior="Stop"/>
                        <DoubleAnimation Duration="0:0:0.3" From="0.8" To="1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleX)" FillBehavior="Stop" Storyboard.TargetName="MainGrid"/>
                        <DoubleAnimation Duration="0:0:0.3" From="0.8" To="1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleY)" FillBehavior="Stop" Storyboard.TargetName="MainGrid"/>
                    </Storyboard>

                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <dataTypeConverter:Bool2StateColorConverter x:Key="Bool2StateColorConverter"/>
            <dataConverter:TrimmedTextBlockVisibilityConverter x:Key="TrimmedTextBlockVisibilityConverter" />
            <Style x:Key="MyImageStyle" TargetType="Image">
                <Style.Setters>
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                    <Setter Property="UseLayoutRounding" Value="True"/>
                </Style.Setters>
            </Style>

            <Style x:Key="ImageBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E3E8EE"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <dataConverter:DictionaryConverter x:Key="DictionaryConverterKey" />
            <dataConverter:MultiValueConverter x:Key="MultiValueConverterKey" />

            <Style x:Key="MyMenuButtonStyle" TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Name="borderBtn" CornerRadius="0" Width="auto" HorizontalAlignment="Stretch" Height="24" BorderThickness="0,0,0,0">
                                <Border.Style>
                                    <Style>
                                        <Setter Property="Border.Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="Border.IsMouseOver" Value="True">
                                                <Setter Property="Border.Background" Value="#FFEEDB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{TemplateBinding MenuItem.Header}"  MaxWidth="115"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource CommonTextBlock}"  FontSize="12" Margin="16,0,0,0" Foreground="#505962"
                    VerticalAlignment="Center"  HorizontalAlignment="Left"></TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyMenuButtonStyleEx" TargetType="MenuItem">
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Name="borderBtn" CornerRadius="0" Width="auto" HorizontalAlignment="Stretch" Height="24" BorderThickness="0,0,0,0">
                                <Border.Style>
                                    <Style>
                                        <Setter Property="Border.Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="Border.IsMouseOver" Value="True">
                                                <Setter Property="Border.Background" Value="#FFEEDB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{TemplateBinding MenuItem.Header}" 
                                            MaxWidth="115"
                                           TextTrimming="CharacterEllipsis" 
                                           Style="{StaticResource CommonTextBlock}"  FontSize="12" Margin="16,0,0,0" Foreground="{TemplateBinding MenuItem.Foreground}"
                    VerticalAlignment="Center"  HorizontalAlignment="Left"></TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyFirstMenuButtonStyle" TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Name="borderBtn" CornerRadius="4,4,0,0" Width="auto" HorizontalAlignment="Stretch" Height="25" BorderThickness="0,0,0,0">
                                <Border.Style>
                                    <Style>
                                        <Setter Property="Border.Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="Border.IsMouseOver" Value="True">
                                                <Setter Property="Border.Background" Value="#FFEEDB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{TemplateBinding MenuItem.Header}" 
                                             MaxWidth="115"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CommonTextBlock}"  FontSize="12" Margin="16,2,0,0" Foreground="#505962"
                    VerticalAlignment="Center"  HorizontalAlignment="Left"></TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyLastMenuButtonStyle" TargetType="MenuItem">
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Name="borderBtn" CornerRadius="0,0,4,4" Width="auto" HorizontalAlignment="Stretch" Height="25" BorderThickness="0,0,0,0">
                                <Border.Style>
                                    <Style>
                                        <Setter Property="Border.Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="Border.IsMouseOver" Value="True">
                                                <Setter Property="Border.Background" Value="#FFEEDB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock  MaxWidth="115"
                                           TextTrimming="CharacterEllipsis" Text="{TemplateBinding MenuItem.Header}" Style="{StaticResource CommonTextBlock}"  FontSize="12" Margin="16,0,0,2" Foreground="#505962" VerticalAlignment="Center"  HorizontalAlignment="Left"></TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyButtonStyle" TargetType="Button">
                <Style.Setters>
                    <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                    <Setter Property="ClickMode" Value="Release"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Name="ButtonBorder"
                                    BorderThickness="0"
                                    Padding="0,0"
                                    CornerRadius="1"
                                    Background="Transparent">
                                    <Image Source="../Assets/Images/DeExpand.png" Height="14" Width="14" Style="{StaticResource MyImageStyle}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
            </Style>

            <Style x:Key="MyArrowDownButtonStyle" TargetType="Button">
                <Style.Setters>
                    <Setter Property="ClickMode" Value="Release"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border 
                                    BorderThickness="0"
                                    Padding="0,0"
                                    CornerRadius="1"
                                    Background="Transparent">
                                    <svgc:SvgViewbox Height="14" Width="14" Source="../Assets/SvgIcon/ArrowDown.svg"/>
                                    <!--<Image  Source="../Assets/Images/ArrowDown.png" Height="14" Width="14" Style="{StaticResource MyImageStyle}"/>-->
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
            </Style>

            <Style x:Key="MyDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#D9DDE6" Opacity="1"></SolidColorBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="#F1F4F7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Border BorderBrush="#D9DDE6" Background="#F1F4F7" BorderThickness="0" Cursor="Hand">
                                <Grid Name="HeaderGrid" Height="26" Margin="0,0,0,0"  HorizontalAlignment="Stretch" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="0"/>
                                    </Grid.ColumnDefinitions>

                                    <Themes:DataGridHeaderBorder Grid.Column="1"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1"  Background="{TemplateBinding Background}" IsHovered="{TemplateBinding IsMouseOver}" IsClickable="{TemplateBinding CanUserSort}" IsPressed="{TemplateBinding IsPressed}"  Padding="{TemplateBinding Padding}" SortDirection="{TemplateBinding SortDirection}" SeparatorBrush="{TemplateBinding SeparatorBrush}" SeparatorVisibility="{TemplateBinding SeparatorVisibility}">
                                        <Grid>
                                            <Button x:Name="btnMore" ClickMode="Release" Background="Transparent"  IsHitTestVisible="True" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.OpenPopupCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border BorderThickness="0" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!--<ContentPresenter Name="c_HeaderContent"  Grid.Column="0" Margin="10,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />-->
                                                                <!--<TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=StackPanel}, Path=Children[0].Text}" Foreground="Red" />-->
                                                                <!--<TextBlock Foreground="Blue">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{2}">
                                                                        <Binding ElementName="TB1" Path="Text" />
                                                                        <Binding ElementName="TB2" Path="Text" />
                                                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=StackPanel}" Path="Children[0].Text" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                             Style="{StaticResource CommonTextBlock}"
                                                            </TextBlock>-->
                                                                <Border Grid.Column="0" Margin="5,0,5,0"  Background="#FFFFFF" BorderThickness="0" Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center" >
                                                                    <Path Data="{StaticResource SVG_ViewBoxArrowDown}"   HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform" Fill="#979797" Width="9" Height="9" RenderTransformOrigin="0.5,0.5" >
                                                                    </Path>
                                                                </Border>
                                                                <TextBlock Padding="0,0,0,0" Grid.Column="1" FontSize="13"    VerticalAlignment="Center"  Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridColumnHeader}, Path=Content}" TextTrimming="CharacterEllipsis"  Foreground="#505962"/>
                                                                <!--<svgc:SvgViewbox  Stretch="Uniform" Width="9" Height="9" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Source="../Assets/SvgIcon/ArrowDown.svg"/>-->
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.CommandParameter>
                                                    <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                    <!--<MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                        <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                        <Binding ElementName="popMore"></Binding>
                                                    </MultiBinding>-->
                                                </Button.CommandParameter>
                                            </Button>

                                            <ContentPresenter Visibility="Collapsed" Name="c_HeaderContent"  Grid.Column="0" Margin="10,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Grid>
                                    </Themes:DataGridHeaderBorder>
                                    
                                    <!--<Button Name="btnMore"  HorizontalAlignment="Right" Grid.Column="2"   Style="{StaticResource MyButtonStyle}"/>-->

                                    <Thumb x:Name="PART_LeftHeaderGripper" Grid.Column="0"  HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                                    <Thumb x:Name="PART_RightHeaderGripper" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}"/>

                                    <!--IsOpen="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.PopupIsOpen, Mode=TwoWay}"-->
                                    <Popup x:Name="popMore" PlacementTarget="{Binding ElementName=btnMore}" PopupAnimation="Slide" IsOpen="False"  StaysOpen="False"  Placement="Bottom"  AllowsTransparency="True" VerticalOffset="-1" >
                                        <Border  Width="140" Margin="4" CornerRadius="4" Background="White">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#c0c0c0"/>
                                            </Border.Effect>
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Stretch"  Orientation="Vertical" >
                                                    <!--Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.CurrentColumnContentType}"-->
                                                    <MenuItem Name="btn_EditColumeName" 
                                                        Style="{StaticResource MyFirstMenuButtonStyle}"
                                                              Header="{DynamicResource DataCollectWnd.xaml_BianJiBiaoTou}"
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.EditColumnHeaderCommand}" >
                                                        <!--Header="{DynamicResource DataCollectWnd.xaml_BianJiBiaoTou}"-->
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                                <Binding ElementName="StaffAdminView"></Binding>
                                                                <Binding ElementName="HeaderGrid"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_BianJiBiaoTou}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_EditColumn" Header="{DynamicResource DataCollectWnd.xaml_BianJiLieShuJu}"
