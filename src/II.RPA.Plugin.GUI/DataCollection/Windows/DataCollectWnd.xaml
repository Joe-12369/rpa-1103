                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.EditColumnSelectorCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <!--<Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>-->
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                                <Binding ElementName="StaffAdminView"></Binding>
                                                                <Binding ElementName="HeaderGrid"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_BianJiLieShuJu}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_CaptureSimElement" Header="{DynamicResource DataCollectWnd.xaml_ShiQuTongLeiShuJu}"
                                                    Style="{StaticResource MyMenuButtonStyle}" 
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.GetSimulateItemCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_ShiQuTongLeiShuJu}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <Separator Background="#D9DDE6" Height="1" Margin="16,0,16,0"/>

                                                    <MenuItem Name="btn_GetContentText" Header="{DynamicResource DataCollectWnd.xaml_TiQuWenBenNeiRong}"
                                                              Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.CurrentColumnContentType,Converter={StaticResource Bool2StateColorConverter},Mode=OneWay}"
                                                              Style="{StaticResource MyMenuButtonStyleEx}"
                                                              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.GetTextContentCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_TiQuWenBenNeiRong}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_GetLink" Header="{DynamicResource DataCollectWnd.xaml_TiQuLianJieDiZhi}" 
                                                              Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.CurrentColumnHrefType,Converter={StaticResource Bool2StateColorConverter},Mode=OneWay}"
                                                              Style="{StaticResource MyMenuButtonStyleEx}" 
                                                              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.GetLinkCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_TiQuLianJieDiZhi}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_GetImageSrc" Header="{DynamicResource DataCollectWnd.xaml_TiQuTuPianDiZhi}"
                                                              Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.CurrentColumnSrcType,Converter={StaticResource Bool2StateColorConverter},Mode=OneWay}"
                                                              Style="{StaticResource MyMenuButtonStyleEx}"    
                                                              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.GetImageSrcCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_TiQuTuPianDiZhi}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_EditRegular" Header="{DynamicResource DataCollectWnd.xaml_GeShiHuaNeiRong}" 
                                                        Style="{StaticResource MyMenuButtonStyle}"
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.EditRegularExpressionCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_GeShiHuaNeiRong}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <Separator Background="#D9DDE6" Height="1" Margin="16,0,16,0"/>

                                                    <MenuItem Name="btn_MoveColumnForward" Header="{DynamicResource DataCollectWnd.xaml_QianYiYiLie}" 
                                          Style="{StaticResource MyMenuButtonStyle}" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.MoveForewardCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_QianYiYiLie}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_MoveColumnBack" Header="{DynamicResource DataCollectWnd.xaml_HouYiYiLie}"
                                                      Style="{StaticResource MyMenuButtonStyle}"
                                                              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.MoveBackwardCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.ToolTip>
                                                            <ToolTip Content="{DynamicResource DataCollectWnd.xaml_HouYiYiLie}"/>
                                                        </MenuItem.ToolTip>
                                                    </MenuItem>

                                                    <MenuItem Name="btn_DeleteColumn" Header="{DynamicResource DataCollectWnd.xaml_ShanChuLie}" 
                                          Style="{StaticResource MyLastMenuButtonStyle}" 
                                          Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.DataGridModel.DeleteColumnCommand}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueConverterKey}">
                                                                <Binding Path="Content" ElementName="c_HeaderContent"/>
                                                                <Binding ElementName="popMore"></Binding>
                                                                <Binding ElementName="StaffAdminView"></Binding>
                                                                <Binding ElementName="HeaderGrid"></Binding>
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
