<Window
    x:Class="II.RPA.Plugin.GUI.ProcessCreator.CaptureCursorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Name="RootWindow"
    Title="CaptureCursorWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="#33000000"
    IsHitTestVisible="True"
    KeyUp="Window_KeyUp"
    MouseLeftButtonUp="Window_MouseLeftButtonUp"
    MouseMove="Window_MouseMove"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid x:Name="mainGrid">
        <Line
            x:Name="xLine"
            VerticalAlignment="Top"
            Stroke="#FF8910"
            StrokeDashArray="2,3"
            StrokeDashCap="Round"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="2"
            Visibility="Visible"
            X1="0"
            X2="{Binding ElementName=RootWindow, Path=ActualWidth}" />
        <Line
            x:Name="yLine"
            HorizontalAlignment="Left"
            Stroke="#FF8910"
            StrokeDashArray="2,3"
            StrokeDashCap="Round"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="2"
            Visibility="Visible"
            Y1="0"
            Y2="{Binding ElementName=RootWindow, Path=ActualHeight}" />
        <Border
            Name="LocationBorder"
            Width="auto"
            Height="auto"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#DD0C0F1B"
            CornerRadius="3">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Viewbox
                        Width="14"
                        Height="14"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Canvas Width="1024" Height="1024">
                            <Path Fill="#FFFFFFFF">
                                <Path.Data>
                                    <PathGeometry Figures="M36.571429 767.195429h950.857142v73.142857H36.571429z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <Path Fill="#FFFFFFFF">
                                <Path.Data>
                                    <PathGeometry Figures="M255.049143 36.571429v950.857142h-73.142857V36.571429z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <Path Fill="#FFFF971E">
                                <Path.Data>
                                    <PathGeometry Figures="M607.085714 123.538286c100.937143 0 182.857143 66.998857 182.857143 178.249143 0 74.166857-60.928 172.324571-182.857143 294.546285-121.929143-122.148571-182.857143-220.379429-182.857143-294.546285 0-111.250286 81.92-178.249143 182.857143-178.249143z m0 109.714285a73.142857 73.142857 0 1 0 0 146.285715 73.142857 73.142857 0 0 0 0-146.285715z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        x:Name="Show_Location"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="White"
                        Text="坐标"
                        TextAlignment="Left">
                        (<Run Name="MousePointX" />
                        ,<Run Name="MousePointY" />
                        )</TextBlock>
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Height="1"
                    Margin="3"
                    Background="#1AECEEF2"
                    BorderThickness="0" />
                <StackPanel
                    Grid.Row="2"
                    Margin="3"
                    Orientation="Horizontal">
                    <Border Background="#ff8910" CornerRadius="3">
                        <TextBlock
                            Margin="3"
                            Foreground="White"
                            Text="Ctrl" />
                    </Border>
                    <TextBlock
                        Margin="3,2,0,0"
                        Foreground="White"
                        Text="+" />
                    <Border
                        Margin="3,0,0,0"
                        Background="#ff8910"
                        CornerRadius="3">
                        <TextBlock
                            Margin="3"
                            Foreground="White"
                            Text="鼠标左键" />
                    </Border>
                    <TextBlock
                        Margin="3,2,0,0"
                        Foreground="White"
                        Text="获取当前坐标" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Margin="3"
                    Orientation="Horizontal">
                    <Border Background="#ff8910" CornerRadius="3">
                        <TextBlock
                            Margin="3"
                            Foreground="White"
                            Text="Esc" />
                    </Border>
                    <TextBlock
                        Margin="3,2,0,0"
                        Foreground="White"
                        Text="退出" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
