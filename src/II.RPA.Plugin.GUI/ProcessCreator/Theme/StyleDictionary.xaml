            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border
                        Width="Auto"
                        Height="1"
                        Background="#334355"
                        BorderThickness="0"
                        CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DummyInputButtonStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Border"
                        Background="#FFFFFF"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="17"
                        TextBlock.Foreground="{TemplateBinding Foreground}">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="#ACADB2" />
                        </Border.Effect>
                        <ContentPresenter
                            Margin="2"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.3" />
                                    <VisualTransition GeneratedDuration="0" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#CCFFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(BorderBrush).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FF971E" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#AAFFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Black" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Black" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                    <ControlTemplate.Triggers />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainActionButtonStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        Width="auto"
                        Height="auto"
                        Margin="0,0,0,0"
                        Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="Border"
                            Grid.Row="0"
                            Width="40"
                            Height="40"
                            Margin="0"
                            VerticalAlignment="Bottom"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="6"
                                    Opacity="0.5"
                                    ShadowDepth="4"
                                    Color="#BEBEBE" />
                            </Border.Effect>
                            <Image
                                Width="40"
                                Height="40"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="{TemplateBinding Tag}"
                                Stretch="Uniform"
                                UseLayoutRounding="True" />
                        </Border>
                        <Popup
                            x:Name="popup"
                            AllowsTransparency="True"
                            HorizontalOffset="-20"
                            Placement="Top"
                            PlacementTarget="{Binding ElementName=Border}"
                            PopupAnimation="Slide">
                            <Grid>
                                <Path
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    StrokeThickness="0">
                                    <Path.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.3"
                                            ShadowDepth="2"
                                            Color="#22BEBEBE" />
                                    </Path.Effect>
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#FFFFFF" />
                                            <GradientStop Offset="1" Color="#FFFAFA" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure IsClosed="True" StartPoint="4,0">
                                                <ArcSegment Point="0,4" Size="4,4" />
                                                <LineSegment Point="0,24" />
                                                <ArcSegment Point="4,28" Size="4,4" />
                                                <LineSegment Point="34,28" />
                                                <LineSegment Point="37,31" />
                                                <LineSegment Point="40,28" />
                                                <LineSegment Point="74,28" />
                                                <ArcSegment Point="78,24" Size="4,4" />
                                                <LineSegment Point="78,4" />
                                                <ArcSegment Point="74,0" Size="4,4" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}" />
                            </Grid>

                        </Popup>
                        <TextBlock
                            Grid.Row="1"
                            MaxWidth="60"
                            Margin="2,3,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Text="{TemplateBinding Content}"
                            TextTrimming="CharacterEllipsis" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1" />
                                    <VisualTransition GeneratedDuration="0" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Height">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="45" />
                                        </DoubleAnimationUsingKeyFrames>
