<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.AttachProperty"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:model="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator"
    xmlns:screenshot="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Screenshot"
    xmlns:theme="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Theme"
    xmlns:uc="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/Generic.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/VariableStyleDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/ItemTextBoxDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/OriginCheckBoxStyle.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ActionDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="IconTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/#iconfont" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="BigIconTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/#iconfont" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ComponentIconTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/component/#iconfont" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="IconLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/#iconfont" />
        <Setter Property="Foreground" Value="{StaticResource SearchBox.BorderBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="MenuItem.SeparatorStyle" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border
                        Width="100"
                        Height="1"
                        Margin="4"
                        Background="{StaticResource MenuItem.Text.Foreground}"
                        BorderThickness="0"
                        CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource MenuItem.Background}" />
        <Setter Property="Foreground" Value="{StaticResource MenuItem.Text.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MenuItemText}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="ap:ControlAttachProperty.FIconSize" Value="{StaticResource FontSize.MenuItemIcon}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <!--  Item  -->
                    <Border
                        x:Name="border"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        Opacity="1">
                        <Grid
                            Margin="{TemplateBinding Margin}"
                            VerticalAlignment="Center"
                            Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    x:Name="icon_col"
                                    MaxWidth="35"
                                    SharedSizeGroup="MenuItemIconColumnGroup" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTextColumnGroup" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                                <ColumnDefinition
                                    x:Name="arrow_col"
                                    Width="16"
                                    SharedSizeGroup="MenumItemArrow" />
                            </Grid.ColumnDefinitions>
                            <!--  icon  -->
                            <TextBlock
                                x:Name="PART_Icon"
                                Margin="1,1,1,1"
                                FontSize="{TemplateBinding ap:ControlAttachProperty.FIconSize}"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                Style="{StaticResource IconTextBlock}"
                                Text="{TemplateBinding Icon}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="rotate" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <!--  Header  -->
                            <ContentPresenter
                                x:Name="txtHeader"
                                Grid.Column="1"
                                MinWidth="90"
                                Margin="3,1,5,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                            <!--  快捷键  -->
                            <TextBlock
                                x:Name="IGTHost"
                                Grid.Column="2"
                                Margin="3,1,3,1"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding InputGestureText}"
                                Visibility="Visible" />
                            <!--  右指针  -->
                            <TextBlock
                                x:Name="PART_Arrow"
                                Grid.Column="3"
                                FontSize="14"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource IconTextBlock}"
                                Text="&#xe687;" />
                            <!--  淡出子集菜单容器  -->
                            <Popup
                                x:Name="SubMenuPopup"
                                AllowsTransparency="true"
                                Focusable="True"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Right"
                                PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                VerticalOffset="0">
                                <Border
                                    Margin="5"
                                    Background="{StaticResource Main.Bg}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Effect="{StaticResource DefaultDropShadow}">
                                    <Grid x:Name="SubMenu" Grid.IsSharedSizeScope="True">
                                        <StackPanel
                                            Margin="0"
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <!--  触发器  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <Setter TargetName="PART_Icon" Property="Margin" Value="5,1,1,1" />
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,6,1" />
                            <!--<Setter Property="MinWidth" Value="10" TargetName="txtHeader"/>-->
                            <!--<Setter Property="Width" Value="0" TargetName="arrow_col"/>-->
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <Setter TargetName="PART_Icon" Property="Margin" Value="5,1,1,1" />
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,6,1" />
                            <!--<Setter Property="MinWidth" Value="10" TargetName="txtHeader"/>-->
                            <Setter TargetName="arrow_col" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SubMenuPopup" Property="Placement" Value="Right" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubMenuItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Icon" Property="Text" Value="&#xe62a;" />
                            <Setter TargetName="PART_Icon" Property="FontSize" Value="18" />
                            <Setter TargetName="PART_Icon" Property="Foreground" Value="{StaticResource MenuItem.MouseOver.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="{StaticResource DisableOpacity}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="true">
                            <!--<Setter Property="Background" TargetName="border" Value="{StaticResource MenuItem.MouseOver.Background}"></Setter>-->
                            <Setter Property="Foreground" Value="{StaticResource MenuItem.MouseOver.Foreground}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="180"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource MenuItem.Press.Background}" />

                            <!--<Setter Property="Foreground" Value="{StaticResource MenuPressedForeground}"></Setter>-->
                        </Trigger>
                        <!--  子菜单打开状态  -->
                        <Trigger Property="IsSubmenuOpen" Value="true">
                            <Setter TargetName="PART_Arrow" Property="Foreground" Value="{StaticResource CheckedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataItemType}" Value="{x:Static model:DataItemType.SEPARATOR}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Separator Style="{StaticResource MenuItem.SeparatorStyle}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="DefaultMenuItem"
        BasedOn="{StaticResource IconMenuItem}"
        TargetType="{x:Type MenuItem}">
        <Setter Property="Command" Value="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}, AncestorLevel=4}}" />
        <Setter Property="CommandParameter" Value="{Binding InputActionBoxStyleHeader, RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="Icon" Value="{Binding ActionIcon}" />
    </Style>
    <Style
        x:Key="TransparentMenuItem"
        BasedOn="{StaticResource DefaultMenuItem}"
        TargetType="{x:Type MenuItem}">
        <Setter Property="BorderBrush" Value="{StaticResource LogoBlue}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MenuItem.Text.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MenuItemText}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="140" />
        <Setter Property="Margin" Value="1" />
    </Style>
    <Style x:Key="DefaultMenu" TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Background" Value="{StaticResource Main.Bg}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ItemsPresenter Margin="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TranparentMenu" TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ItemsPresenter Margin="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HoverIconMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource MenuItem.Background}" />
        <Setter Property="Foreground" Value="{StaticResource MenuItem.Text.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MenuItemText}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="ap:ControlAttachProperty.FIconSize" Value="{StaticResource FontSize.MenuItemIcon}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <!--  Item  -->
                    <Border
                        x:Name="border"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Opacity="1">
                        <Grid
                            Margin="{TemplateBinding Margin}"
                            VerticalAlignment="Center"
                            Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    x:Name="icon_col"
                                    MaxWidth="35"
                                    SharedSizeGroup="MenuItemIconColumnGroup" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTextColumnGroup" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                                <ColumnDefinition
                                    x:Name="arrow_col"
                                    Width="16"
                                    SharedSizeGroup="MenumItemArrow" />
                            </Grid.ColumnDefinitions>
                            <!--  icon  -->
                            <TextBlock
                                x:Name="PART_Icon"
                                Margin="1,1,1,1"
                                FontSize="{TemplateBinding ap:ControlAttachProperty.FIconSize}"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                Style="{StaticResource ComponentIconTextBlock}"
                                Text="{TemplateBinding Icon}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="rotate" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <!--  Header  -->
                            <ContentPresenter
                                x:Name="txtHeader"
                                Grid.Column="1"
                                MinWidth="90"
                                Margin="3,1,5,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                            <!--  快捷键 InputGestureText 暂不支持你了  -->
                            <TextBlock
                                x:Name="IGTHost"
                                Grid.Column="2"
                                Margin="3,1,3,1"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding InputGestureText}"
                                Visibility="Visible" />
                            <!--  右指针  -->
                            <TextBlock
                                x:Name="PART_Arrow"
                                Grid.Column="3"
                                FontSize="14"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource IconTextBlock}"
                                Text="&#xe687;" />
                            <!--  淡出子集菜单容器  -->
                            <Popup
                                x:Name="SubMenuPopup"
                                AllowsTransparency="true"
                                Focusable="True"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Bottom"
                                PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                VerticalOffset="0">
                                <Border
                                    Margin="5"
                                    Background="{StaticResource Main.Bg}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Effect="{StaticResource DefaultDropShadow}">
                                    <Grid x:Name="SubMenu" Grid.IsSharedSizeScope="True">
                                        <StackPanel
                                            Margin="0"
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <!--  触发器  -->
                    <ControlTemplate.Triggers>
                        <!--  TopLevelHeader:第一级菜单（有子菜单）  -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <Setter TargetName="PART_Icon" Property="Margin" Value="5,1,1,1" />
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,6,1" />
                            <!--<Setter Property="MinWidth" Value="10" TargetName="txtHeader"/>-->
                            <!--<Setter Property="Width" Value="0" TargetName="arrow_col"/>-->
                        </Trigger>
                        <!--  TopLevelItem 第一级菜单（无子级）  -->
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <Setter TargetName="PART_Icon" Property="Margin" Value="5,1,1,1" />
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,6,1" />
                            <!--<Setter Property="MinWidth" Value="10" TargetName="txtHeader"/>-->
                            <Setter TargetName="arrow_col" Property="Width" Value="0" />
                        </Trigger>
                        <!--  SubmenuHeader:子菜单，有子菜单  -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SubMenuPopup" Property="Placement" Value="Right" />
                        </Trigger>
                        <!--  SubMenuItem:子菜单，无子级  -->
                        <Trigger Property="Role" Value="SubMenuItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!--  选中状态，优先级将高于Icon  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Icon" Property="Text" Value="&#xe62a;" />
                            <Setter TargetName="PART_Icon" Property="FontSize" Value="18" />
                            <Setter TargetName="PART_Icon" Property="Foreground" Value="{StaticResource MenuItem.MouseOver.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="{StaticResource DisableOpacity}" />
                        </Trigger>
                        <!--  高亮状态  -->
                        <Trigger Property="IsHighlighted" Value="true">
                            <!--<Setter Property="Background" TargetName="border" Value="{StaticResource MenuItem.MouseOver.Background}"></Setter>-->
                            <Setter Property="Foreground" Value="{StaticResource MenuItem.MouseOver.Foreground}" />
                            <Setter Property="Background" Value="#F1F4F7" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="180"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource MenuItem.Press.Background}" />

                            <!--<Setter Property="Foreground" Value="{StaticResource MenuPressedForeground}"></Setter>-->
                        </Trigger>
                        <!--  子菜单打开状态  -->
                        <Trigger Property="IsSubmenuOpen" Value="true">
                            <Setter TargetName="PART_Arrow" Property="Foreground" Value="{StaticResource CheckedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataItemType}" Value="{x:Static model:DataItemType.SEPARATOR}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Separator Style="{StaticResource MenuItem.SeparatorStyle}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PreferMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.White}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MenuItem.Text.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MenuItemText}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="1,0,6,0" />
        <Setter Property="Header" Value="{Binding DataTemplateKey}" />
        <Setter Property="ToolTip" Value="{Binding ActionTip}" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="Command" Value="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        <Setter Property="CommandParameter" Value="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="ap:ControlAttachProperty.FIconSize" Value="{StaticResource FontSize.BigMenuItemIcon}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <!--  Item  -->
                    <Border
                        x:Name="border"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Opacity="1">
                        <Grid
                            Margin="{TemplateBinding Margin}"
                            VerticalAlignment="Center"
                            Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="icon_col" Height="auto" />
                                <RowDefinition x:Name="header_row" Height="Auto" />
                                <!--<RowDefinition Height="6" x:Name="arrow_col" />-->
                            </Grid.RowDefinitions>
                            <!--  icon  -->
                            <TextBlock
                                x:Name="PART_Icon"
                                Grid.Row="1"
                                Margin="1,1,1,1"
                                FontSize="12"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding ActionAlias}" />
                            <!--  Header  -->
                            <ContentPresenter
                                x:Name="txtHeader"
                                Grid.Row="0"
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <RotateTransform x:Name="rotate" Angle="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <!--  右指针  -->
                            <TextBlock
                                x:Name="PART_Arrow"
                                Grid.Row="1"
                                Margin="50,1,0,1"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                Style="{StaticResource IconTextBlock}"
                                Text="&#xe700;">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="rotate_arrow" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <!--  淡出子集菜单容器  -->
                            <Popup
                                x:Name="SubMenuPopup"
                                AllowsTransparency="true"
                                Focusable="True"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Bottom"
                                PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                VerticalOffset="0">
                                <Border
                                    Margin="5"
                                    Background="{StaticResource Brush.White}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Effect="{StaticResource DefaultDropShadow}">
                                    <Grid x:Name="SubMenu" Grid.IsSharedSizeScope="True">
                                        <StackPanel
                                            Margin="0"
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <!--  触发器  -->
                    <ControlTemplate.Triggers>
                        <!--  TopLevelHeader:第一级菜单（有子菜单）  -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <!--<Setter Property="Margin" Value="1,1,1,1" TargetName="PART_Icon"/>-->
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,1,1" />
                        </Trigger>
                        <!--  TopLevelItem 第一级菜单（无子级）  -->
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                            <!--<Setter Property="Visibility" Value="Collapsed" TargetName="IGTHost"/>-->
                            <!--<Setter Property="Margin" Value="1,1,1,1" TargetName="PART_Icon"/>-->
                            <Setter TargetName="txtHeader" Property="Margin" Value="1,1,1,1" />
                            <!--<Setter Property="MinWidth" Value="10" TargetName="txtHeader"/>-->
                            <!--<Setter Property="Height" Value="0" TargetName="arrow_col"/>-->
                        </Trigger>
                        <!--  SubmenuHeader:子菜单，有子菜单  -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SubMenuPopup" Property="Placement" Value="Right" />
                        </Trigger>
                        <!--  SubMenuItem:子菜单，无子级  -->
                        <Trigger Property="Role" Value="SubMenuItem">
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!--  选中状态，优先级将高于Icon  -->
                        <Trigger Property="IsChecked" Value="True">
                            <!--<Setter TargetName="PART_Icon" Value="{StaticResource MenuItem.MouseOver.Foreground}" Property="TextBlock.Foreground"></Setter>-->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="{StaticResource DisableOpacity}" />
                        </Trigger>
                        <!--  高亮状态  -->
                        <Trigger Property="IsHighlighted" Value="true">
                            <!--<Setter Property="Background" TargetName="border" Value="{StaticResource MenuItem.MouseOver.Background}"></Setter>-->
                            <Setter Property="Foreground" Value="{StaticResource MenuItem.MouseOver.Foreground}" />
                            <!--<Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                Storyboard.TargetName="rotate"
                                Storyboard.TargetProperty="Angle"
                                To="180" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                Storyboard.TargetName="rotate"
                                Storyboard.TargetProperty="Angle" To="0"
                                Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>-->
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <!--<Setter Property="Background" TargetName="border" Value="{StaticResource MenuItem.Press.Background}">
                            </Setter>-->
                            <Setter Property="Foreground" Value="{StaticResource MenuItem.Press.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="true">
                            <Setter TargetName="PART_Arrow" Property="Foreground" Value="{StaticResource CheckedForeground}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate_arrow"
                                            Storyboard.TargetProperty="Angle"
                                            To="180"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="rotate_arrow"
                                            Storyboard.TargetProperty="Angle"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataItemType}" Value="{x:Static model:DataItemType.SEPARATOR}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Separator Style="{StaticResource MenuItem.SeparatorStyle}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ScreenShotMenuItem"
        BasedOn="{StaticResource HoverIconMenuItem}"
        TargetType="{x:Type MenuItem}">
