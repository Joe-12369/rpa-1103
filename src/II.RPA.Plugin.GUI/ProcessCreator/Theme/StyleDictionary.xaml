                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                Margin="10,0,0,0"
                                Stretch="Uniform">
                                <Canvas Width="1024" Height="1024">
                                    <Canvas.Resources />
                                    <Path
                                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                        Name="path6"
                                        Fill="#77829D">
                                        <Path.Data>
