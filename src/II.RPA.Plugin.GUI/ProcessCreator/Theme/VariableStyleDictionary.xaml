                                </TransformGroup>
                            </ContentPresenter.LayoutTransform>
                        </ContentPresenter>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <!--<EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource STShow}" />
                        </EventTrigger>-->
                        <!--<EventTrigger RoutedEvent="Expander.Expanded">
                            <BeginStoryboard Storyboard="{StaticResource STShow}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Expander.Collapsed">
                            <BeginStoryboard Storyboard="{StaticResource STHide}" />
                        </EventTrigger>-->
                        <Trigger Property="IsExpanded" Value="true">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--<Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSite" Property="Background" Value="red" />
                        </Trigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ListBoxWithOutScrollViewStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                        <ItemsPresenter Margin="0,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false" />
                        <Trigger Property="IsMouseOver" Value="True" />
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="true" />
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                        </MultiTrigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DefaultListBox" TargetType="ListBox">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
        <Setter Property="MinWidth" Value="120" />
        <!--<Setter Property="MinHeight" Value="95" />-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <ScrollViewer Margin="0" Focusable="false">
                            <StackPanel Margin="2" IsItemsHost="True" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsGrouping" Value="true">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <uc:VariableItemStyleSelector
        x:Key="VariableItemStyleSelector"
        VariableCollectionStyle="{StaticResource VariableCollectionStyle}"
        VariableStyle="{StaticResource VariableStyle}" />
    <DataTemplate x:Key="VariableTemplate" DataType="{x:Type models:VariableModel}">
        <StackPanel x:Name="title" Orientation="Horizontal">
            <!--<TextBlock FontWeight="Black" Text="{Binding Name}" />-->
            <uc:HighlightTextBlock MaxWidth="242" HlContent="{Binding Title, Converter={StaticResource converterHlContent}}" />
            <TextBlock Foreground="#848A90">
                (<Run FontSize="12" Text="{Binding TypeString}" />
                )</TextBlock>
            <StackPanel.ToolTip>
                <ToolTip Style="{StaticResource ContentToolTipStyle}">
                    <TextBlock>
                        <Run Text="{Binding Title}" /><Run Text="{Binding TypeString}" />
                    </TextBlock>
                </ToolTip>
            </StackPanel.ToolTip>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:RootSource.Local}">
                <Setter TargetName="title" Property="ToolTip">
                    <Setter.Value>
                        <ToolTip Style="{StaticResource ContentToolTipStyle}">
                            <StackPanel Margin="0" Orientation="Horizontal">
                                <TextBlock Text="来源：" />
                                <Border Background="Gray" CornerRadius="4">
                                    <StackPanel Margin="1" Orientation="Horizontal">
                                        <TextBlock Text="第" />
                                        <TextBlock Text="{Binding LineNumber}" />
                                        <TextBlock Text="行" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="2,0,0,0" Text="{Binding ComponentName}" />
                            </StackPanel>
                        </ToolTip>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="SubVariableTemplate">
        <StackPanel Orientation="Horizontal">
            <!--<TextBlock FontWeight="Black" Text="{Binding Name}" />-->
            <uc:HighlightTextBlock MaxWidth="242" HlContent="{Binding Title, Converter={StaticResource converterHlContent}}" />
            <TextBlock Foreground="#848A90">
                (<Run FontSize="12" Text="{Binding TypeString}" />
                )</TextBlock>
            <StackPanel.ToolTip>
                <ToolTip Style="{StaticResource ContentToolTipStyle}">
                    <TextBlock>
                        <Run Text="{Binding Title}" /><Run Text="{Binding TypeString}" />
                    </TextBlock>
                </ToolTip>
            </StackPanel.ToolTip>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="VariableCollectionTemplate" DataType="{x:Type models:VariableModel}">
        <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource ExpanderStyle}">
            <Expander.Header>
                <uc:HighlightTextBlock
                    x:Name="collectionTitle"
                    MaxWidth="242"
                    HlContent="{Binding Title, Converter={StaticResource converterHlContent}}"
                    HlContentMouseDownCommand="{Binding DataContext.ActionDataContext.MouseDownActionCommand, RelativeSource={RelativeSource AncestorLevel=3, AncestorType={x:Type ListBoxItem}}}">
                    <uc:HighlightTextBlock.ToolTip>
                        <ToolTip Style="{StaticResource ContentToolTipStyle}">
                            <TextBlock>
                                <Run Text="{Binding Title}" /><Run Text="{Binding TypeString}" />
                            </TextBlock>
                        </ToolTip>
                    </uc:HighlightTextBlock.ToolTip>
                    <!--<i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding DataContext.MouseDownActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->
                </uc:HighlightTextBlock>
            </Expander.Header>
            <ListBox
                Name="varlistbox"
                Margin="15,0,0,0"
                ItemContainerStyle="{StaticResource SubVariableStyle}"
                ItemTemplate="{StaticResource SubVariableTemplate}"
                ItemsSource="{Binding MemeberCollectionView}"
                Style="{StaticResource ListBoxWithOutScrollViewStyle}">
                <!--<i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding DataContext.ActionDataContext.SelectionChangedCommand, RelativeSource={RelativeSource AncestorLevel=3, AncestorType={x:Type ListBoxItem}}}" CommandParameter="{Binding ElementName=varlistbox}" />
                </i:EventTrigger>-->
            </ListBox>
        </Expander>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:RootSource.Local}">
                <Setter TargetName="collectionTitle" Property="ToolTip">
                    <Setter.Value>
                        <ToolTip Style="{StaticResource ContentToolTipStyle}">
                            <StackPanel Margin="0" Orientation="Horizontal">
                                <TextBlock Text="来源：" />
                                <Border Background="Gray" CornerRadius="4">
                                    <StackPanel Margin="1" Orientation="Horizontal">
                                        <TextBlock Text="第" />
                                        <TextBlock Text="{Binding LineNumber}" />
                                        <TextBlock Text="{x:Static res:II_RPA_Resource.VariableStyleDictionary_C835E6AB}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="2,0,0,0" Text="{Binding ComponentName}" />
                            </StackPanel>
                        </ToolTip>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <uc:VariableDataTemplateSelector
        x:Key="VariableDataTemplateSelector"
        VariableCollectionTemplate="{StaticResource VariableCollectionTemplate}"
        VariableTemplate="{StaticResource VariableTemplate}" />
    <DataTemplate x:Key="RootTemplate" DataType="{x:Type models:RootModel}">
        <Grid>
            <Expander
                Name="RootExpander"
                IsExpanded="{Binding IsExpanded}"
                Style="{StaticResource RootExpanderStyle}">
                <Expander.Header>
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="12"
                        FontWeight="Bold">
                        <Run Foreground="#161923" Text="{Binding Name}" />
                        (<Run Foreground="#161923" Text="{Binding MemeberCount}" />
                        )</TextBlock>
                </Expander.Header>

                <ListBox
                    Name="listbox"
                    Margin="17,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    ItemContainerStyleSelector="{StaticResource VariableItemStyleSelector}"
                    ItemTemplateSelector="{StaticResource VariableDataTemplateSelector}"
                    ItemsSource="{Binding VariableCollectionView}"
                    Style="{StaticResource ListBoxWithOutScrollViewStyle}">
                    <!--<i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DataContext.ActionDataContext.SelectionChangedCommand, RelativeSource={RelativeSource AncestorLevel=2, AncestorType={x:Type ListBoxItem}}}" CommandParameter="{Binding ElementName=listbox}" />
                    </i:EventTrigger>-->
                </ListBox>
            </Expander>
            <Border
                Name="Separator"
                Width="240"
                Height="1"
                Margin="2,8,2,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="11"
                Background="#D9DDE6"
                BorderThickness="0" />
            <TextBlock
                Name="NullText"
                Width="100"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="11"
                Background="Transparent"
                Text="{x:Static res:II_RPA_Resource.VariableStyleDictionary_72462E2D}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:RootType.RootCollection}">
                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RootExpander" Property="Visibility" Value="Visible" />
                <Setter TargetName="NullText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:RootType.RootSeparator}">
                <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                <Setter TargetName="RootExpander" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NullText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:RootType.RootNull}">
                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RootExpander" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NullText" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="VarSelectTemplate">
        <Border
            Padding="3,2,3,2"
            Background="Orange"
            CornerRadius="5">
            <StackPanel>
                <TextBlock Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                <Button>
                    <Path Data="M0,0 10,10 0,10 10,0" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
