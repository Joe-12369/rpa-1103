        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <!--<Setter Property="ap:ListBoxItemCommand.ListBoxItemMouseDownCommand" Value="{Binding DataContext.ActionDataContext.ListBoxItemMouseDownCommand, RelativeSource={RelativeSource AncestorLevel=2, AncestorType={x:Type ListBoxItem}}}" />-->
        <!--<Setter Property="IsEnabled" Value="{Binding IsEnabled}" />-->
        <Setter Property="Template">
