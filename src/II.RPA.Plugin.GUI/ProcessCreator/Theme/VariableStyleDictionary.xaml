        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="ap:ListBoxItemCommand.ListBoxItemMouseDownCommand" Value="{Binding DataContext.ActionDataContext.ListBoxItemMouseDownCommand, RelativeSource={RelativeSource AncestorLevel=3, AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
