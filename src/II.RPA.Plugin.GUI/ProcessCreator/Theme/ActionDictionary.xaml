<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.AttachProperty"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:model="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator"
    xmlns:screenshot="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Screenshot"
    xmlns:theme="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Theme"
    xmlns:uc="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/Generic.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/VariableStyleDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/ItemTextBoxDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/OriginCheckBoxStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="InputActionBoxStyle" TargetType="{x:Type uc:ActionToggleButton}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="auto" />
        <Setter Property="Height" Value="auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ActionBoxWatermark" Value="" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type uc:ActionToggleButton}">
                    <Border
                        x:Name="Border"
                        Width="78"
                        Height="78"
                        Margin="2,0,2,8"
                        Background="#91FFFFFF"
                        CornerRadius="8">
                        <Grid Margin="0,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="imagebg"
                                Grid.Row="0"
                                Width="40"
                                Height="40"
                                Margin="0"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <!--<Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                    BlurRadius="1"
                                                    ShadowDepth="0"
                                                    Opacity="0.5"/>
                                </Border.Effect>-->
                                <Image
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="{TemplateBinding ActionIconImage}"
                                    Stretch="Uniform"
                                    UseLayoutRounding="True" />
                            </Border>
                            <uc:HoverToggle
                                x:Name="hovertoggle"
                                Width="14"
                                Height="14"
                                Margin="0,-5,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="9999"
                                Visibility="Collapsed">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DissButtonClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.DissCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </uc:HoverToggle>
                            <Popup
                                x:Name="popup"
                                AllowsTransparency="True"
                                HorizontalOffset="-20"
                                Placement="Top"
                                PlacementTarget="{Binding ElementName=Border}"
                                PopupAnimation="Slide">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Grid>
                                    <Path
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        StrokeThickness="0">
                                        <Path.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Opacity="0.3"
                                                ShadowDepth="2"
                                                Color="#22BEBEBE" />
                                        </Path.Effect>
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#FFFFFF" />
                                                <GradientStop Offset="0.1" Color="#FFFAFA" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure IsClosed="True" StartPoint="4,0">
                                                    <ArcSegment Point="0,4" Size="4,4" />
                                                    <LineSegment Point="0,24" />
                                                    <ArcSegment Point="4,28" Size="4,4" />
                                                    <LineSegment Point="34,28" />
                                                    <LineSegment Point="37,31" />
                                                    <LineSegment Point="40,28" />
                                                    <LineSegment Point="74,28" />
                                                    <ArcSegment Point="78,24" Size="4,4" />
                                                    <LineSegment Point="78,4" />
                                                    <ArcSegment Point="74,0" Size="4,4" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Content}" />
                                </Grid>

                            </Popup>
                            <Popup
                                x:Name="popup_input"
                                AllowsTransparency="True"
                                Focusable="True"
                                HorizontalOffset="2"
                                IsOpen="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsChecked}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                PopupAnimation="Slide"
                                StaysOpen="{Binding DataContext.ActionDataContext.IsHoldOnInputPopup, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                VerticalOffset="-114">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Border
                                    Margin="9"
                                    Background="#FFFFFF"
                                    CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Opacity="0.3"
                                            ShadowDepth="0"
                                            Color="Black" />
                                    </Border.Effect>
                                    <Grid
                                        Width="274"
                                        Height="112"
                                        Background="Transparent">
                                        <uc:ItemTextBox
                                            x:Name="inputbox"
                                            Height="66"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            InputText="{Binding DataContext.ElementInputText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            InputTextContentVerticalAlignment="Top"
                                            InputTextWaterMark="{TemplateBinding ActionBoxWatermark}"
                                            ItemText="{Binding DataContext.ActionDataContext.ResultString, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                        <ToggleButton
                                            Name="selectVarToggle"
                                            Width="18"
                                            Height="18"
                                            Margin="0,12,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#F1F4F7"
                                            BorderThickness="0"
                                            IsChecked="{Binding DataContext.ActionDataContext.IsOpenVarPopup, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                            Style="{StaticResource BaseToggleButton}">
                                            <ToggleButton.Content>
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas Width="1024" Height="1024">
                                                        <Path Fill="#707070">
                                                            <Path.Data>
                                                                <PathGeometry Figures="M428.970667 824.576a128 128 0 0 1-27.562667-27.477333l-302.08-411.989334a128 128 0 0 1 103.253333-203.690666h604.16a128 128 0 0 1 103.253334 203.690666l-302.08 411.989334a128 128 0 0 1-178.944 27.477333z m50.432-68.778667a42.666667 42.666667 0 0 0 54.613333-3.413333l5.034667-5.802667 302.08-411.904a42.666667 42.666667 0 0 0-26.794667-67.242666l-7.68-0.682667h-604.16a42.666667 42.666667 0 0 0-38.4 61.354667l4.096 6.570666 302.08 411.904 4.266667 4.949334 4.864 4.266666z" FillRule="NonZero" />
                                                            </Path.Data>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </ToggleButton.Content>
                                        </ToggleButton>
                                        <uc:TFButton
                                            Width="52"
                                            Height="28"
                                            Margin="0,0,72,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="White"
                                            BorderBrush="#D9DDE6"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ActionDataContext.InputCancelCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                            Content="{x:Static res:II_RPA_Resource.ActionDictionary_949856B3}"
                                            CornerRadius="4"
                                            MouseOverBackground="White"
                                            Style="{StaticResource TFButton_Base}" />
                                        <uc:TFButton
                                            Width="52"
                                            Height="28"
                                            Margin="0,0,12,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#FF8910"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.GetInputTextCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Content="{x:Static res:II_RPA_Resource.ActionDictionary_621A8231}"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            Foreground="White"
                                            IsDefault="True"
                                            MouseOverBackground="#99FF8910"
                                            MouseOverForeground="White"
                                            Style="{StaticResource TFButton_Base}">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{x:Static theme:Converters.ItemTextConverter}">
                                                    <Binding ElementName="inputbox" Path="InputText" />
                                                    <Binding ElementName="inputbox" Path="ItemText" />
                                                    <Binding ElementName="inputbox" Path="Mode" />
                                                    <Binding Path="Tag" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </uc:TFButton>
                                        <Popup
                                            Width="264"
                                            MaxHeight="248"
                                            Margin="1"
                                            AllowsTransparency="True"
                                            HorizontalOffset="-235"
                                            IsOpen="{Binding ElementName=selectVarToggle, Path=IsChecked}"
                                            Placement="Bottom"
                                            PlacementTarget="{Binding ElementName=selectVarToggle}"
                                            PopupAnimation="Scroll"
                                            StaysOpen="True"
                                            VerticalOffset="40">
                                            <Border
                                                Margin="5"
                                                Background="White"
                                                BorderThickness="0"
                                                CornerRadius="4">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="5"
                                                        Opacity="0.6"
                                                        ShadowDepth="0"
                                                        Color="#000000" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox
                                                        Grid.Row="0"
                                                        Margin="2,2,2,2"
                                                        ap:ControlAttachProperty.BlurRadius="0"
                                                        ap:ControlAttachProperty.CornerRadius="4"
                                                        ap:ControlAttachProperty.Watermark="{x:Static res:II_RPA_Resource.ActionDictionary_5E1B2D77}"
                                                        uc:TextChangedCommand.ChangedCommand="{Binding DataContext.ActionDataContext.TextChangedCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                        Background="White"
                                                        BorderBrush="#D9DDE6"
                                                        BorderThickness="1"
                                                        Foreground="Black"
                                                        MaxLines="1"
                                                        Style="{StaticResource LightSearchTextBox}"
                                                        Text="{Binding DataContext.ActionDataContext.SearchString, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                        TextWrapping="NoWrap" />
                                                    <ListBox
                                                        Grid.Row="1"
                                                        Width="auto"
                                                        VerticalAlignment="Top"
                                                        Background="White"
                                                        BorderThickness="0"
                                                        ItemTemplate="{StaticResource RootTemplate}"
                                                        ItemsSource="{Binding DataContext.ActionDataContext.RootCollection, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                        ScrollViewer.CanContentScroll="False"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                        Style="{StaticResource DefaultListBox}">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="{x:Type ListBoxItem}">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="ap:ListBoxItemCommand.ListBoxItemMouseDownCommand" Value="{Binding DataContext.ActionDataContext.ListBoxItemMouseDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                            <Border>
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <!--<i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Opened">
                                        <i:InvokeCommandAction Command="{Binding DataContext.InputPopupLoadedCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding ElementName=inputbox}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>-->
                            </Popup>
                            <TextBlock
                                x:Name="content"
                                Grid.Row="1"
                                MaxWidth="80"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="11"
                                Foreground="#505962"
                                Text="{TemplateBinding Content}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2" />
                                    <VisualTransition GeneratedDuration="0" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="content" Storyboard.TargetProperty="(TextBlock.Foreground).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#0C0F1B" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Orange" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hovertoggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CheckActionBoxStyle" TargetType="{x:Type uc:ActionToggleButton}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="auto" />
        <Setter Property="Height" Value="auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ActionBoxWatermark" Value="" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type uc:ActionToggleButton}">
                    <Border
                        x:Name="Border"
                        Width="78"
                        Height="78"
                        Margin="2,0,2,8"
                        Background="#91FFFFFF"
                        CornerRadius="8">
                        <Grid Margin="0,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="imagebg"
                                Grid.Row="0"
                                Width="40"
                                Height="40"
                                Margin="0"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <!--<Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                    BlurRadius="1"
                                                    ShadowDepth="0"
                                                    Opacity="0.5"/>
                                </Border.Effect>-->
                                <Image
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="{TemplateBinding ActionIconImage}"
                                    Stretch="Uniform"
                                    UseLayoutRounding="True" />
                            </Border>
                            <uc:HoverToggle
                                x:Name="hovertoggle"
                                Width="14"
                                Height="14"
                                Margin="0,-5,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="9999"
                                Visibility="Collapsed">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DissButtonClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.DissCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </uc:HoverToggle>
                            <Popup
                                x:Name="popup"
                                AllowsTransparency="True"
                                HorizontalOffset="-20"
                                Placement="Top"
                                PlacementTarget="{Binding ElementName=Border}"
                                PopupAnimation="Slide">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Grid>
                                    <Path
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        StrokeThickness="0">
                                        <Path.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Opacity="0.3"
                                                ShadowDepth="2"
                                                Color="#22BEBEBE" />
                                        </Path.Effect>
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#FFFFFF" />
                                                <GradientStop Offset="0.1" Color="#FFFAFA" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure IsClosed="True" StartPoint="4,0">
                                                    <ArcSegment Point="0,4" Size="4,4" />
                                                    <LineSegment Point="0,24" />
                                                    <ArcSegment Point="4,28" Size="4,4" />
                                                    <LineSegment Point="34,28" />
                                                    <LineSegment Point="37,31" />
                                                    <LineSegment Point="40,28" />
                                                    <LineSegment Point="74,28" />
                                                    <ArcSegment Point="78,24" Size="4,4" />
                                                    <LineSegment Point="78,4" />
                                                    <ArcSegment Point="74,0" Size="4,4" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Content}" />
                                </Grid>

                            </Popup>
                            <Popup
                                x:Name="popup_input"
                                AllowsTransparency="True"
                                Focusable="True"
                                HorizontalOffset="2"
                                IsOpen="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsChecked}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                PopupAnimation="Slide"
                                StaysOpen="{Binding DataContext.ActionDataContext.IsHoldOnInputPopup, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                VerticalOffset="-114">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Border
                                    Margin="9"
                                    Background="#FFFFFF"
                                    CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Opacity="0.3"
                                            ShadowDepth="0"
                                            Color="Black" />
                                    </Border.Effect>
                                    <Grid
                                        Width="274"
                                        Height="84"
                                        Background="Transparent">
                                        <ComboBox
                                            x:Name="comboBox"
                                            Width="258"
                                            Height="30"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Background="White"
                                            BorderBrush="#D9DDE6"
                                            BorderThickness="1"
                                            Foreground="Black"
                                            SelectedIndex="0"
                                            Style="{StaticResource DefaultComboBox}">
                                            <ComboBoxItem Content="{x:Static res:II_RPA_Resource.ActionDictionary_D8BF516C}" Tag="Check" />
                                            <ComboBoxItem Content="{x:Static res:II_RPA_Resource.ActionDictionary_E150309A}" Tag="Uncheck" />
                                            <ComboBoxItem Content="{x:Static res:II_RPA_Resource.ActionDictionary_963AF710}" Tag="GetCheckStatus" />
                                        </ComboBox>
                                        <uc:TFButton
                                            Width="52"
                                            Height="28"
                                            Margin="0,0,72,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="White"
                                            BorderBrush="#D9DDE6"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ActionDataContext.InputCancelCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                            Content="{x:Static res:II_RPA_Resource.ActionDictionary_949856B3}"
                                            CornerRadius="4"
                                            MouseOverBackground="White"
                                            Style="{StaticResource TFButton_Base}" />
                                        <uc:TFButton
                                            Width="52"
                                            Height="28"
                                            Margin="0,0,12,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#FF8910"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.CheckBoxOperationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding ElementName=comboBox, Path=SelectedIndex}"
                                            Content="{x:Static res:II_RPA_Resource.ActionDictionary_621A8231}"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            Foreground="White"
                                            IsDefault="True"
                                            MouseOverBackground="#99FF8910"
                                            MouseOverForeground="White"
                                            Style="{StaticResource TFButton_Base}">
                                            <!--<Button.CommandParameter>
                                                <MultiBinding Converter="{x:Static theme:Converters.ItemTextConverter}">
                                                    <Binding ElementName="comboBox" Path="SelectedValue" />
                                                    <Binding ElementName="comboBox" Path="SelectedItem" />
                                                    <Binding ElementName="comboBox" Path="Text" />
                                                    <Binding Path="Tag" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                                </MultiBinding>
                                            </Button.CommandParameter>-->
                                        </uc:TFButton>
