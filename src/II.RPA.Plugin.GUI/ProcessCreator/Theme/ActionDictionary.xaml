                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Orange" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hovertoggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SingleButtonActionBoxStyle" TargetType="{x:Type uc:ActionToggleButton}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="auto" />
        <Setter Property="Height" Value="auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ActionBoxWatermark" Value="" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type uc:ActionToggleButton}">
                    <Border
                        x:Name="Border"
                        Width="78"
                        Height="78"
                        Margin="2,0,2,8"
                        Background="#91FFFFFF"
                        CornerRadius="8">
                        <Grid Margin="0,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="imagebg"
                                Grid.Row="0"
                                Width="40"
                                Height="40"
                                Margin="0"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Image
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="{TemplateBinding ActionIconImage}"
                                    Stretch="Uniform"
                                    UseLayoutRounding="True" />
                            </Border>
                            <uc:HoverToggle
                                x:Name="hovertoggle"
                                Width="14"
                                Height="14"
                                Margin="0,-5,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="9999"
                                Visibility="Collapsed">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DissButtonClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.DissCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </uc:HoverToggle>
                            <Popup
                                x:Name="popup"
                                AllowsTransparency="True"
                                HorizontalOffset="-20"
                                Placement="Top"
                                PlacementTarget="{Binding ElementName=Border}"
                                PopupAnimation="Slide">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Grid>
                                    <Path
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        StrokeThickness="0">
                                        <Path.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Opacity="0.3"
                                                ShadowDepth="2"
                                                Color="#22BEBEBE" />
                                        </Path.Effect>
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#FFFFFF" />
                                                <GradientStop Offset="0.1" Color="#FFFAFA" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure IsClosed="True" StartPoint="4,0">
                                                    <ArcSegment Point="0,4" Size="4,4" />
                                                    <LineSegment Point="0,24" />
                                                    <ArcSegment Point="4,28" Size="4,4" />
                                                    <LineSegment Point="34,28" />
                                                    <LineSegment Point="37,31" />
                                                    <LineSegment Point="40,28" />
                                                    <LineSegment Point="74,28" />
                                                    <ArcSegment Point="78,24" Size="4,4" />
                                                    <LineSegment Point="78,4" />
                                                    <ArcSegment Point="74,0" Size="4,4" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Content}" />
                                </Grid>

                            </Popup>
                            <Popup
                                x:Name="popup_input"
                                AllowsTransparency="True"
                                Focusable="True"
                                HorizontalOffset="2"
                                IsOpen="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsChecked}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                PopupAnimation="Slide"
                                StaysOpen="{Binding DataContext.ActionDataContext.IsHoldOnInputPopup, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                VerticalOffset="-114">
                                <i:Interaction.Behaviors>
                                    <ap:PopupFocusBehavior />
                                </i:Interaction.Behaviors>
                                <Border
                                    Margin="9"
                                    Background="#FFFFFF"
                                    CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Opacity="0.3"
                                            ShadowDepth="0"
                                            Color="Black" />
                                    </Border.Effect>
                                    <Grid
                                        Width="274"
                                        Height="84"
                                        Background="Transparent">

                                        <uc:TFButton
                                            Width="258"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="White"
                                            BorderBrush="#D9DDE6"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.SingleBtnActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            Content="{x:Static res:II_RPA_Resource.ActionDictionary_46DA5B27}"
                                            CornerRadius="4"
                                            FIcon="{Binding Path=ActionButtonIconCode, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            FIconMargin="0,0,2,0"
                                            FIconSize="15"
                                            Foreground="#161923"
                                            IconFontFamily="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/component/#iconfont"
                                            IconForeground="#FF8910"
                                            MouseOverBackground="#ECEEF2"
                                            Style="{StaticResource TFButton_Base}" />

                                    </Grid>
                                </Border>
                            </Popup>
                            <TextBlock
                                x:Name="content"
                                Grid.Row="1"
                                MaxWidth="80"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="11"
                                Foreground="#505962"
                                Text="{TemplateBinding Content}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2" />
                                    <VisualTransition GeneratedDuration="0" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="content" Storyboard.TargetProperty="(TextBlock.Foreground).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#0C0F1B" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Orange" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).                       (SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="Gray" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hovertoggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
