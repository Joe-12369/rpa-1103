<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.AttachProperty"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    xmlns:theme="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Theme">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/Generic.xaml" />
        <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/PasswordTextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ItemTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ItemTextBox}">
                    <Grid Width="270" Height="{TemplateBinding Height}">
                        <TextBox
                            Name="PART_InputTextBox"
                            Margin="4,6,4,4"
                            Padding="4,6,16,2"
                            VerticalContentAlignment="{TemplateBinding InputTextContentVerticalAlignment}"
                            ap:ControlAttachProperty.CornerRadius="8"
                            ap:ControlAttachProperty.FocusBorderBrush="#FF8910"
                            ap:ControlAttachProperty.MouseOverBorderBrush="#66FF971E"
                            ap:ControlAttachProperty.Watermark="{TemplateBinding InputTextWaterMark}"
                            Background="#F5F8FC"
                            BorderBrush="#66FF971E"
                            BorderThickness="1"
                            FontSize="12"
                            Foreground="#0C0F1B"
                            MaxLength="200"
                            Style="{StaticResource DefaultTextBox}"
                            Text="{TemplateBinding InputText}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <Border
                            Margin="4,6,4,4"
                            Padding="1"
                            BorderBrush="#FF8910"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ElementName=PART_ItemTextBorder, Path=Visibility}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Opacity="0.5"
                                    ShadowDepth="0"
                                    Color="#FF971E" />
                            </Border.Effect>
                            <Border
                                Name="PART_ItemTextBorder"
                                Margin="4,6,4,4"
                                Padding="5,3,5,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="{TemplateBinding InputTextContentVerticalAlignment}"
                                Background="Orange"
                                CornerRadius="5"
                                Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal">
                                    <TextBlock
                                        Name="PART_ItemTextBlock"
                                        Foreground="White"
                                        Text="{TemplateBinding ItemText}" />
                                    <Button
                                        x:Name="PART_ItemTextClearButton"
                                        Width="8"
                                        Height="8"
                                        Margin="5,0,5,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="Transparent">
                                                    <Viewbox>
                                                        <Path
                                                            Name="path"
                                                            Data="M0,0 10,10 M0,10 10,0"
                                                            Stroke="White"
                                                            StrokeThickness="1" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="path" Property="Stroke" Value="#F5F8FC" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ItemPasswordBoxStyle" TargetType="{x:Type local:ItemTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ItemTextBox}">
                    <Grid Width="270" Height="{TemplateBinding Height}">
                        <local:PasswordTextBox
                            x:Name="PART_InputTextBox"
                            Margin="4,6,4,4"
                            Padding="4,6,16,2"
                            VerticalContentAlignment="{TemplateBinding InputTextContentVerticalAlignment}"
                            ap:ControlAttachProperty.CornerRadius="8"
                            ap:ControlAttachProperty.FocusBorderBrush="#FF8910"
                            ap:ControlAttachProperty.MouseOverBorderBrush="#66FF971E"
                            Background="#F5F8FC"
                            BorderBrush="#66FF971E"
                            BorderThickness="1"
                            FontSize="12"
                            Foreground="#0C0F1B"
                            MaxLength="200"
                            PlaceHolder="{TemplateBinding InputTextWaterMark}"
                            Style="{StaticResource PasswordTextBox}"
                            Text="{TemplateBinding InputText}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <Border
                            Margin="4,6,4,4"
                            Padding="1"
                            BorderBrush="#FF8910"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ElementName=PART_ItemTextBorder, Path=Visibility}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Opacity="0.5"
                                    ShadowDepth="0"
                                    Color="#FF971E" />
                            </Border.Effect>
                            <Border
                                Name="PART_ItemTextBorder"
                                Margin="4,6,4,4"
                                Padding="5,3,5,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="{TemplateBinding InputTextContentVerticalAlignment}"
                                Background="Orange"
                                CornerRadius="5"
                                Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal">
                                    <TextBlock
                                        Name="PART_ItemTextBlock"
                                        Foreground="White"
                                        Text="{TemplateBinding ItemText}" />
                                    <Button
                                        x:Name="PART_ItemTextClearButton"
                                        Width="8"
                                        Height="8"
                                        Margin="5,0,5,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="Transparent">
                                                    <Viewbox>
                                                        <Path
                                                            Name="path"
                                                            Data="M0,0 10,10 M0,10 10,0"
                                                            Stroke="White"
                                                            StrokeThickness="1" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="path" Property="Stroke" Value="#F5F8FC" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>