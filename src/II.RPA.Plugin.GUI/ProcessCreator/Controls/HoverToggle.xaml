<UserControl x:Class="II.RPA.Plugin.GUI.ProcessCreator.Controls.HoverToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid
        x:Name="MainGrid"
        MouseEnter="Grid_MouseEnter" 
        MouseLeave="Grid_MouseLeave">
        <Button x:Name="hoverButton" 
                Height="14" 
                Width="14"
                IsEnabled="False"
                Panel.ZIndex="-1" 
                Click="HoverButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2" />
                                    <VisualTransition GeneratedDuration="0" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).
                      (SolidColorBrush.Color)"
                                                Storyboard.TargetName="Border">
                                            <EasingColorKeyFrame KeyTime="0"
                                         Value="#F1F4F7" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).
                      (SolidColorBrush.Color)"
                                                Storyboard.TargetName="Border">
                                            <EasingColorKeyFrame KeyTime="0"
                                         Value="#F1F4F7" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            CornerRadius="3"
                            Name="Border"
                            Background="Transparent"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        </Border>
                        <Ellipse
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Fill="#7A8187" 
                            Margin="2,0,0,0"
                            StrokeThickness="0" 
                            Height="2" 
                            Width="2"/>
                        <Ellipse
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Fill="#7A8187" 
                            
                            StrokeThickness="0" 
                            Height="2" 
                            Width="2"/>
                        <Ellipse
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Fill="#7A8187" 
                            Margin="0,0,2,0"
                            StrokeThickness="0" 
                            Height="2" 
                            Width="2"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Popup x:Name="popup"
               MouseLeave="Grid_MouseLeave"
               MouseEnter="Grid_MouseEnter"
               PlacementTarget="{Binding ElementName=MainGrid}"
               Placement="Bottom"
               StaysOpen="True"
               VerticalOffset="2"
               HorizontalOffset="-20"
               PopupAnimation="Slide"
               AllowsTransparency="True">
            <Grid Width="54" Height="32" Background="Transparent" Margin="0">
                <Border CornerRadius="4" Background="White" Margin="2">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"  
                                      BlurRadius="2"
                                      Direction="0"
                                      ShadowDepth="0" 
                                      Opacity="0.3"/>
                    </Border.Effect>
                </Border>
                <!--<Path StrokeThickness="0" 
                                  Margin="5"
                                  VerticalAlignment="Top" 
                                  HorizontalAlignment="Center">
                    <Path.Effect>
                        <DropShadowEffect Color="#22BEBEBE"  BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                    </Path.Effect>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FFFFFF"/>
                            <GradientStop Offset="1" Color="#FFFAFA"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure IsClosed="True" StartPoint="4,0">
                                <ArcSegment Point="0,4" Size="4,4"/>
                                <LineSegment Point="0,24"/>
                                <ArcSegment Point="4,28" Size="4,4"/>
                                <LineSegment Point="34,28"/>
                                <LineSegment Point="37,31"/>
                                <LineSegment Point="40,28"/>
                                <LineSegment Point="74,28"/>
                                <ArcSegment Point="78,24" Size="4,4"/>
                                <LineSegment Point="78,4"/>
                                <ArcSegment Point="74,0" Size="4,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>-->
                <Button
                    Margin="0,2,0,0"
                    Width="54" Height="32" 
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="11"
                    Click="Button_Click"
                    Content="{DynamicResource HoverToggle.xaml_BuZhunQue}" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2" />
                                            <VisualTransition GeneratedDuration="0" To="Pressed" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.Foreground).
                      (SolidColorBrush.Color)"
                                                Storyboard.TargetName="content">
                                                    <EasingColorKeyFrame KeyTime="0"
                                         Value="#0085FF" />
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                            CornerRadius="4"
                            Name="Border"
                            Background="Transparent"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                                </Border>
                                <ContentPresenter x:Name="content"
                                    Content="{TemplateBinding Content}"
                                                  TextBlock.FontWeight="Bold"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontFamily="/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/#思源黑体 CN"
                                                  HorizontalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
