<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls" 
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/shared" >
    <Style TargetType="{x:Type local:FontIcon}">
        <Setter Property="FontFamily" Value="/II.RPA.Plugin.GUI;component/ProcessCreator/Theme/#iconfont" />
        <Setter Property="local:FontIcon.Size" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FontIcon}">
                    <TextBlock Name="PART_IconText" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding Size}" FontStretch="Normal" FontStyle="Normal" FontWeight="Normal" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding CodeString}" />
                    <ControlTemplate.Triggers>
                       
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
