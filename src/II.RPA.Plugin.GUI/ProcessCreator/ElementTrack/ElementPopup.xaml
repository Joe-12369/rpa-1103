<Popup x:Class="II.RPA.Plugin.GUI.ProcessCreator.ElementTrack.ElementPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.ElementTrack"
             mc:Ignorable="d" AllowsTransparency="True" StaysOpen="True" Focusable="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Popup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml"/>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml"/>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml"/>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/StyleDictionary.xaml"/>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/ProgressRing.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Popup.Resources>
    <Border x:Name="mainBorder" Background="#33333333"
            CornerRadius="4"  
            BorderThickness="0" Margin="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource DarkBorderColor}"  BlurRadius="12" ShadowDepth="0"/>
        </Border.Effect>
        <!--<Path Stroke="{StaticResource LogoOrange}" Margin="0">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="5,0" IsClosed="True">
                            <ArcSegment Point="0,5" Size="5,5" SweepDirection="Counterclockwise"/>
                            <LineSegment Point="0,95"/>
                            <ArcSegment Point="5,100" Size="5,5"/>
                            <LineSegment Point="45,100"/>
                            <LineSegment Point="50,105"/>
                            <LineSegment Point="55,100"/>
                            <LineSegment Point="95,100"/>
                            <ArcSegment Point="100,95" Size="5,5"/>
                            <LineSegment Point="100,5"/>
                            <ArcSegment Point="95,0" Size="5,5" SweepDirection="Counterclockwise"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>-->
        <StackPanel Orientation="Vertical" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="6">
                <Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                    <TextBlock Text="Ctrl" FontSize="12" Foreground="Black" Margin="2"/>
                </Border>
                <TextBlock Text="+" Foreground="#848A90"/>
                <Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                    <TextBlock Text="鼠标左键" FontSize="12" Foreground="Black" Margin="2"/>
                </Border>
                <TextBlock Text="选择动作" Foreground="#848A90"/>
                <TextBox x:Name="txt" Text="aaa" Height="30" Focusable="True"/>
            </StackPanel>
            <!--<Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                <TextBlock Text="点击元素" FontSize="13" Foreground="Black" Margin="3"/>
            </Border>
            <Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                <TextBlock Text="等待元素" FontSize="13" Foreground="Black" Margin="3"/>
            </Border>
            <Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                <TextBlock Text="输入文本" FontSize="13" Foreground="Black" Margin="3"/>
            </Border>
            <Border Background="#FFC53A" BorderThickness="0" CornerRadius="4">
                <TextBlock Text="循环相似元素" FontSize="13" Foreground="Black" Margin="3"/>
            </Border>-->
