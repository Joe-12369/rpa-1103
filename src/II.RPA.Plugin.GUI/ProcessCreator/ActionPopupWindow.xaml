<Window
    x:Class="II.RPA.Plugin.GUI.ProcessCreator.ActionPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.AttachProperty"
    xmlns:control="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Mvvm"
    xmlns:vm="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.ActionProvider"
    Name="ActionWindow"
    Title="ActionPopupWindow"
    Width="278"
    Height="auto"
    AllowsTransparency="True"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/StyleDictionary.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/ProgressRing.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <vm:TextToVisiblityConverter x:Key="TextToVisiblityConverter" />
            <!--  弹出来  -->
            <Storyboard x:Key="ShowDW_Move">
                <DoubleAnimation
                    Storyboard.TargetName="mainGrid"
                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                    From="0.1"
                    To="1"
                    Duration="0:0:0.1" />
                <DoubleAnimation
                    Storyboard.TargetName="mainGrid"
                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                    From="0.1"
                    To="1"
                    Duration="0:0:0.1" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded" SourceName="ActionWindow">
            <BeginStoryboard Name="showQueryCanvasStoryboard2" Storyboard="{StaticResource ShowDW_Move}" />
        </EventTrigger>
    </Window.Triggers>
    <Grid
        x:Name="mainGrid"
        Margin="1"
        Background="Transparent">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform CenterX="0" CenterY="0" />
                <RotateTransform CenterX="100" CenterY="50" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border
            x:Name="ChromeBorder"
            Background="#77FFFFFF"
            BorderBrush="#CCFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="2"
                    Opacity="0.2"
                    ShadowDepth="0"
                    Color="#525252" />
            </Border.Effect>
        </Border>
        <Border
            Height="auto"
            MinHeight="265"
            Margin="0,0,0,0"
            VerticalAlignment="Top"
            Background="#01FFFFFF"
            CornerRadius="8">
            <!--<Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFF5FAFF"/>
                        <GradientStop Offset="1" Color="#FFFBFDFF"/>
                    </LinearGradientBrush>
                </Border.Background>-->
            <Grid>
                <!--<TextBlock Text="{Binding ElementTypeText}"/>-->
                <!--<TextBlock Text="{Binding ElementClassText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Foreground="Black"/>-->
                <Button
                    Name="DummyButton"
                    Height="34"
                    Margin="18,16,18,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    Click="Button_Click"
                    Cursor="IBeam"
                    FocusVisualStyle="{x:Null}"
                    Foreground="Black"
                    Style="{StaticResource DummyInputButtonStyle}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox
                                Width="18"
                                Height="18"
                                Margin="10,0,0,0"
                                Stretch="Uniform">
                                <Canvas Width="1024" Height="1024">
                                    <Canvas.Resources />
                                    <Path
                                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                        Name="path6"
                                        Fill="#77829D">
                                        <Path.Data>
                                            <PathGeometry Figures="M883.2 844.8l-115.2-128c51.2-59.733333 85.333333-136.533333 85.333333-226.133333 0-187.733333-153.6-341.333333-341.333333-341.333334s-341.333333 153.6-341.333333 341.333334 153.6 341.333333 341.333333 341.333333c72.533333 0 136.533333-21.333333 192-59.733333l115.2 132.266666c8.533333 8.533333 21.333333 12.8 29.866667 12.8s21.333333-4.266667 29.866666-12.8c21.333333-12.8 21.333333-42.666667 4.266667-59.733333zM256 490.666667c0-140.8 115.2-256 256-256s256 115.2 256 256-115.2 256-256 256-256-115.2-256-256z" FillRule="NonZero" />
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                Margin="4,1.2,0,0"
                                FontSize="13"
                                Foreground="#77829D"
                                Text="{DynamicResource ActionPopupWindow.xaml_SouSuoDongZuo}" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <ListBox
                    x:Name="recommendList"
                    Width="264"
                    Height="172"
                    Margin="16,66,1,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ActionCollectioView, IsAsync=True}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    Style="{StaticResource ActionListStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <mvvm:ExInvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding ElementName=recommendList, Path=SelectedItem}">
                                <!--<i:InvokeCommandAction.CommandParameter>
                                    <MultiBinding Converter="{StaticResource TextToVisiblityConverter}">
                                        <Binding Path="SelectedItem" ElementName="recommendList"/>
                                        <Binding Path="SelectedItem" ElementName="recommendList"/>
                                    </MultiBinding>
                                </i:InvokeCommandAction.CommandParameter>-->
                            </mvvm:ExInvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
                <!--<Expander
                    x:Name="StayOnExpander"
                    Margin="2,230,1,10"
                    Panel.ZIndex="999"
                    Background="Transparent"
                    Padding="0,0,0,-5"
                    IsExpanded="False"
                    ExpandDirection="Up"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource ExpanderStyle}">
                    <ListBox
                            x:Name="logicList"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,0,0"
                            ItemTemplateSelector="{StaticResource LogicItemTemplateSelector}"
                            ItemContainerStyle="{StaticResource LogicContentItemStyle}"
                            ItemsSource="{Binding LogicActionCollection}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction
                                         Command="{Binding SelectionChangedCommand}"
                                         CommandParameter="{Binding ElementName=logicList, Path=SelectedItem}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ListBox>
                </Expander>-->
                <TextBox
                    x:Name="SearchKey"
                    Width="206"
                    Height="34"
                    Margin="18,16,48,0"
                    Padding="5,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    VerticalContentAlignment="Center"
                    ap:ControlAttachProperty.CornerRadius="17"
                    Background="White"
                    BorderBrush="#FF971E"
                    BorderThickness="1"
                    FontSize="13"
                    Foreground="#0C0F1B"
                    GotFocus="SearchKey_GotFocus"
                    LostFocus="SearchKey_LostFocus"
                    MaxLength="166"
                    Style="{StaticResource ClearButtonTextBox}"
                    Text="{Binding Path=Filter, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    Visibility="{Binding ElementName=CancelBtn, Path=Visibility}">
                    <!--<i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction
                                         Command="{Binding TextChangedCommand}"
                                         CommandParameter="{Binding ElementName=SearchKey, Path=Text}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->
                </TextBox>
                <Button
                    x:Name="CancelBtn"
                    Width="28"
                    Height="18"
                    Margin="0,24,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CancelBtn_Click"
                    Content="{DynamicResource XMessageBox.xaml_QuXiao}"
                    Cursor="Hand"
                    FontSize="13"
                    Foreground="#FF8900"
                    Style="{StaticResource TextButtonStyle}"
                    Visibility="Collapsed" />
                <TextBlock
                    Margin="16,66,0,0"
                    Foreground="#505962"
                    Text="{DynamicResource ActionPopupWindow.xaml_SouSuoJianYi}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource TextToVisiblityConverter}">
                            <Binding ElementName="SearchKey" Path="Text" />
                            <Binding ElementName="SearchKey" Path="Visibility" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <ListBox
                    x:Name="recordList"
                    MaxWidth="270"
                    Margin="16,92,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="99"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource HistoryRecordListItemStyle}"
                    ItemsSource="{Binding HistoryRecordCollection}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Visibility>
                        <MultiBinding Converter="{StaticResource TextToVisiblityConverter}">
                            <Binding ElementName="SearchKey" Path="Text" />
                            <Binding ElementName="SearchKey" Path="Visibility" />
                        </MultiBinding>
                    </ListBox.Visibility>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <mvvm:ExInvokeCommandAction Command="{Binding RecordSelectionChangedCommand}" CommandParameter="{Binding ElementName=recordList, Path=SelectedItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
                <ListBox
                    x:Name="resultList"
                    Width="240"
                    Height="auto"
                    MaxHeight="200"
                    Margin="16,60,0,15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ComponentCollectionView}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource ComponentListStyle}"
                    Visibility="{Binding ElementName=CancelBtn, Path=Visibility}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <mvvm:ExInvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding ElementName=resultList, Path=SelectedItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
