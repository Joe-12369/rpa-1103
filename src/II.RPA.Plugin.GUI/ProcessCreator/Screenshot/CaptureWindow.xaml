<Window
    x:Class="II.RPA.Plugin.GUI.ProcessCreator.Screenshot.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.AttachProperty"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Screenshot"
    xmlns:uc="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    Title="{DynamicResource CaptureWindow.xaml_JieTuMoShi}"
    AllowsTransparency="True"
    Cursor="Cross"
    FontFamily="Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif,Segoe UI"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    MouseLeftButtonUp="Window_MouseLeftButtonUp"
    MouseMove="Window_MouseMove"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/ColorDictionary.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/SvgDictionary.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Controls/TFButton.xaml" />
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.Plugin.GUI;Component/ProcessCreator/Theme/StyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MoveThumb" TargetType="{x:Type local:ZoomThumb}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:ZoomThumb}">
                            <Rectangle
                                Fill="Transparent"
                                IsHitTestVisible="True"
                                SnapsToDevicePixels="True"
                                Stroke="#457AFF"
                                StrokeThickness="2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  拉伸滑块  -->
            <Style x:Key="ZoomThumb" TargetType="{x:Type local:ZoomThumb}">
                <Setter Property="Visibility" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainImage}}, Path=ZoomThumbVisibility}" />
                <Setter Property="Margin" Value="-6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:ZoomThumb}">
                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="White"
                                Stroke="#457AFF"
                                StrokeThickness="2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  截图区域  -->
            <Style TargetType="{x:Type local:MainImage}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:MainImage}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <local:ZoomThumb
                                    Grid.RowSpan="3"
                                    Grid.ColumnSpan="3"
                                    Cursor="{Binding RelativeSource={RelativeSource AncestorType=local:MainImage}, Path=MoveCursor}"
                                    Direction="Move"
                                    Style="{StaticResource MoveThumb}" />
                                <local:ZoomThumb
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Cursor="SizeNWSE"
                                    Direction="LeftTop"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Cursor="SizeWE"
                                    Direction="LeftMiddle"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Cursor="SizeNESW"
                                    Direction="LeftBottom"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Cursor="SizeNS"
                                    Direction="MiddleTop"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Cursor="SizeNS"
                                    Direction="MiddleBottom"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Cursor="SizeNESW"
                                    Direction="RightTop"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Cursor="SizeWE"
                                    Direction="RightMiddle"
                                    Style="{StaticResource ZoomThumb}" />
                                <local:ZoomThumb
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Cursor="SizeNWSE"
                                    Direction="RightBottom"
                                    Style="{StaticResource ZoomThumb}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type local:ImageActionBar}">
                <Setter Property="Width" Value="600" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Background" Value="{StaticResource StackPanelColor}" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Self}, Path=CanvasLeft}" />
                <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Self}, Path=CanvasTop}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:ImageActionBar}">
                            <Border
                                x:Name="mainBorder"
                                Height="64"
                                Margin="5"
                                Background="#DA0C0F1B"
                                BorderThickness="0"
                                CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        ShadowDepth="2"
                                        Color="{StaticResource DarkBorderColor}" />
                                </Border.Effect>
                                <Grid>
                                    <Menu
                                        x:Name="menu"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        ItemContainerStyleSelector="{StaticResource MenuItemStyleSelector}"
                                        ItemTemplateSelector="{StaticResource MenuItemTemplateSelector}"
                                        ItemsSource="{Binding DataContext.ActionCollection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Style="{StaticResource ScreenShotMenu}"
                                        Visibility="{TemplateBinding SaveButtonVisibility}">
                                        <Menu.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </Menu.ItemsPanel>
                                    </Menu>
                                    <uc:TFButton
                                        Width="58"
                                        Height="28"
                                        Margin="0,10,5,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#FF8900"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="save"
                                        Content="{DynamicResource CaptureWindow.xaml_BaoCun}"
                                        CornerRadius="4"
                                        Foreground="#FFFFFF"
                                        MouseOverBackground="#FF9810"
                                        Style="{StaticResource TFButton_Base}"
                                        Visibility="{TemplateBinding SaveButtonVisibility}">
                                        <uc:TFButton.ToolTip>
                                            <ToolTip Content="{DynamicResource CaptureWindow.xaml_BaoCunDaoYuanSuKuBingTianJia}" />
                                        </uc:TFButton.ToolTip>
                                    </uc:TFButton>
                                    <uc:TFButton
                                        Width="58"
                                        Height="28"
                                        Margin="0,10,5,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#FF8900"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="confirm"
                                        Content="{DynamicResource ConfigSetWnd.xaml_QueRen}"
                                        CornerRadius="4"
                                        Foreground="#FFFFFF"
                                        MouseOverBackground="#FF9810"
                                        Style="{StaticResource TFButton_Base}"
                                        Visibility="{TemplateBinding ConfirmButtonVisibility}">
                                        <uc:TFButton.ToolTip>
                                            <ToolTip Content="{DynamicResource CaptureWindow.xaml_QueDingJieTu}" />
                                        </uc:TFButton.ToolTip>
                                    </uc:TFButton>
                                    <uc:TFButton
                                        x:Name="PART_CLOSE"
                                        Width="22"
                                        Height="22"
                                        Margin="-7"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="White"
                                        Click="PART_CLOSE_Click"
                                        Cursor="Hand"
                                        FIconMargin="0"
                                        Foreground="White"
                                        IsTabStop="False"
                                        Style="{StaticResource TFButton_CornerCross}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_CLOSE" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border
                Margin="0"
                Padding="0"
                Background="{TemplateBinding Background}">
                <ContentControl Content="{TemplateBinding Content}" />
            </Border>
        </ControlTemplate>
    </Window.Template>
    <Grid>
        <Canvas
            x:Name="MainCanvas"
            Margin="0,0"
            Background="Transparent">
            <!--  遮罩  -->
            <Canvas
                x:Name="MaskLeft"
                Canvas.Left="0"
                Canvas.Top="0"
                Width="{Binding MaskLeftWidth}"
                Background="Black"
                Opacity="0.5" />
            <Canvas
                x:Name="MaskRight"
                Canvas.Top="0"
                Canvas.Right="0"
                Width="{Binding MaskRightWidth}"
                Background="Black"
                Opacity="0.5" />
            <Canvas
                x:Name="MaskTop"
                Canvas.Left="{Binding ElementName=MaskLeft, Path=Width}"
                Canvas.Top="0"
                Width="{Binding MaskTopWidth}"
                Height="{Binding MaskTopHeight}"
                Background="Black"
                Opacity="0.5" />
            <Canvas
                x:Name="MaskBottom"
                Canvas.Left="{Binding ElementName=MaskLeft, Path=Width}"
                Canvas.Bottom="0"
                Width="{Binding ElementName=MaskTop, Path=Width}"
                Height="{Binding MaskBottomHeight}"
                Background="Black"
                Opacity="0.5" />
            <Border
                x:Name="LocationBorder"
                Canvas.Left="{Binding LocationBorderLeft}"
                Canvas.Top="{Binding LocationBorderTop}"
                Width="138"
                Height="34"
                Background="#DD0C0F1B"
                CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="14"
                        Height="14"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Canvas Width="1024" Height="1024">
                            <Path Fill="#FFFFFFFF">
                                <Path.Data>
                                    <PathGeometry Figures="M36.571429 767.195429h950.857142v73.142857H36.571429z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <Path Fill="#FFFFFFFF">
                                <Path.Data>
                                    <PathGeometry Figures="M255.049143 36.571429v950.857142h-73.142857V36.571429z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <Path Fill="#FFFF971E">
                                <Path.Data>
                                    <PathGeometry Figures="M607.085714 123.538286c100.937143 0 182.857143 66.998857 182.857143 178.249143 0 74.166857-60.928 172.324571-182.857143 294.546285-121.929143-122.148571-182.857143-220.379429-182.857143-294.546285 0-111.250286 81.92-178.249143 182.857143-178.249143z m0 109.714285a73.142857 73.142857 0 1 0 0 146.285715 73.142857 73.142857 0 0 0 0-146.285715z" FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        x:Name="Show_Location"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="White"
                        Text="{DynamicResource CaptureWindow.xaml_ZuoBiao}"
                        TextAlignment="Left">
                        (<Run Text="{Binding MousePointX}" />
                        ,<Run Text="{Binding MousePointY}" />
                        )</TextBlock>
                </StackPanel>
            </Border>
            <Border
                x:Name="SizeRGB"
                Canvas.Left="{Binding ShowSizeLeft}"
                Canvas.Top="{Binding ShowSizeTop}"
                Background="#DD0C0F1B"
                CornerRadius="3">
                <TextBlock
                    x:Name="Show_Size"
                    Margin="10,7,10,7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontSize="13"
                    Foreground="White"
                    Text="{Binding ShowSize}"
                    TextAlignment="Left"
                    Visibility="Collapsed" />
            </Border>

            <local:MainImage x:Name="MainImage" />
            <local:ImageActionBar x:Name="ImageActionBar" />
        </Canvas>
    </Grid>
</Window>
