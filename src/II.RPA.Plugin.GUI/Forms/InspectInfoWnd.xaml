<Window x:Class="II.RPA.Plugin.GUI.InspectInfoWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.GUI"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        SizeToContent ="Height"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        Width="284px"
        Closing="Window_Closing"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        Left="4" Top="4"
        Loaded="Window_Loaded" FontFamily="Microsoft YaHei,Segoe UI" Padding="0 0 0 0" ShowInTaskbar="False" 
        >
    <!--xmlns:gif="http://wpfanimatedgif.codeplex.com"-->
    <!--<Window.Background>
        <SolidColorBrush Opacity="0.5" Color="Black"></SolidColorBrush>
    </Window.Background>-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/II.RPA.WinAutomation.CommonUtility;component/XamlResource/GlobalLangResource.xaml"/>
                <ResourceDictionary Source="Pack://application:,,,/II.RPA.WinAutomation.CommonUtility;component/XamlResource/GlobalLangResource_CN.xaml"/>
                <ResourceDictionary Source="/II.RPA.WinAutomation.CommonUtility;component/XamlResource/GlobalLangResource_EN.xaml"/>
                <ResourceDictionary Source="/II.RPA.WinAutomation.CommonUtility;component/XamlResource/GlobalLangResource_JP.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="xTextBlockStyleTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#C6ECEEF2"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei,Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

            </Style>
            <Style x:Key="xTextBlockStyleGray" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#ECEEF2"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei,Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style x:Key="xTextBlockStyleLight" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei,Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Block.TextAlignment" Value="Center"/>
                <Setter Property="FontStretch" Value="SemiExpanded"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style x:Key="xTextBlockCaptureMode" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFF"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei,Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

            </Style>
            <Style x:Key="xTextBlockCaptureModeLight" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#000"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei,Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style x:Name="s_xBorderBg" x:Key="xBorderBg" TargetType="Border">
                <Setter Property="Background" Value="#fff"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#F0161923" CornerRadius="4">
        <StackPanel Orientation="Vertical" Margin="26 10 0 10" Height="auto" >
            <StackPanel Orientation="Horizontal" Height="28">
                <TextBlock Text="{DynamicResource InspectInfoWnd.xaml_ShuBiaoWeiZhi}" Style="{StaticResource xTextBlockStyleTitle}"   />
                <TextBlock Text="X,Y" Style="{StaticResource xTextBlockStyleGray}" Margin="54 0 0 0" />
                <TextBlock Text="(0,0)" x:Name="tb_Position" Style="{StaticResource xTextBlockStyleGray}" Padding="0" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="26">
                <TextBlock Text="{DynamicResource InspectInfoWnd.xaml_JieMianLeiXing}"  Style="{StaticResource xTextBlockStyleTitle}" />
                <TextBlock x:Name="tb_WindowType" Style="{StaticResource xTextBlockStyleGray}" Text="Window" Margin="54 0 0 0"   />
            </StackPanel>
            
            <!--<StackPanel Orientation="Horizontal" Height="28">
                <TextBlock Text="拾取方式"  Style="{StaticResource xTextBlockStyleTitle}"   />
                <TextBlock x:Name="tb_curCaptureName" Style="{StaticResource xTextBlockStyleGray}" Text="智能拾取" Margin="54 0 0 0" />
            </StackPanel>-->
            
            <StackPanel  x:Name="rect_refreshLine"  Visibility="Visible"  Orientation="Horizontal" Height="15">
                <Rectangle Fill="#1AECEEF2" VerticalAlignment="Center" Height="1" Width="233" Margin="0,7,26,7" />
            </StackPanel>
            <StackPanel x:Name="sp_refreshPanle" Orientation="Horizontal" Height="28">
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Padding="0 1 0 0">
                    <TextBlock Text="F4" Style="{StaticResource xTextBlockStyleLight}" Height="16" Width="23" />
                </Border>
                <TextBlock Text="{DynamicResource DataCollectWnd.xaml_ShuaXin}" Style="{StaticResource xTextBlockStyleGray}" Margin="74,0,0,0" />
            </StackPanel>
            <!--<StackPanel x:Name="sp_switchPanle" Orientation="Horizontal" Height="27" >
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" >
                    <TextBlock Text="F2" Style="{StaticResource xTextBlockStyleLight}"  Height="17" Width="23" />
                </Border>
                <TextBlock Text="切换" Style="{StaticResource xTextBlockStyleTitle}" FontSize="12" Block.TextAlignment="Center"  Height="17" Width="32" Margin="2 0 0 0"  />
                <Border CornerRadius="2" Height="17" Width="125" Margin="40 0 0 0" Panel.ZIndex="2" Background="#40FFFFFF">
                    <StackPanel Orientation="Horizontal"  Height="17" >
                        <Border x:Name="b_ineedCapture" CornerRadius="2"   Height="17" Padding="8 0 8 0" Panel.ZIndex="2">
                            <TextBlock x:Name="tb_ineedCapture" Text="智能" Style="{StaticResource xTextBlockCaptureMode}"  />
                        </Border>
                        <TextBlock x:Name="tb_line1" Text="|" Style="{StaticResource xTextBlockStyleGray}" FontSize="10px" Block.TextAlignment="Center"  />
                        <Border x:Name="b_CommonCapture" CornerRadius="2"  Height="17" Padding="8 0 8 0" Panel.ZIndex="2">
                            <TextBlock x:Name="tb_CommonCapture" Text="普通" Style="{StaticResource xTextBlockCaptureMode}" />
                        </Border>
                        --><!--<TextBlock  x:Name="tb_line2"  Text="|" Style="{StaticResource xTextBlockStyleGray}" FontSize="10px"  Block.TextAlignment="Center" />
                        <Border x:Name="b_FloatingCapute" CornerRadius="2"  Height="17" Padding="8 0 8 0" Panel.ZIndex="2">
                            <TextBlock x:Name="tb_FloatingCapute" Text="浮窗" Style="{StaticResource xTextBlockCaptureMode}" />
                        </Border>--><!--
                    </StackPanel>
                </Border>
            </StackPanel>-->
            <StackPanel Orientation="Horizontal"  Margin="0,0,0,1"  Height="26">
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Padding="0 1 0 0">
                    <TextBlock Text="Ctrl" Style="{StaticResource xTextBlockStyleLight}"   Height="16" Width="28" />
                </Border>
                <TextBlock Text="+" FontSize="10px" Foreground="White" FontStretch="SemiExpanded"  Block.TextAlignment="Center"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="9" Margin="2 6 0 6"  />
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Margin="2 0 0 0" Padding="0 1 0 0">
                    <TextBlock x:Name="tb_singleClick" Text="{DynamicResource InspectInfoWnd.xaml_DanJi}" Style="{StaticResource xTextBlockStyleLight}"   Height="16" Width="32"  />
                </Border>
                <TextBlock x:Name="txt_Status" Text="{DynamicResource InspectInfoWnd.xaml_ShiQuYuanSu}" Style="{StaticResource xTextBlockStyleGray}" Margin="29,0,0,1" />
            </StackPanel>
            <StackPanel x:Name="sp_shiftClick" Orientation="Horizontal"  Margin="0,0,0,1"  Height="26">
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Padding="0 1 0 0" >
                    <TextBlock Text="Shift" Style="{StaticResource xTextBlockStyleLight}"   Height="16" Width="28" />
                </Border>
                <TextBlock Text="+" FontSize="10px" Foreground="White" FontStretch="SemiExpanded"  Block.TextAlignment="Center"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="9" Margin="2 6 0 6"  />
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Margin="2 0 0 0"  Padding="0 1 0 0">
                    <TextBlock Text="{DynamicResource InspectInfoWnd.xaml_DanJi}" Style="{StaticResource xTextBlockStyleLight}"   Height="16" Width="32"  />
                </Border>
                <TextBlock Text="{DynamicResource InspectInfoWnd.xaml_ShiQuFuChuangYuanSu}" Style="{StaticResource xTextBlockStyleGray}" Margin="29,0,0,1" />
            </StackPanel>
            <StackPanel x:Name="java_alter" Visibility="Collapsed" Orientation="Horizontal" Height="28">
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Padding="0 1 0 0">
                    <TextBlock Text="F7" Style="{StaticResource xTextBlockStyleLight}" Height="16" Width="23" />
                </Border>
                <TextBlock x:Name="java_alter_text" Text="使用无插件模式" Style="{StaticResource xTextBlockStyleGray}" Margin="74,0,0,0" />
            </StackPanel>
            <StackPanel  x:Name="rect_EscTopLine"  Visibility="Visible"  Orientation="Horizontal" Height="15">
                <Rectangle Fill="#1AECEEF2" VerticalAlignment="Center" Height="1" Width="233" Margin="0,7,26,7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="28" Margin="0,0,0,0">
                <Border Background="#ff8910" CornerRadius="2"  Height="17" Width="32" Padding="0 1 0 0" >
                    <TextBlock Text="ESC" Style="{StaticResource xTextBlockStyleLight}" Width="30" Height="16" />
                </Border>
                <TextBlock Text="{DynamicResource InspectInfoWnd.xaml_TuiChu}" Style="{StaticResource xTextBlockStyleGray}" Margin="74,0,0,0" />
            </StackPanel>
            <StackPanel  x:Name="rect_loadingLine"  Visibility="Collapsed"  Orientation="Horizontal" Height="15">
                <Rectangle Fill="#1AECEEF2" VerticalAlignment="Center" Height="1" Width="233" Margin="0,7,26,7" />
            </StackPanel>
            <StackPanel x:Name="sp_loading" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="29" Margin="0 0 34 0" >
                <!--<Image x:Name="loadingImg" RenderOptions.BitmapScalingMode="HighQuality"  UseLayoutRounding="True" SnapsToDevicePixels="True" Height="28"/>-->
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource InspectInfoWnd.xaml_ZhiNengJianCeZhong}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13px"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>