<Window x:Class="II.RPA.Plugin.GUI.CaptureScreenWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.GUI"
        mc:Ignorable="d"
        Title="CaptureScreenWnd" 
        AllowsTransparency="True"
        WindowStyle="None"
        Background="#01000000"
        Opacity="0.99"
           BorderThickness="0"
        Topmost="True"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        MouseMove="CaptureWindow_MouseMove"
        MouseDoubleClick="CaptureWindow_MouseDoubleClick"
        MouseDown="CaptureWindow_MouseDown"
        MouseUp="CaptureWindow_MouseUp"
       >
    <!--Background="#01000000"-->
    <Canvas x:Name="CaptureCanvas" IsHitTestVisible="False">
        <Line x:Name="xCrossLine" StrokeThickness="2" Visibility="Hidden"></Line>
        <Line x:Name="yCrossLine" StrokeThickness="2"  Visibility="Hidden"></Line>
        <Button x:Name="btn_ok" Panel.ZIndex="99" Content="{DynamicResource CaptureCVForOcrTableWnd.xaml_QueDing}" Padding="5 3 5 3" Background="#F8F8FF" Click="AddOkBtn_Click" Foreground="#000000" Visibility="Hidden" Width="60" Height="25"></Button>
        <DockPanel x:Name="dockPanel"  Visibility="Hidden">
            <Rectangle x:Name="lightRect_Left" Width="10" Height="auto" Fill="#2E000000" DockPanel.Dock="Left" ></Rectangle>
            <Rectangle x:Name="lightRect_Top" Height="10" Fill="#2E000000" DockPanel.Dock="Top" ></Rectangle>
            <Rectangle x:Name="lightRect_Right" Width="10" Fill="#2E000000" DockPanel.Dock="Right"></Rectangle>
            <Rectangle x:Name="lightRect_Bottom" Height="10" Fill="#2E000000" DockPanel.Dock="Bottom" ></Rectangle>
            <Rectangle x:Name="lightRect" Fill="#00000000"></Rectangle>
        </DockPanel>
    </Canvas>
    
</Window>
