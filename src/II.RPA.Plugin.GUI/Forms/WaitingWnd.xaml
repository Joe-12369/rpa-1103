<Window x:Class="II.RPA.Plugin.GUI.WaitingWnd"
              xmlns:Fluent="clr-namespace:Fluent;assembly=Fluent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:II.RPA"
             mc:Ignorable="d" 
             Height="50" Width="50" BorderThickness="0" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="IIDefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush Color="White"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="4"  Width="50" Height="50" Grid.Column="0" >
            <MediaElement  Source="./loading.gif" x:Name="loading"  Width="36" Height="36"/>
        </Border>
    </Grid>
</Window>
