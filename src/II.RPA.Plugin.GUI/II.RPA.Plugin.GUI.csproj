  <!-- Target 鏇夸唬 PostBuildEvent锛欳opy 澶辫触鍗崇敓鎴愬け璐ワ紱涓嶅啀閮ㄧ讲 plugin_ja-JP.json -->
  <Target Name="DeployGUIPlugin" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_PluginName>Element</_PluginName>
      <_RuntimePluginDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir)" />
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_MainOutput Include="$(TargetDir)$(TargetName).*" />
      <_RuntimeDeps Include="$(TargetDir)Fluent.*" />
      <_RuntimeDeps Include="$(TargetDir)SuperSocket.*" />
      <_RuntimeDeps Include="$(TargetDir)FlaUI.*" />
      <_RuntimeDeps Include="$(TargetDir)Interop.UIAutomationClient.*" />
      <_RuntimeDeps Include="$(TargetDir)WpfAnimatedGif.*" />
      <_RuntimeDeps Include="$(TargetDir)AForge.*" />
      <_RuntimeDeps Include="$(TargetDir)HIK.Toolkit.WPF.CustomControls.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainOutput)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_RuntimeDeps)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)aero_working.ani" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)PinYinConverterCore.dll" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
  </Target>
