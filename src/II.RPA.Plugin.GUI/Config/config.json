{
  "fileName": "II.RPA.Plugin.GUI.dll",
  "remotePort": 61619,
  // CV切换时间间隔
  "CVElementSwitchInterval": 1000,
  // 应用界面相似度(0~1)
  "AppFaceProximity": 0.95,
  // 应用界面相似度检测间隔时间
  "AppFaceProximityMonitorInterval": 500,
  //元素重叠百分比
  "IntersectRatio": 0.5,
  // 启用远程拾取
  "EnableRemoteCapture": false,
  // 数据采集-翻页按钮cssSelector模板
  "DataCollectionTurnPageButtonCssSelectorList": [],
