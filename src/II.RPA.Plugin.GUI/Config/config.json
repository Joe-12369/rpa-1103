  "ScrollVerticalDelay": 2000,
  // 数据采集-页面垂直滚动后  延迟拾取时间（毫秒）【V2版本使用 v>=690】
  "ScrollVerticalDelayV2": 1000,
  //匹配元素后操作的默认超时时间（毫秒）
  "OperationTimeout": 20000,
  //extension 使用Java插件，agent: 使用Java代理
  "JavaMode": "agent",
  // 初次拾取时，根据Win32窗口类名强制使用UIA2；支持结尾*前缀匹配
  "UIA2WindowClasses": [ "SunAwt*", "YonyouUWnd" ],
  "ClientProcessNames": [ "实在设计器" ],
