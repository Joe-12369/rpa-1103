<Window x:Class="II.RPA.Plugin.GUI.HighLight.HighLightAgentWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.GUI.HighLight"
        WindowState="Normal"
        mc:Ignorable="d"
     
         WindowStyle="None"  AllowsTransparency="True"
        Background="Transparent"
        Name="HighlightBorder"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        AutomationProperties.AutomationId="HighlightBorder"
        AutomationProperties.Name="HighlightBorder"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="HighlightBorder_Deactivated"
        SnapsToDevicePixels="True"
        Loaded="HighlightBorder_Loaded">
    <!--SnapsToDevicePixels="True"-->
    <!--TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType" 
        TextOptions.TextHintingMode="Fixed"-->
    <Window.Resources>
        <SolidColorBrush x:Key="NativeBorderColor" Color="#0085FF"/>
        <SolidColorBrush  x:Name="NativeBorderColor_Blue" x:Key="NativeBorderColor_Blue" Color="#0085FF"/>
        <SolidColorBrush x:Key="NativeSubColor" Color="White"/>
        <FontFamily x:Key="IconFont">/II.RPA.Plugin.GUI;component/Styles/FactoryFont/#iconfont</FontFamily>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HLTagRect" Visibility="{Binding TagPanelVisibility}" Grid.Row="{Binding TagRowID}" HorizontalAlignment="Left" Background="Transparent" Margin="0">
            <Grid Height="26">
                <!--<Grid Height="0">-->
                <Border BorderThickness="2" CornerRadius="2" BorderBrush="{StaticResource NativeSubColor}"/>
                <Border BorderThickness="0" Margin="1" CornerRadius="2" Background="{StaticResource NativeBorderColor}" BorderBrush="{StaticResource NativeBorderColor}"/>

                <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0">
                    <TextBlock Name="PART_IconText" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource NativeSubColor}" Text="{Binding TagIconCode}" FontSize="{Binding TagIconSize}" FontFamily="{StaticResource IconFont}"/>
                    <!--FontSize="{TemplateBinding Size}" FontFamily="{TemplateBinding FontFamily}"-->

                    <TextBlock Text="{Binding TagContent}" Foreground="{StaticResource NativeSubColor}" VerticalAlignment="Center" Margin="5,0,10,2" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="{Binding BorderRowID}" Name="HLBorderRect" HorizontalAlignment="Left" BorderThickness="0" Margin="0,0,0,0" Width="{Binding BorderWidth}" Height="{Binding BorderHeight}">
            <Grid ClipToBounds="True">
                <Border SnapsToDevicePixels="True" BorderThickness="1" CornerRadius="5" BorderBrush="{StaticResource NativeSubColor}" Margin="0"/>
                <Border SnapsToDevicePixels="True" BorderThickness="3" CornerRadius="3"  BorderBrush="{StaticResource NativeBorderColor}" Margin="1"/>
                <Border SnapsToDevicePixels="True" x:Name="LineScan" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Hidden" Margin="1" CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#150EC2FF" Offset="0.5"/>
                            <GradientStop Color="#651ADEFF " Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="InnerPanel2" Background="{Binding BorderBackground}" Opacity="0.1"/>
            </Grid>
        </Border>

        <Border x:Name="HLToolsRect" Height="40" Visibility="{Binding ToolPanelVisibility}"  Grid.Row="{Binding ToolsRowID}" IsHitTestVisible="True" HorizontalAlignment="Right" Background="#FFFFFF" Margin="{Binding ToolsMargin}" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="8">
            <Grid Height="38" Width="224">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="SearchParent_Control" Width="28" Height="28"  MouseLeftButtonDown="SearchParentElement_Click" IsHitTestVisible="True" CornerRadius="5">
                        <Path x:Name="SearchParent_Icon"  Width="18" Height="18" Stretch="Fill" Fill="#161923"
                        Data="M128 384V256q0-53.024 37.504-90.496Q202.976 128 256 128h128a32 32 0 0 1 0 64H256q-26.496 0-45.248 18.752T192 256v128a32 32 0 0 1-64 0z m768 0V256q0-53.024-37.504-90.496Q821.024 128 768 128h-128a32 32 0 1 0 0 64h128q26.496 0 45.248 18.752T832 256v128a32 32 0 1 0 64 0zM128 640v128q0 53.024 37.504 90.496Q202.976 896 256 896h128a32 32 0 1 0 0-64H256q-26.496 0-45.248-18.752T192 768v-128a32 32 0 1 0-64 0z m768 0v128q0 53.024-37.504 90.496Q821.024 896 768 896h-128a32 32 0 1 1 0-64h128q26.496 0 45.248-18.752T832 768v-128a32 32 0 1 1 64 0z">
                        </Path>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3E6ED"></Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="Background" Value="Transparent"></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="SearchChild_Control" Width="28" Height="28" Margin="6,0,8,0"  MouseLeftButtonDown="SearchChildElement_Click"  IsHitTestVisible="True"  CornerRadius="5">
                        <Path x:Name="SearchChild_Icon" Width="18" Height="18" Stretch="Fill" Fill="#161923"
                         Data="M416 160v128q0 53.024-37.504 90.496Q341.024 416 288 416H160a32 32 0 1 1 0-64h128q26.496 0 45.248-18.752T352 288V160a32 32 0 0 1 64 0z m0 704v-128q0-53.024-37.504-90.496Q341.024 608 288 608H160a32 32 0 1 0 0 64h128q26.496 0 45.248 18.752T352 736v128a32 32 0 1 0 64 0z m192-704v128q0 53.024 37.504 90.496Q682.976 416 736 416h128a32 32 0 1 0 0-64h-128q-26.496 0-45.248-18.752T672 288V160a32 32 0 1 0-64 0z m0 704v-128q0-53.024 37.504-90.496Q682.976 608 736 608h128a32 32 0 1 1 0 64h-128q-26.496 0-45.248 18.752T672 736v128a32 32 0 1 1-64 0z"
                          />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3E6ED"></Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="Background" Value="Transparent"></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Width="64" Height="28" Margin="0,0,8,0"   MouseLeftButtonDown="CancelCaptureElement_Click"  IsHitTestVisible="True" CornerRadius="5">
                        <TextBlock Text="取消" Foreground="#4A4B4E" TextAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3E6ED"></Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="Background" Value="#EDEFF3"></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Width="64" Height="28" Margin="0,0,10,0"  MouseLeftButtonDown="ConfirmCaptureElement_Click"  IsHitTestVisible="True" CornerRadius="5">
                        <TextBlock Text="确定" Foreground="#FFFFFF" TextAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#339DFF"></Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="Background" Value="#0085FF"></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
