<Window
    x:Class="II.RPA.Plugin.GUI.Windows.WindowHighLightWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.DataCollection.V2.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="DataCollectHighLight"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="DataCollectHighLight"
    AutomationProperties.Name="DataCollectHighLight"
    Background="Transparent"
    Deactivated="DataCollectHighLightWnd_Deactivated"
    Loaded="DataCollectHighLightWnd_Loaded"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  SnapsToDevicePixels="True"  -->
    <!--
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="NativeTagBorderColor" Color="#F5000000" />
        <SolidColorBrush x:Key="NativeBorderColor" Color="#FE5402" />
        <SolidColorBrush x:Key="NativeSubColor" Color="#FFFFFFFF" />
        <FontFamily x:Key="IconFont">/II.RPA.Plugin.GUI;component/Styles/FactoryFont/#iconfont</FontFamily>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HLTagRect"
            Grid.Row="{Binding TagRowID}"
            Margin="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            Visibility="{Binding TagPanelVisibility}">
            <Grid Height="26">
                <!--<Grid Height="0">-->
                <Border
                    BorderBrush="{StaticResource NativeSubColor}"
                    BorderThickness="2"
                    CornerRadius="2" />
                <Border
                    Margin="1"
                    Background="{StaticResource NativeBorderColor}"
                    BorderBrush="{StaticResource NativeBorderColor}"
                    BorderThickness="0"
                    CornerRadius="2" />

                <StackPanel
                    Margin="0"
                    Background="Transparent"
                    Orientation="Horizontal">
                    <TextBlock
                        Name="PART_IconText"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="{Binding TagIconSize}"
                        Foreground="{StaticResource NativeSubColor}"
                        Text="{Binding TagIconCode}" />
                    <!--  FontSize="{TemplateBinding Size}" FontFamily="{TemplateBinding FontFamily}"  -->

                    <TextBlock
                        Margin="5,0,10,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NativeSubColor}"
                        Text="{Binding TagContent}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Name="HLBorderRect"
            Grid.Row="{Binding BorderRowID}"
            Width="{Binding BorderWidth}"
            Height="{Binding BorderHeight}"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            BorderThickness="0">
            <Grid ClipToBounds="True">
                <Border
                    Margin="0"
                    BorderBrush="{StaticResource NativeSubColor}"
                    BorderThickness="1"
                    CornerRadius="5"
                    SnapsToDevicePixels="True" />
                <Border
                    Margin="1"
                    BorderBrush="{StaticResource NativeBorderColor}"
                    BorderThickness="3"
                    CornerRadius="3"
                    SnapsToDevicePixels="True" />
                <Border
                    x:Name="LineScan"
                    Margin="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="1"
                    SnapsToDevicePixels="True"
                    Visibility="Hidden">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#150EC2FF" />
                            <GradientStop Offset="1" Color="#651ADEFF " />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border
                    x:Name="InnerPanel2"
                    Background="{Binding BorderBackground}"
                    Opacity="0.1" />
            </Grid>
        </Border>
    </Grid>
</Window>
