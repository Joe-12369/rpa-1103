<Window x:Class="II.RPA.Plugin.GUI.UIProviders.ScanAnimation.ScanAnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ScanAnimationWindow"
        WindowStyle="None"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="NativeBorderColor" Color="#FE5402"/>
        <SolidColorBrush x:Key="NativeSubColor" Color="White"/>
        <FontFamily x:Key="IconFont">/II.RPA.Plugin.GUI;component/Styles/FactoryFont/#iconfont</FontFamily>
    </Window.Resources>

    <Grid x:Name="mainPanel">
        <Border SnapsToDevicePixels="True" BorderThickness="1" CornerRadius="5" BorderBrush="{StaticResource NativeSubColor}" Margin="0"/>
        <Border SnapsToDevicePixels="True" BorderThickness="3" CornerRadius="3"  BorderBrush="{StaticResource NativeBorderColor}" Margin="1"/>
    </Grid>
</Window>
