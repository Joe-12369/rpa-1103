            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IconType" Value="DONE">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="1024" Height="1024">
                                        <Ellipse
                                            Width="1024"
                                            Height="1024"
                                            Fill="White"
                                            Stroke="Transparent"
                                            StrokeThickness="172" />
                                        <Path Fill="#00B856">
                                            <Path.Data>
                                                <PathGeometry Figures="M512 85.333333C277.333333 85.333333 85.333333 277.333333 85.333333 512s192 426.666667 426.666667 426.666667 426.666667-192 426.666667-426.666667S746.666667 85.333333 512 85.333333z m243.2 328.533334l-298.666667 298.666666c-8.533333 8.533333-17.066667 12.8-29.866666 12.8s-21.333333-4.266667-29.866667-12.8l-128-128c-17.066667-17.066667-17.066667-42.666667 0-59.733333s42.666667-17.066667 59.733333 0l98.133334 98.133333 268.8-268.8c17.066667-17.066667 42.666667-17.066667 59.733333 0s17.066667 42.666667 0 59.733334z" FillRule="NonZero" />
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IconType" Value="PROCEED">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#E9ffffff"
                                    StrokeThickness="2" />
                                <shapes:Arc
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    EndAngle="180"
                                    RenderTransformOrigin="0.5,0.5"
                                    StartAngle="0"
                                    StrokeThickness="2">
                                    <shapes:Arc.Stroke>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                            <GradientStop Offset="0" Color="#0085FF" />
                                            <GradientStop Offset="0.5" Color="#990085FF" />
                                            <GradientStop Offset="1" Color="#000085FF" />
                                        </LinearGradientBrush>
                                    </shapes:Arc.Stroke>

                                    <UIElement.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </UIElement.RenderTransform>
                                    <FrameworkElement.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        To="360"
                                                        Duration="0:0:2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </FrameworkElement.Triggers>
                                </shapes:Arc>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IconType" Value="ERROR">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="1024" Height="1024">
