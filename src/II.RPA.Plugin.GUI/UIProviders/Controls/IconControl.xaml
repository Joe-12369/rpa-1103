                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>