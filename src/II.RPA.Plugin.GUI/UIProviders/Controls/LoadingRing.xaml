<UserControl
    x:Class="II.RPA.Plugin.GUI.UIProviders.Controls.LoadingRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.Plugin.GUI.UIProviders.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="clr-namespace:II.RPA.Plugin.GUI.ProcessCreator.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ProgressBarRingStyleSmall" TargetType="{x:Type ProgressBar}">
            <Setter Property="ProgressBar.Orientation" Value="Horizontal" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Ellipse
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stroke="#E9ffffff"
                                StrokeThickness="2" />
                            <shapes:Arc
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                EndAngle="180"
                                RenderTransformOrigin="0.5,0.5"
                                StartAngle="0"
                                StrokeThickness="2">
                                <shapes:Arc.Stroke>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#0085FF" />
                                        <GradientStop Offset="0.5" Color="#990085FF" />
                                        <GradientStop Offset="1" Color="#000085FF" />
                                    </LinearGradientBrush>
                                </shapes:Arc.Stroke>

                                <UIElement.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </UIElement.RenderTransform>
                                <FrameworkElement.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    To="360"
                                                    Duration="0:0:2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </FrameworkElement.Triggers>
                            </shapes:Arc>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ProgressBar Style="{StaticResource ProgressBarRingStyleSmall}" />
    </Grid>
</UserControl>
