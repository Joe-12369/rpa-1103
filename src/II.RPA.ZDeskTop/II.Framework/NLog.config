<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <!--此部分中的所有目标将自动异步-->
    <target name="asyncFile" xsi:type="AsyncWrapper">
		<target name="common_log_file" xsi:type="File"
				  fileName="${specialfolder:folder=ApplicationData}/Z-Default/Logs/${shortdate}/dll_logs/Z-DeskTop.log"
				  layout="${longdate}-[${processid}]-[${processname}]-[${threadid}]-${level}-${message:exceptionSeparator=\r\n:withException=true}"
				  archiveFileName="${specialfolder:folder=ApplicationData}/Z-Default/Logs/archives/Z-DeskTop-{#####}.log"
				  archiveAboveSize="104857600"
				  archiveNumbering="Sequence"
				  concurrentWrites="true"
				  maxArchiveFiles="10"
				  maxArchiveDays="7"
				  keepFileOpen="false"
			      encoding="utf-8"/>
    </target>
    <target name="colorConsole" xsi:type="ColoredConsole" layout="[${date:format=HH\:mm\:ss}]:${message} ${exception:format=message}" />
	<target name="console" xsi:type="Console" layout="[${date:format=HH\:mm\:ss}]:${message} ${exception:format=message}" />
  </targets>
  <!--规则配置,final - 最终规则匹配后不处理任何规则-->
  <rules>
    <logger name="Microsoft.*" minlevel="Debug" writeTo="common_log_file" final="true" />
    <logger name="II.Framework*" minlevel="Debug" writeTo="common_log_file" />
    <logger name="II.RPA*" minlevel="Debug" writeTo="common_log_file" />
	<logger name="*"  writeTo="console"/>
  </rules>
</nlog>