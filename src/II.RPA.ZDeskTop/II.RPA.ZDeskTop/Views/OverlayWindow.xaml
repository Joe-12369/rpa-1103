<Window
    x:Class="II.RPA.ZDeskTop.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.ZDeskTop.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static res:i18n_Resource.OverlayWindow_6904439C}"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.Framework.Resource;assembly=II.Framework">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/II.RPA.ZDesktop;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border
            x:Name="mainBorder"
            Background="#80000000"
            BorderBrush="#0085FF"
            BorderThickness="1"
            CornerRadius="{Binding OverlayCornerRadius}"
            RenderOptions.EdgeMode="Unspecified"
            SnapsToDevicePixels="True" />
        <Button
            Width="32"
            Height="32"
            Margin="0,8,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding RestoreCommand}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#80000000" CornerRadius="6">
                        <Grid>
                            <Viewbox
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.485,0.229">
                                <Canvas
                                    Width="1024.0"
                                    Height="1024.0"
                                    UseLayoutRounding="False">
                                    <Canvas.Clip>
                                        <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                                    </Canvas.Clip>
                                    <Path
                                        Fill="#FFFFFF"
                                        Stroke="Green"
                                        StrokeThickness="0">
                                        <Path.Data>
                                            <PathGeometry Figures="M 384 85.3333 a 42.6667 42.6667 0 0 1 4.992 85.0347 L 384 170.667 H 230.997 l 218.539 218.496 a 42.6667 42.6667 0 1 1 -60.3733 60.3733 L 170.667 230.997 V 384 a 42.6667 42.6667 0 0 1 -37.6747 42.368 L 128 426.667 a 42.6667 42.6667 0 0 1 -42.368 -37.6747 L 85.3333 384 V 85.3333 h 298.667 z m 263.339 501.632 L 853.333 793.003 V 640 a 42.6667 42.6667 0 0 1 37.6747 -42.368 L 896 597.333 a 42.6667 42.6667 0 0 1 42.368 37.6747 L 938.667 640 v 298.667 h -298.667 a 42.6667 42.6667 0 0 1 -4.992 -85.0347 L 640 853.333 h 153.003 l -206.037 -205.995 a 42.6667 42.6667 0 0 1 60.3733 -60.3733 z" FillRule="Nonzero" />
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ToggleButton
            Width="122"
            Height="50"
            BorderBrush="#0085FF"
            BorderThickness="1"
            Command="{Binding PauseCommand}"
            CommandParameter="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=Self}}"
            FontSize="14"
            Foreground="White"
            IsChecked="{Binding IsPaused, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource ButtonLikeToggleButtonStyle}"
            Visibility="{Binding PauseButtonVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ToggleButton.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#000000" />
                    <GradientStop Offset="0.5" Color="#000000" />
                    <GradientStop Offset="1" Color="#000000" />
                </LinearGradientBrush>
            </ToggleButton.Background>
            <ToggleButton.Content>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PauseCircle" />
                    <TextBlock Margin="6,0,0,0" Text="{x:Static res:i18n_Resource.OverlayWindow_5A010A8}" />
                </StackPanel>
            </ToggleButton.Content>
            <materialDesign:ToggleButtonAssist.OnContent>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlayCircle" />
                    <TextBlock Margin="6,0,0,0" Text="{x:Static res:i18n_Resource.OverlayWindow_E7F8BEAA}" />
                </StackPanel>
            </materialDesign:ToggleButtonAssist.OnContent>
        </ToggleButton>
        <Grid
            Width="122"
            Height="50"
            Visibility="{Binding PausingVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <Border
                Margin="4"
                Background="#770085FF"
                CornerRadius="8">
                <Border.Effect>
                    <BlurEffect
                        KernelType="Box"
                        Radius="4"
                        RenderingBias="Quality" />
                </Border.Effect>
            </Border>
            <Border
                Margin="4"
                Background="#000000"
                BorderBrush="#0085FF"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Grid
                        Width="20"
                        Height="20"
                        RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="rotate" Angle="0" />
                        </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Canvas
                                Width="1024.0"
                                Height="1024.0"
                                UseLayoutRounding="False">
                                <Canvas.Clip>
                                    <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                                </Canvas.Clip>
                                <Path Fill="#ffffffff">
                                    <Path.Data>
                                        <PathGeometry Figures="M 512 64 c 247.424 0 448 200.576 448 448 c 0 98.56 -32 192.427 -90.0693 269.483 a 42.6667 42.6667 0 0 1 -68.1387 -51.3707 A 360.832 360.832 0 0 0 874.667 512 a 362.667 362.667 0 1 0 -362.667 362.667 a 42.6667 42.6667 0 0 1 0 85.3333 C 264.576 960 64 759.424 64 512 S 264.576 64 512 64 z" FillRule="Nonzero" />
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Control.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="rotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="360"
                                            Duration="0:0:3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="{x:Static res:i18n_Resource.OverlayWindow_14FBDD42}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
