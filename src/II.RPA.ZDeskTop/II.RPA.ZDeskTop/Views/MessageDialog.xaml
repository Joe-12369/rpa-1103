<Window
    x:Class="II.RPA.ZDeskTop.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.ZDeskTop.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title=""
    Width="500"
    Height="224"
    ShowActivated="True"
    ShowInTaskbar="True"
    WindowChrome.IsHitTestVisibleInChrome="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.Framework.Resource;assembly=II.Framework">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="1"
            NonClientFrameEdges="None"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <DockPanel
                    Grid.Row="0"
                    Background="#F2F5F7"
                    LastChildFill="True"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <TextBlock
                        Margin="15,0,5,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="15"
                        Foreground="#161923"
                        Text="{x:Static res:i18n_Resource.MessageDialog_565F96F}" />
                    <Button
                        Width="40"
                        Height="40"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Close_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Foreground="#94000000" Kind="Close" />
                    </Button>
                </DockPanel>
                <Border
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="White">
                    <ContentControl Margin="50,25,0,0" Content="{TemplateBinding Content}" />
                </Border>
                <Border
                    Grid.Row="2"
                    Width="90"
                    Height="35"
                    CornerRadius="4"
                    Margin="0,0,40,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#0085FF"
                    BorderThickness="0"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
                    <Button
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Close_Click"
                        Content="{x:Static res:i18n_Resource.MessageDialog_96547FDD}"
                        Foreground="White"
                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
                    </Button>
                </Border>


            </Grid>
        </ControlTemplate>
    </Window.Template>
</Window>
