    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="mainBorder"
            Grid.Row="1"
            Margin="-1"
            Background="{Binding ElementName=MainWindow, Path=Background}"
            BorderBrush="{Binding ElementName=MainWindow, Path=BorderBrush}"
            BorderThickness="{Binding ElementName=MainWindow, Path=BorderThickness}">
            <WindowsFormsHost
                x:Name="host"
                Margin="0,0,0,0"
                Padding="0">
                <axrdp:AxMsTscAxNotSafeForScripting x:Name="axRDP" />
            </WindowsFormsHost>
        </Border>
    </Grid>
</iiui:BaseIIWindow>
