<iiui:BaseIIWindow
    x:Class="II.RPA.ZDeskTop.ZDeskTopWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:axrdp="clr-namespace:AxMSTSCLib;assembly=AxInterop.MSTSCLib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:res="clr-namespace:II.Framework.Resource;assembly=II.Framework"
    xmlns:ii="clr-namespace:II.Framework;assembly=II.Framework"
    xmlns:iiui="clr-namespace:II.Framework.UI;assembly=II.Framework.UI"
    xmlns:local="clr-namespace:II.RPA.ZDeskTop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Name="MainWindow"
    Title="{Binding Path=AppName, Source={x:Static ii:AppMeta.Default}}"
    Icon="/Resources/z-decktop.ico"
    UseLayoutRounding="True"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <iiui:BaseIIWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/II.Framework.UI;component/Styles/II.Brushes.xaml" />
                <ResourceDictionary Source="pack://application:,,,/II.RPA.ZDesktop;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <iiui:BoolToVisibiliyConverter x:Key="BoolToVisibiliyConverter" />
            <iiui:BoolsToVisibiliyConverter x:Key="BoolsToVisibiliyConverter" />
            <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="{StaticResource TitleBarForegroundGrayBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Width="25"
                                Height="25"
                                Padding="0"
                                CornerRadius="5">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BackgroundColor" Color="#00000000" />
                                </Border.Background>
                                <Viewbox
                                    Width="16.7"
                                    Height="16.7"
                                    Stretch="Uniform">
                                    <Canvas
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="1024"
                                        Height="1024">
                                        <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color">
                                                <ColorAnimation To="{StaticResource ButtonMouseOverBackground}" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color">
                                                <ColorAnimation To="#00000000" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TitleBarContentButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Width="auto"
                                Height="25"
                                Padding="0"
                                CornerRadius="5">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BackgroundColor" Color="#44464E" />
                                </Border.Background>
                                <StackPanel Margin="9,0,9,0" Orientation="Horizontal">
                                    <Viewbox
                                        Width="16.7"
                                        Height="16.7"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stretch="Uniform">
                                        <Canvas
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Width="1024"
                                            Height="1024">
                                            <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" />
                                        </Canvas>
                                        <Viewbox.RenderTransform>
                                            <RotateTransform x:Name="rotate" Angle="0" />
                                        </Viewbox.RenderTransform>
                                    </Viewbox>
                                    <ContentPresenter
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHitTestVisible" Value="False">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="Rotate">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    RepeatBehavior="Forever"
                                                    Storyboard.TargetName="rotate"
                                                    Storyboard.TargetProperty="Angle"
                                                    To="360"
                                                    Duration="0:0:3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Rotate" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color">
                                                <ColorAnimation
                                                    From="#44464E"
                                                    To="{StaticResource ButtonMouseOverBackground}"
                                                    Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color">
                                                <ColorAnimation Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </iiui:BaseIIWindow.Resources>
    <iiui:BaseIIWindow.WindowCenterTitleBar>
        <iiui:WindowTitleBar>
            <StackPanel
                Margin="150,0,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding MiniOperationVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <StackPanel
                    Orientation="Horizontal"
                    Visibility="{Binding PauseOperationVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <Button
                        Command="{Binding PauseCommand}"
                        CommandParameter="{x:Static sys:Boolean.TrueString}"
                        Content="{x:Static res:i18n_Resource.ZDeskTopWindow_5A010A8}"
                        Cursor="Hand"
                        Style="{StaticResource TitleBarContentButtonStyle}"
                        ToolTip="{x:Static res:i18n_Resource.ZDeskTopWindow_5A010A8}">
