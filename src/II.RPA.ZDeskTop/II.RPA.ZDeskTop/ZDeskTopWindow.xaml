                            </MultiBinding>
                        </Button.Visibility>
                    </Button>
                    <Button
                        Command="{Binding PauseCommand}"
                        CommandParameter="{x:Static sys:Boolean.FalseString}"
                        Content="{x:Static res:i18n_Resource.ZDeskTopWindow_E7F8BEAA}"
                        Cursor="Hand"
                        Style="{StaticResource TitleBarContentButtonStyle}"
                        Visibility="{Binding IsPaused, ConverterParameter={x:Static sys:Boolean.TrueString}, Converter={StaticResource BoolToVisibiliyConverter}}">
