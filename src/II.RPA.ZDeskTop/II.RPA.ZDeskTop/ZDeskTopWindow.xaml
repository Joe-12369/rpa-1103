                            <PathGeometry Figures="M 512 64 c 247.424 0 448 200.576 448 448 c 0 98.56 -32 192.427 -90.0693 269.483 a 42.6667 42.6667 0 0 1 -68.1387 -51.3707 A 360.832 360.832 0 0 0 874.667 512 a 362.667 362.667 0 1 0 -362.667 362.667 a 42.6667 42.6667 0 0 1 0 85.3333 C 264.576 960 64 759.424 64 512 S 264.576 64 512 64 z" FillRule="Nonzero" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
                <Button
                    Margin="6,0,0,0"
                    Command="{Binding SetMiniCommand}"
                    Content="{x:Static res:i18n_Resource.ZDeskTopWindow_11703F4D}"
                    Cursor="Hand"
                    Style="{StaticResource TitleBarContentButtonStyle}"
                    ToolTip="{x:Static res:i18n_Resource.ZDeskTopWindow_11703F4D}">
                    <Button.Tag>
                        <PathGeometry Figures="M 835.84 128 l -183.467 183.04 L 554.667 213.333 v 256 h 256 l -97.7067 -97.7067 L 896 188.16 z M 213.333 554.667 l 97.7067 97.7067 L 128 835.84 L 188.16 896 l 183.467 -183.04 L 469.333 810.667 v -256 z" FillRule="Nonzero" />
                    </Button.Tag>
                </Button>
            </StackPanel>
        </iiui:WindowTitleBar>
    </iiui:BaseIIWindow.WindowCenterTitleBar>
