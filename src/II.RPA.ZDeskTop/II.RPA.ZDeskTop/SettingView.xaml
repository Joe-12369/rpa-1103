<UserControl
    x:Class="II.RPA.ZDeskTop.SettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.ZDeskTop"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.Framework.Resource;Assemble=II.Framework">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="{x:Static res:i18n_Resource.SettingView_9AD34C6B}" />
            <TextBlock Text="{x:Static res:i18n_Resource.SettingView_ADB11681}" />
            <TextBox
                x:Name="UsernameTxt"
                Width="200"
                Height="50"
                materialDesign:HintAssist.FloatingScale="0.7"
                materialDesign:HintAssist.HelperTextFontSize="15"
                materialDesign:HintAssist.Hint="Tartget Endpoint"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:ValidationAssist.FontSize="18"
                materialDesign:ValidationAssist.OnlyShowOnFocus="True"
                materialDesign:ValidationAssist.PopupPlacement="Bottom"
                materialDesign:ValidationAssist.UsePopup="True"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
            <TextBox
                x:Name="PasswordTxt"
                Width="200"
                Height="50"
                materialDesign:HintAssist.Hint="Tartget Endpoint"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:ValidationAssist.FontSize="15"
                materialDesign:ValidationAssist.OnlyShowOnFocus="True"
                materialDesign:ValidationAssist.PopupPlacement="Bottom"
                materialDesign:ValidationAssist.UsePopup="True"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
        </StackPanel>
    </Grid>
</UserControl>
