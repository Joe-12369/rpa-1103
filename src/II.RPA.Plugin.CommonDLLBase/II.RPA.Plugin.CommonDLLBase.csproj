<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  
    <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>Library</OutputType>
    <RootNamespace>II.RPA.Plugin.CommonDLLBase</RootNamespace>
    <AssemblyName>II.RPA.Plugin.CommonDLLBase</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
<PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    
    <OutputType>Library</OutputType>
    
    <RootNamespace>II.RPA.Plugin.CommonDLLBase</RootNamespace>
    <AssemblyName>II.RPA.Plugin.CommonDLLBase</AssemblyName>
    
    
    <Deterministic>true</Deterministic>
    
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE;DEBUG;Trace</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE;DEBUG;Trace</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config\Configurations.cs" />
    <Compile Include="PluginPackage.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Utils\WebBrowserVerify.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\II.RPA.Logging\II.RPA.Logging.csproj" />
    <ProjectReference Include="..\II.RPA.Plugin.Abstractions\II.RPA.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\II.RPA.Plugin.Core\II.RPA.Plugin.Core.csproj" />
    <ProjectReference Include="..\II.RPA.Plugin.GUI.Commons\II.RPA.Plugin.GUI.Commons.csproj" />
    <ProjectReference Include="..\II.RPA.WebBrowser.Common\II.RPA.WebBrowser.Common.csproj" />
    <ProjectReference Include="..\II.RPA.WinAPI\II.RPA.WinAPI.csproj" />
    <ProjectReference Include="..\II.RPA.WinAutomation.CommonUtility\II.RPA.WinAutomation.CommonUtility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="Config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    
  </ItemGroup>
  
  <Target Name="DeployCommonDLLBasePlugin" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_PluginName>CommonDLLBase</_PluginName>
      <_RuntimePluginDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir)" />
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_MainOutput Include="$(TargetDir)$(TargetName).*" />
      <_RuntimeDeps Include="$(TargetDir)II.RPA.Plugin.GUI.Commons.*" />
      <_RuntimeDeps Include="$(TargetDir)II.RPA.WebBrowser.Common.*" />
      <_RuntimeDeps Include="$(TargetDir)II.RPA.WinAPI.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainOutput)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_RuntimeDeps)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <!-- Keep the loader root in sync as well.  A stale copy here can win
         assembly resolution before runtime\CommonDLLBase and silently bring
         back the pre-migration WebBrowser.Common binary. -->
    <Copy SourceFiles="$(TargetDir)II.RPA.WebBrowser.Common.dll;$(TargetDir)II.RPA.WebBrowser.Common.pdb"
          DestinationFolder="$(SolutionDir)..\bin\II.RPA.PluginLoader\"
          SkipUnchangedFiles="false"
          Condition="Exists('$(TargetDir)II.RPA.WebBrowser.Common.dll')" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    </ItemGroup>
</Project>




