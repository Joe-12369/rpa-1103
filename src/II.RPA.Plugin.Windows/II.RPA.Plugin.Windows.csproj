  <ItemGroup />
  <ItemGroup Condition="'$(_OwnerDrawArchitecture)' != ''">
    <!-- Owner-draw native bridges are prebuilt and versioned under libs, like the
         other third-party binaries. Their C++ sources live outside this repo. -->
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\MfcGdiAccBridge.$(_OwnerDrawArchitecture).dll" />
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\VclGridAccBridge.$(_OwnerDrawArchitecture).dll" />
    <!-- The x86 Delphi RTTI helper imports rtl160.bpl. Keep both siblings beside
         VclGridAccBridge so the injected process does not depend on global paths. -->
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\DelphiRttiBridge.dll" Condition="'$(Platform)' == 'x86'" />
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\rtl160.bpl" Condition="'$(Platform)' == 'x86'" />
    <_OwnerDrawPinnedDependency Include="$(MSBuildProjectDirectory)\..\libs\DelphiRttiBridge.dll"
                                Condition="'$(Platform)' == 'x86'">
      <ExpectedSha256>8685D085F47BDA465ACC635211B3375BBA0A35200AE24BCB10218AE6D0FA591F</ExpectedSha256>
    </_OwnerDrawPinnedDependency>
    <_OwnerDrawPinnedDependency Include="$(MSBuildProjectDirectory)\..\libs\rtl160.bpl"
                                Condition="'$(Platform)' == 'x86'">
      <ExpectedSha256>AD3622C8E2B743BFC33AED054920050650B3ECD707BA86166EF6922F51050092</ExpectedSha256>
    </_OwnerDrawPinnedDependency>
  </ItemGroup>
  <!-- A 64-bit controller can inject the 64-bit Bridges directly. For the
       explicitly supported x64-controller -> x86-PowerBuilder route, also
       publish the x86 PB Bridge and its small x86 injector broker from libs.
       VCL remains same-bitness and its x86 RTTI dependencies must not leak
       into a 64-bit product layout. -->
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\MfcGdiAccBridge.x86.dll" />
    <_OwnerDrawBridge Include="$(MSBuildProjectDirectory)\..\libs\OwnerDrawInjectorBroker.x86.exe" />
  </ItemGroup>
  <Target Name="ValidateOwnerDrawPinnedDependencies"
          BeforeTargets="DeployOwnerDrawBridges"
          Condition="'$(Platform)' == 'x86' and '$(DeployOwnerDraw)' != 'false'">
    <Error Condition="!Exists('%(_OwnerDrawPinnedDependency.Identity)')"
           Text="Pinned OwnerDraw dependency is missing: %(_OwnerDrawPinnedDependency.Identity)" />
    <GetFileHash Files="@(_OwnerDrawPinnedDependency)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_OwnerDrawPinnedDependencyHash" />
    </GetFileHash>
    <Error Condition="'%(_OwnerDrawPinnedDependencyHash.FileHash)' != '%(_OwnerDrawPinnedDependencyHash.ExpectedSha256)'"
           Text="Pinned OwnerDraw dependency hash mismatch: %(_OwnerDrawPinnedDependencyHash.Identity) expected=%(_OwnerDrawPinnedDependencyHash.ExpectedSha256) actual=%(_OwnerDrawPinnedDependencyHash.FileHash)" />
  </Target>
  <Target Name="DeployWindowsPlugin" AfterTargets="AfterBuild"
          Condition="'$(DeployWindowsPlugin)' != 'false'">
    <PropertyGroup>
      <_PluginName>GUIWindows</_PluginName>
      <_RuntimePluginDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir)" />
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="DeployOwnerDrawBridges"
          AfterTargets="DeployWindowsPlugin"
          Condition="'$(_OwnerDrawArchitecture)' != '' and '$(DeployOwnerDraw)' != 'false'">
    <PropertyGroup>
      <_OwnerDrawTargetDir>$(TargetDir)OwnerDraw\</_OwnerDrawTargetDir>
    </PropertyGroup>
    <Error Condition="!Exists('%(_OwnerDrawBridge.Identity)')"
           Text="OwnerDraw native dependency is missing: %(_OwnerDrawBridge.Identity)" />
    <RemoveDir Directories="$(_OwnerDrawTargetDir);$(_OwnerDrawRuntimeDir)" />
    <MakeDir Directories="$(_OwnerDrawTargetDir);$(_OwnerDrawRuntimeDir)" />
    <Copy SourceFiles="@(_OwnerDrawBridge)"
          DestinationFolder="$(_OwnerDrawTargetDir)"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_OwnerDrawBridge)"
          DestinationFolder="$(_OwnerDrawRuntimeDir)"
          SkipUnchangedFiles="false" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
