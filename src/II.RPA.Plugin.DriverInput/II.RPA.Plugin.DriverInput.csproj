    <Compile Include="Utils\DeviceChoiceHelper.cs" />
    <Compile Include="WinRing0\ControlKey.cs" />
    <Compile Include="WinRing0\EnumWindowsType.cs" />
    <Compile Include="WinRing0\PressKeyByWinRing0.cs" />
    <Compile Include="WinRing0\WinRing0.cs" />
    <Compile Include="WinRing0\WinRing0InputManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\II.RPA.Logging\II.RPA.Logging.csproj" />
    <ProjectReference Include="..\II.RPA.Plugin.Core\II.RPA.Plugin.Core.csproj" />
    <ProjectReference Include="..\II.RPA.WinAutomation.CommonUtility\II.RPA.WinAutomation.CommonUtility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="Config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    
    <None Include="WinRingDLL\WinRing0.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinRingDLL\WinRing0x64.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="WinRingDLL\WinRing0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinRingDLL\WinRing0x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="InterceptorDLL\interception.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <Target Name="DeployDriverInputPlugin" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_PluginName>DriverInput</_PluginName>
      <_RuntimePluginDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir)" />
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_MainOutput Include="$(TargetDir)$(TargetName).*" />
      <_Interceptor Include="$(TargetDir)InterceptorDLL\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainOutput)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_Interceptor)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    </ItemGroup>
</Project>




