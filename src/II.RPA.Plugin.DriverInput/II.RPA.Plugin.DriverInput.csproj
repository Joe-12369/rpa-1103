<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  
    <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>Library</OutputType>
    <RootNamespace>II.RPA.Plugin.DriverInput</RootNamespace>
    <AssemblyName>II.RPA.Plugin.DriverInput</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
<PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    
    <OutputType>Library</OutputType>
    
    <RootNamespace>II.RPA.Plugin.DriverInput</RootNamespace>
    <AssemblyName>II.RPA.Plugin.DriverInput</AssemblyName>
    
    
    <Deterministic>true</Deterministic>
    
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\$(MSBuildProjectName)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PluginPackage.cs" />
    <Compile Include="Config\Configurations.cs" />
    <Compile Include="HID\Drivers.cs" />
    <Compile Include="HID\HIDCtrl.cs" />
    <Compile Include="HID\HIDInputManager.cs" />
    <Compile Include="HID\HIDSendHelper.cs" />
    <Compile Include="HID\KeyboardUtils.cs" />
    <Compile Include="Interceptor\AiKeyboard.cs" />
    <Compile Include="Interceptor\Classes\DeviceData.cs" />
    <Compile Include="Interceptor\Classes\Enums.cs" />
    <Compile Include="Interceptor\Classes\Hook.cs" />
    <Compile Include="Interceptor\Classes\KeyStroke.cs" />
    <Compile Include="Interceptor\Classes\MouseStroke.cs" />
    <Compile Include="Interceptor\Classes\Stroke.cs" />
    <Compile Include="Interceptor\Classes\Win32Point.cs" />
    <Compile Include="Interceptor\DllWrapper.cs" />
    <Compile Include="Interceptor\InputInterceptor.cs" />
    <Compile Include="Interceptor\InterceptionMethods.cs" />
