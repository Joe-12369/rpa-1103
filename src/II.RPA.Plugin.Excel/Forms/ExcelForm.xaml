<Window x:Class="II.RPA.Plugin.Excel.Forms.ExcelForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:II.RPA.Plugin.Excel.Forms"
        Loaded="Window_Loaded"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar = "False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Title="{Binding Title}" Height="301" Width="454"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <Window.DataContext>
        <local:ExcelFormContext></local:ExcelFormContext>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="ImageBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush_ImageBorderHover}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContentCommonTextBlock" TargetType="TextBlock">
            <!--<Setter Property="FontFamily" Value="Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif,Segoe UI"/>-->
            <!--<Setter Property="FontFamily" Value="思源黑体 VF"/>-->
            <Setter Property="Foreground" Value="#505962"/>
            <Setter Property="FontSize" Value="13"/>
            <!--<Setter Property="FontWeight" Value="DemiBold"/>-->
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!--  关闭按钮  -->
        <PathGeometry x:Key="SVG_CloseWindow" Figures="M1.9,1.1L7,6.3l5.1-5.1C12.3,1,12.6,1,12.8,1.1l0.1,0.1c0.2,0.2,0.2,0.5,0,0.7l0,0L7.7,7   l5.1,5.1c0.2,0.2,0.2,0.5,0,0.7c-0.2,0.2-0.5,0.2-0.7,0L7,7.7l-5.1,5.1C1.7,13,1.4,13,1.2,12.9l-0.1-0.1c-0.2-0.2-0.2-0.5,0-0.7   l0,0L6.3,7L1.1,1.9C1,1.7,1,1.3,1.1,1.1S1.7,1,1.9,1.1z" />

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            GlassFrameThickness="-2"
            RenderOptions.EdgeMode="Aliased"
            ResizeBorderThickness="13" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border
            x:Name="GlobalBorder"
            Margin="12"
            Panel.ZIndex="-1"
            Background="White"
            BorderBrush="White"
            BorderThickness="0"
            CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="13"
                    ShadowDepth="0"
                    Color="LightGray" />
            </Border.Effect>
        </Border>

        <Border
            Margin="12"
            Background="White"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <Border CornerRadius="3,3,0,0" Background="#FFF8F9FB">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#FF161923" FontSize="13" Margin="16,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!--  关闭  -->
                            <Border
                            x:Name="BorderClose"
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            MouseLeftButtonDown="BorderClose_MouseLeftButtonDown"
                            Style="{StaticResource ImageBorderStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                                <Path
                                Width="12"
                                Height="12"
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource SVG_CloseWindow}"
                                Fill="#FF161923"
                                RenderTransformOrigin="0.5,0.5"
                                Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="#FFF8F9FB">
                    <StackPanel>
                        <Image Source="{Binding Image}" Width="58" Height="58" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,11,0,0" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Text="{x:Static res:II_RPA_Resource.ExcelForm_255ADDB9}" VerticalAlignment="Center" Foreground="#FF505962"/>
                            <Border CornerRadius="2" BorderThickness="1" Margin="1" BorderBrush="LightGray" VerticalAlignment="Center">
                                <TextBlock FontSize="13" Text="{Binding InfoMessage}" Margin="2" Foreground="#FF8900" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock FontSize="13" Text="{Binding ExcelObject}" VerticalAlignment="Center" Foreground="#FF505962"/>

                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="40,8,5,0" FontSize="13" VerticalAlignment="Top" Foreground="#FF505962" Text="{Binding Label}" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Stretch">
                        <Border CornerRadius="3" Margin="0,0,40,0" BorderThickness="1" BorderBrush="LightGray" HorizontalAlignment="Stretch">
                            <TextBox x:Name="tb_ContentFormat" Foreground="#FF7A8187" VerticalContentAlignment="Center" FontSize="13" BorderThickness="0" Height="30" IsReadOnly="True"  HorizontalAlignment="Stretch" Margin="1" />
                        </Border>
                        <TextBlock x:Name="tb_WarningMessage" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,5,20,0" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3"   VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="13" Margin="40,2,0,0" VerticalAlignment="Center">
                        <Run Text="{x:Static res:II_RPA_Resource.ExcelForm_CA51B24}" Foreground="#FF7A8187"/>
                        <Run Text="Esc" Foreground="#FF8900"/>
                        <Run Text="{x:Static res:II_RPA_Resource.ExcelForm_68F030B1}" Foreground="#FF7A8187"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="80" Height="30" x:Name="btn_Cancel" HorizontalAlignment="Right" Margin="0,0,10,0"   Cursor="Hand" Click="btn_Cancel_Click">
                            <!--Command="{Binding CancelCommand}"-->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="ButtonBorder" CornerRadius="3"  BorderBrush="#C5C9D5" BorderThickness="1" Background="White"  >
                                        <TextBlock  Grid.Column="1" Text="{x:Static res:II_RPA_Resource.ExcelForm_949856B3}" VerticalAlignment="Center" Style="{StaticResource ContentCommonTextBlock}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F4F7"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter  TargetName="ButtonBorder" Property="Background" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="80" Height="30" x:Name="btn_Confirm" HorizontalAlignment="Right" Margin="0,0,40,0" BorderBrush="#ECEEF2" BorderThickness="0"  Cursor="Hand" Click="btn_Confirm_Click">
                            <!--Style="{StaticResource NoHoverButtonStyle}"-->
                            <!--Command="{Binding ConfirmCommand}"-->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="ButtonBorder" CornerRadius="3" BorderThickness="0"  Background="#FF8900"  >
                                        <TextBlock  Text="{x:Static res:II_RPA_Resource.ExcelForm_621A8231}" VerticalAlignment="Center" Foreground="#FFFFFF" Style="{StaticResource ContentCommonTextBlock}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#FF9810"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter  TargetName="ButtonBorder" Property="Background" Value="#FF8900"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
