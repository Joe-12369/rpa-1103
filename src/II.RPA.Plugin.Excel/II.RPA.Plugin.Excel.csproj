  <Target Name="DeployExcelPlugin" AfterTargets="AfterBuild" Condition="'$(SkipExcelPluginDeployment)' != 'true'">
    <PropertyGroup>
      <_PluginName>Excel</_PluginName>
      <_SolutionDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_SolutionDir>
      <_SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildProjectDirectory)\..\</_SolutionDir>
      <_RuntimePluginDir>$(_SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(_SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
      <_RuntimeVbDir>$(_SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\vb\</_RuntimeVbDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <RemoveDir Directories="$(_RuntimeVbDir)" Condition="Exists('$(_RuntimeVbDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir);$(_RuntimeVbDir)" />
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_MainOutput Include="$(TargetDir)$(TargetName).*" />
      <_VbScript Include="$(TargetDir)VBScript\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainOutput)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_VbScript)" DestinationFolder="$(_RuntimeVbDir)%(_VbScript.RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>
