  <!-- Target 閺囧じ鍞?PostBuildEvent閿涙碍澧嶉崚?Copy 缂傚搫銇戝┃鎰瀮娴犺泛宓嗘径杈Е閿涘瞼鏁撻幋鎰亼鐠愩儻绱濋柆鍨帳 cmd 閸欘亪鍣伴悽銊︽付閸氬簼绔撮弶锟犫偓鈧崙铏圭垳閼板被鈧矂娼ゆ妯煎繁閺傚洣娆㈤妴宥冣偓鍌炩偓姘跺帳缁楋附妫ら崠褰掑帳閺冭泛鍨悰銊よ礋缁岀尨绱濈€电懓绨?Copy 娑撳秵濮ら柨娆嶁偓?-->
  <Target Name="DeployDatabasePlugin" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_PluginName>Database</_PluginName>
      <_RuntimePluginDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimePluginDir>
      <_RuntimeCsDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\runtime\$(_PluginName)\</_RuntimeCsDir>
      <_PluginLoaderDir>$(SolutionDir)..\bin\II.RPA.PluginLoader\</_PluginLoaderDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RuntimeCsDir)" Condition="Exists('$(_RuntimeCsDir)')" />
    <MakeDir Directories="$(_RuntimePluginDir);$(_RuntimeCsDir);$(_PluginLoaderDir)x86;$(_PluginLoaderDir)x64" />
    <!-- runtime 閹绘帊娆㈠〒鍛礋娑撳簼瀵屾潏鎾冲毉 -->
    <Copy SourceFiles="$(TargetDir)Config\config.json" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <_MainOutput Include="$(TargetDir)$(TargetName).*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainOutput)" DestinationFolder="$(_RuntimeCsDir)" SkipUnchangedFiles="false" />
    <!-- 鐎瑰じ瀵?Loader 閻╊喖缍嶆稉瀣畱娓氭繆绂嗛敍鍫モ偓姘跺帳缁楋附妫ら崠褰掑帳閺冭泛鍨悰銊よ礋缁岀尨绱濇稉宥嗗Г闁挎瑱绱?-->
    <ItemGroup>
      <_LoaderCopy Include="$(TargetDir)EntityFramework.*" />
      <_LoaderCopy Include="$(TargetDir)Npgsql.*" />
      <_LoaderCopy Include="$(TargetDir)System.Buffers.*" />
      <_LoaderCopy Include="$(TargetDir)System.Data.SQLite.*" />
      <_LoaderCopy Include="$(TargetDir)System.Memory.*" />
      <_LoaderCopy Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.*" />
      <_LoaderCopy Include="$(TargetDir)System.Threading.Tasks.Extensions.*" />
      <_LoaderCopy Include="$(TargetDir)System.ValueTuple.*" />
      <_LoaderCopy Include="$(TargetDir)K4os.*" />
      <_LoaderCopy Include="$(TargetDir)Oracle.ManagedDataAccess.*" />
      <!-- ODP.NET Core 3.21 requires this dependency in the dynamic loader directory. -->
      <_LoaderCopy Include="$(TargetDir)System.DirectoryServices.Protocols.*" />
      <!-- Without a RID, NuGet places Windows implementations below runtimes/win.
           The loader does not probe that hierarchy: flatten only these implementations
           after copying the portable assets, never the Linux/macOS implementations. -->
      <_OracleWindowsRuntime Include="$(TargetDir)runtimes\win\lib\**\System.DirectoryServices.Protocols.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_LoaderCopy)" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_OracleWindowsRuntime)" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)IBM.Data.DB2.dll" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)IBM.Data.DB2.dll')" />
    <Copy SourceFiles="$(TargetDir)MySql.Data.dll" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)MySql.Data.dll')" />
    <Copy SourceFiles="$(TargetDir)DmProvider.dll" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)DmProvider.dll')" />
    <Copy SourceFiles="$(TargetDir)MySqlConnector.dll" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)MySqlConnector.dll')" />
    <Copy SourceFiles="$(TargetDir)System.Diagnostics.DiagnosticSource.dll" DestinationFolder="$(_PluginLoaderDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)System.Diagnostics.DiagnosticSource.dll')" />
    <ItemGroup>
      <_NativeX86 Include="$(TargetDir)x86\*.dll" />
      <_NativeX64 Include="$(TargetDir)x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeX86)" DestinationFolder="$(_PluginLoaderDir)x86\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_NativeX64)" DestinationFolder="$(_PluginLoaderDir)x64\" SkipUnchangedFiles="false" />
  </Target>
  <ItemGroup>
    <PackageReference Include="DmProvider1.1.0" Version="1.1.0" />
