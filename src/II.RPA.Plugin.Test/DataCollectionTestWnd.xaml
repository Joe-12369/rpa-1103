<Window x:Class="II.RPA.Plugin.Test.DataCollectionTestWnd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:II.RPA.Plugin.Test"
             mc:Ignorable="d" 
        Title="数据采集v2 功能测试"
        WindowStartupLocation="Manual"
        WindowState="Normal" 
        Width="880"
        Height="596"
        Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Orientation="Horizontal">
            <Button Name="statCapture"  Content="开始拾取" Margin="10" Width="80" Block.LineStackingStrategy="BlockLineHeight" Click="statCapture_Click" />
            <Button Name="endCapture" Content="停止拾取" Margin="10" Width="80" UseLayoutRounding="True" Click="endCapture_Click" />
            <Button Name="colectionData" Content="预览采集" Margin="10"  Click="colectionData_Click" />
            <Button x:Name="colectionData_run" Content="运行采集"  Margin="10" Click="colectionData_run_Click" />
            <Button Name="colectionData_WaterfallFlow"  Content="瀑布流采集" Margin="10" Click="colectionData_WaterfallFlow_Click" />
            <TextBox Name="ColectionCount"  Text="50"   Width="80" Height="20" ></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" >
            <GroupBox Height="100" Header="参数">
                <TextBox Name="rt_params"  Text="{Binding ParamStr}" AcceptsReturn="True" TextWrapping="Wrap"  ></TextBox>
            </GroupBox>
        </StackPanel>

        <DockPanel LastChildFill="False" Grid.Row="2"  Grid.Column="0">
            <GroupBox Header="配置结构" DockPanel.Dock="Top"  VerticalAlignment="Top">
                <TextBox Name="rt_configData" Text="{Binding ConfigData}" AcceptsReturn="True" Height="180" />
            </GroupBox>
            <GroupBox Header="返回值" DockPanel.Dock="Top" VerticalAlignment="Bottom">
                <TextBox Name="rt_result" Text="{Binding ResultStr}" AcceptsReturn="True" Height="152" />
            </GroupBox>
        </DockPanel>
        <GroupBox Grid.Row="2"  Grid.Column="1" Header="数据预览" DockPanel.Dock="Bottom" >
            <!--<DataGrid d:ItemsSource="{d:SampleData ItemCount=5}"/>-->
            <!--<DataGrid x:Name="dgCollectData" ItemsSource="{Binding}" HorizontalAlignment="Left" Height="294" VerticalAlignment="Top" Width="347" Margin="30,83,0,0" />-->

            <DataGrid ItemsSource="{Binding}"  Margin="6" Name="dgCollectData" Width="Auto" FontWeight="Normal" FontSize="16">

            </DataGrid>
        </GroupBox>

    </Grid>
</Window>
