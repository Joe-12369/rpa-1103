<UserControl x:Class="II.RPA.Plugin.Dialog.UCControl.UCDate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:rubyer="clr-namespace:Rubyer;assembly=Rubyer" 
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rubyer;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Primary" Color="#F7F7F7"/>
            <SolidColorBrush x:Key="BorderGray" Color="#d9e0e8"/>
            <SolidColorBrush x:Key="PrimaryForeground" Color="Black"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8" >
            <StackPanel Orientation="Horizontal">
                <Label Name="REQUIRED" Content="*" Foreground="#FF6151" Margin="0,0,2,0" Visibility="Collapsed"/>
                <Label Name="LAB"  Content="{DynamicResource UCDate.xaml_RiQiKongJian}"/>
            </StackPanel>
            <Border BorderThickness="1" CornerRadius="3" BorderBrush="{Binding WarningColor}">
                <rubyer:DateTimePicker Name="RB_DATE" BorderThickness="0" DateTimeFormat="yyyy-MM-dd" MouseEnter="RB_DATE_MouseEnter" MouseLeave="RB_DATE_MouseLeave"/>
            </Border>
            <Label Foreground="#FF6151" FontSize="12" Visibility="{Binding EmptyVisibity}" Content="{DynamicResource UCBrowserFile.xaml_BuNengWeiKong}"></Label>
        </StackPanel>
    </StackPanel>
</UserControl>
