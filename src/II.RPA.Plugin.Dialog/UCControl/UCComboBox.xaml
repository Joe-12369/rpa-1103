<UserControl
    x:Class="II.RPA.Plugin.Dialog.UCControl.UCComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pu="clr-namespace:Panuon.UI;assembly=Panuon.UI"
    d:DesignHeight="74"
    d:DesignWidth="436"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <!--<ResourceDictionary>
                    <Style x:Key="LabelCommonStyle" TargetType="{x:Type Label}">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    </Style>
                </ResourceDictionary>-->
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <Label
                Name="LAB"
                Content="{DynamicResource UCComboBox.xaml_XiaLaLieBiao}"
                Style="{StaticResource DialogCommonLabelStyle}" />
            <StackPanel>
                <!--<pu:PUComboBox x:Name="CMB" Height ="36" FontSize="13" BorderCornerRadius="4" MouseEnter="CMB_MouseEnter" MouseLeave="CMB_MouseLeave" >

            </pu:PUComboBox>-->

                <hc:CheckComboBox
                    Name="CMB"
                    Width="auto"
                    Height="auto"
                    Margin="0"
                    IsShowSearchBox="True"
                    IsTextSearchEnabled="False"
                    SearchBoxHeight="30"
                    SelectionMode="Single"
                    ShowClearButton="False"
                    ShowSelectAllButton="False"
                    VirtualizingPanel.IsVirtualizing="False" />

            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
