<UserControl x:Class="II.RPA.Plugin.Dialog.UCControl.UCPasswordLook"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
                xmlns:rubyer="clr-namespace:Rubyer;assembly=Rubyer" 
             d:DesignHeight="74" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rubyer;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource RubyerPasswordBox}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <StackPanel Orientation="Horizontal">
                <Label Name="REQUIRED" Content="*" Foreground="#FF6151" Margin="0,0,2,0" Visibility="Collapsed"/>
                <Label Name="LAB"  Content="{DynamicResource MiMaKuang}"/>
            </StackPanel>
            <Border BorderThickness="1" CornerRadius="3" BorderBrush="{Binding WarningColor}" Margin="0,0,0,1">
                <PasswordBox Name="BOX" Height ="36" PreviewMouseWheel="BOX_PreviewMouseWheel" rubyer:PasswordHelper.ShowSwitchButton="True"
                    rubyer:TextBoxHelper.FocusedBrush="#D0D5E0"
                    rubyer:TextBoxHelper.Placeholder = "{DynamicResource UCPasswordLook.xaml_QingShuRuMiMa}"
                    BorderThickness="0" MouseEnter="BOX_MouseEnter" MouseLeave="BOX_MouseLeave"
                    />
            </Border>
            <Label Foreground="#FF6151" FontSize="12" Visibility="{Binding EmptyVisibity}" Content="{DynamicResource UCBrowserFile.xaml_BuNengWeiKong}"></Label>
        </StackPanel>
    </StackPanel>
</UserControl>
