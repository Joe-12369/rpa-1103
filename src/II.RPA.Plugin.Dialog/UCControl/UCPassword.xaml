<UserControl
    x:Class="II.RPA.Plugin.Dialog.UCControl.UCPassword"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="74"
    d:DesignWidth="436"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Name="REQUIRED"
                    Margin="0,0,2,0"
                    Foreground="#FF6151"
                    Text="*"
                    Visibility="Collapsed" />
                <TextBlock Name="LAB" Text="{DynamicResource MiMaKuang}" />
            </StackPanel>
            <PasswordBox
                Name="BOX"
                Height="36"
                Margin="0,2,0,0"
                BorderBrush="{Binding WarningColor}"
                MouseEnter="BOX_MouseEnter"
                MouseLeave="BOX_MouseLeave"
                PreviewMouseWheel="BOX_PreviewMouseWheel"
                Style="{StaticResource PasswordBoxExtend}" />
            <TextBlock
                FontSize="12"
                Foreground="#FF6151"
                Text="{DynamicResource UCBrowserFile.xaml_BuNengWeiKong}"
                Visibility="{Binding EmptyVisibity}" />
        </StackPanel>
    </StackPanel>
</UserControl>
