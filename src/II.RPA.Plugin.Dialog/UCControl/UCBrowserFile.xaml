<UserControl x:Class="II.RPA.Plugin.Dialog.UCControl.UCBrowserFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="94" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <StackPanel Orientation="Horizontal">
                <Label Name="REQUIRED" Content="*" Foreground="#FF6151" Margin="0,0,2,0" Visibility="Collapsed"/>
                <Label Name="LAB"  Content="{DynamicResource UCBrowserFile.xaml_WenJianXuanZe}"/>
            </StackPanel>
            <DockPanel Height ="36">
                <Button DockPanel.Dock="Right" BorderBrush="#D0D5E0" Background="#F7F8FA" Width="38" HorizontalAlignment="Right" Click="Button_Click">
                    <Image Margin="8" Source="../Image/open.png" />
                </Button>
                <TextBox x:Name="txtSelect" BorderBrush="{Binding WarningColor}" MouseEnter="txtSelect_MouseEnter" MouseLeave="txtSelect_MouseLeave"/>
            </DockPanel>
            <Label Foreground="#FF6151" FontSize="12" Visibility="{Binding EmptyVisibity}" Content="{DynamicResource UCBrowserFile.xaml_BuNengWeiKong}"></Label>
        </StackPanel>
    </StackPanel>
</UserControl>
