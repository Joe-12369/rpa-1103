<UserControl x:Class="II.RPA.Plugin.Dialog.UCControl.UCDataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:II.RPA.Plugin.Dialog.UCControl"
             xmlns:custom="clr-namespace:II.RPA.Plugin.Dialog"
            xmlns:helper="clr-namespace:II.RPA.Plugin.Dialog.Helpers"
             xmlns:conv ="clr-namespace:II.RPA.Plugin.Dialog.Converts"
             mc:Ignorable="d" 
             d:DesignHeight="284" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/CustomDataTable.xaml"></ResourceDictionary>
                <ResourceDictionary Source="../Skin/Image.xaml"></ResourceDictionary>
                <ResourceDictionary Source="../Skin/BaseStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <conv:TableWidthConv x:Key="wid"></conv:TableWidthConv>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel  Width="Auto" Height="Auto">
        <StackPanel Margin="16,8,16,8" >
            <DockPanel>
                <Button DockPanel.Dock="Right"  Margin="0,0,0,3" Style="{StaticResource ButtonStyleQK}" Click="Clear_Click" Height="16" HorizontalContentAlignment="Stretch"  Width="70"></Button>
                <Button DockPanel.Dock="Right"  Margin="0,0,0,3" Style="{StaticResource ButtonStyleDC}" Click="Export_Click" Height="16" HorizontalContentAlignment="Stretch" Width="90"></Button>
                <Button DockPanel.Dock="Right"  Margin="0,0,0,3" Style="{StaticResource ButtonStyleDR}" Click="Import_Click" Height="16" HorizontalContentAlignment="Stretch" Width="80"></Button>
                <Label Name="LAB"  Content="{DynamicResource UCDataTable.xaml_ShuJuBiao}"/>
            </DockPanel>
            <StackPanel  Orientation="Vertical">
            </StackPanel>
            <StackPanel Name="TABLESP" PreviewMouseWheel="StackPanel_PreviewMouseWhee">
                <DataGrid MaxHeight="240" 
                        Name="TABLE" DataGridCell.Selected="DataGrid_GotFocus" AutoGenerateColumns="True" ContextMenuOpening="TABLE_ContextMenuOpening" VirtualizingStackPanel.VirtualizationMode="Standard"
                        CanUserAddRows="False" IsReadOnly="False" 
                        SelectionUnit="CellOrRowHeader" CanUserReorderColumns="False"
                        Sorting="Dg_Sorting"
                        FontSize="13" HeadersVisibility="All" BorderThickness="1,1,0,0" 
                        BorderBrush="{StaticResource GridLineColor}"
                        RowHeight="24" ColumnHeaderHeight="26">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="{x:Type ContextMenu}">
                                    <Border Padding="10">
                                        <Border CornerRadius="8" x:Name="Border" Background="White" BorderThickness="1">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" ShadowDepth="4"  Opacity="0.16" BlurRadius="10"  />
                                            </Border.Effect>
                                        </Border>
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <MenuItem Name="m1" Icon="{StaticResource VbCopy}" Header="{DynamicResource UCDataTable.xaml_FuZhiXing}" Click="Row_Copy">
                                <MenuItem.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy"></CommandBinding>
                                </MenuItem.CommandBindings>
                            </MenuItem>
                            <MenuItem Name="m2" Icon="{StaticResource VbPaste}" Header="{DynamicResource UCDataTable.xaml_NianTieXing}" Click="Row_Paste">
                                <MenuItem.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste"></CommandBinding>
                                </MenuItem.CommandBindings>
                            </MenuItem>
                            <custom:CustomMenuItem x:Name="m3" Header="{DynamicResource UCDataTable.xaml_XiangShangChaRu}" Icon="{StaticResource VbUp}"
                                                helper:MenuItemHelper.LastName="{DynamicResource UCDataTable.xaml_Hang}"
                                                Click="Row_UpInsert"></custom:CustomMenuItem>
                            <custom:CustomMenuItem x:Name="m4" Header="{DynamicResource UCDataTable.xaml_XiangXiaChaRu}" Icon="{StaticResource VbDowm}"
                                                helper:MenuItemHelper.LastName="{DynamicResource UCDataTable.xaml_Hang}"
                                                Click="Row_DownInsert"></custom:CustomMenuItem>
                            <MenuItem Name="m5" Icon="{StaticResource VbDelete}" Header="{DynamicResource UCDataTable.xaml_ShanChu}" Click="Row_Delete"></MenuItem>

                            <MenuItem Name="m6" Icon="{StaticResource VbCopy}" Header="{DynamicResource UCDataTable.xaml_FuZhiLie}" Click="Column_Copy">
                                <MenuItem.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy"></CommandBinding>
                                </MenuItem.CommandBindings>
                            </MenuItem>
                            <MenuItem Name="m7" Icon="{StaticResource VbPaste}" Header="{DynamicResource UCDataTable.xaml_NianTieLie}" Click="Column_Paste">
                                <MenuItem.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste"></CommandBinding>
                                </MenuItem.CommandBindings>
                            </MenuItem>
                            <custom:CustomMenuItem x:Name="m8" Header="{DynamicResource UCDataTable.xaml_XiangZuoChaRu}" Icon="{StaticResource VbLeft}"
                                                helper:MenuItemHelper.LastName="{DynamicResource UCDataTable.xaml_Lie}"
                                                Click="Column_LeftInsert"></custom:CustomMenuItem>
                            <custom:CustomMenuItem x:Name="m9" Header="{DynamicResource UCDataTable.xaml_XiangYouChaRu}" Icon="{StaticResource VbRight}"
                                                helper:MenuItemHelper.LastName="{DynamicResource UCDataTable.xaml_Lie}"
                                                Click="Column_RightInsert"></custom:CustomMenuItem>
                            <MenuItem Name="m10" Icon="{StaticResource VbDelete}" Header="{DynamicResource UCDataTable.xaml_ShanChu}" Click="Column_Delete"></MenuItem>
                            <MenuItem Name="m11" Icon="{StaticResource VbDelete}" Header="{DynamicResource UCDataTable.xaml_ShanChuDangQianXing}" Click="DelRow_Click"></MenuItem>
                            <MenuItem Name="m12" Icon="{StaticResource VbDelete}" Header="{DynamicResource UCDataTable.xaml_ShanChuDangQianLie}" Click="DelColumn_Click"></MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy"></CommandBinding>
                        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste"></CommandBinding>
                    </DataGrid.CommandBindings>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
