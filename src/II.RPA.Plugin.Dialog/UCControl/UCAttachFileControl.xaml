<UserControl
    x:Class="II.RPA.Plugin.Dialog.UCControl.UCAttachFileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.Plugin.Dialog.UCControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                                <TextBlock Text="{TemplateBinding Tag}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Viewbox
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            x:Key="Icon.Cloud"
            Stretch="Uniform">
            <Canvas
                Width="1024.0"
                Height="1024.0"
                UseLayoutRounding="False">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                </Canvas.Clip>
                <Path Fill="#D9E0E8">
                    <Path.Data>
                        <PathGeometry Figures="M 234.667 170.667 h 341.333 v 213.333 h 213.333 v 170.667 h 85.3333 V 341.333 l -256 -256 h -384 a 85.3333 85.3333 0 0 0 -85.3333 85.3333 v 682.667 a 85.3333 85.3333 0 0 0 85.3333 85.3333 h 170.667 v -85.3333 h -170.667 z m 631.467 534.613 A 151.467 151.467 0 0 0 725.333 597.333 a 161.707 161.707 0 0 0 -123.733 64.8533 a 141.227 141.227 0 0 0 -132.267 142.08 A 130.56 130.56 0 0 0 610.133 938.667 h 256 a 115.2 115.2 0 0 0 115.2 -117.333 a 121.173 121.173 0 0 0 -115.2 -116.053 z" FillRule="Nonzero" />
                    </Path.Data>
                </Path>
            </Canvas>
        </Viewbox>
        <Viewbox
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            x:Key="Icon.Folder"
            Stretch="Uniform">
            <Canvas
                Width="1024.0"
                Height="1024.0"
                UseLayoutRounding="False">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                </Canvas.Clip>
                <Path Fill="#D9E0E8">
                    <Path.Data>
                        <PathGeometry Figures="M 934.827 407.893 H 938.667 V 341.333 a 85.3333 85.3333 0 0 0 -85.3333 -85.3333 h -341.333 l -85.3333 -85.3333 H 170.667 a 85.3333 85.3333 0 0 0 -85.3333 85.3333 v 512 a 85.3333 85.3333 0 0 0 85.3333 85.3333 h 678.827 v -2.98667 a 85.3333 85.3333 0 0 0 64.4267 -58.4533 l 81.4933 -277.333 a 85.3333 85.3333 0 0 0 -60.5867 -106.667 z M 853.333 341.333 v 64 H 325.973 a 85.3333 85.3333 0 0 0 -81.92 61.44 L 170.667 715.52 V 341.333 z m -21.3333 426.667 H 244.053 l 81.92 -277.333 h 587.52 z" FillRule="Nonzero" />
                    </Path.Data>
                </Path>
            </Canvas>
        </Viewbox>
        <Viewbox
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            x:Key="Icon.Delete"
            Stretch="Uniform">
            <Canvas
                Width="1024.0"
                Height="1024.0"
                UseLayoutRounding="False">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                </Canvas.Clip>
                <Path Fill="#D9E0E8">
                    <Path.Data>
                        <PathGeometry Figures="M 736 800 c 0 19.2 -12.8 32 -32 32 H 320 c -19.2 0 -32 -12.8 -32 -32 V 256 h 448 v 544 z m -320 -640 c 0 -19.2 12.8 -32 32 -32 h 128 c 19.2 0 32 12.8 32 32 V 192 h -192 v -32 z m 256 32 v -32 C 672 108.8 627.2 64 576 64 H 448 c -51.2 0 -96 44.8 -96 96 V 192 h -192 v 64 h 64 v 544 c 0 51.2 44.8 96 96 96 h 384 c 51.2 0 96 -44.8 96 -96 V 256 h 64 V 192 h -192 z" FillRule="Nonzero" />
                    </Path.Data>
                </Path>
                <Path Fill="#D9E0E8">
                    <Path.Data>
                        <PathGeometry Figures="M 601.6 416 L 512 505.6 L 422.4 416 l -44.8 44.8 l 89.6 89.6 L 377.6 640 l 44.8 44.8 L 512 595.2 l 89.6 89.6 l 44.8 -44.8 l -89.6 -89.6 l 89.6 -89.6 z" FillRule="Nonzero" />
                    </Path.Data>
                </Path>
            </Canvas>
        </Viewbox>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12,6,12,6" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="FontFamily" Value="MicroSoft Yahei" />
            <!--<Setter Property="ToolTipService.InitialShowDelay" Value="10"/>-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <ControlTemplate.Resources />
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Margin="2"
                            Background="#B2000000"
                            CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="6"
                                    Direction="0"
                                    ShadowDepth="0"
                                    Color="#1E000000" />
                            </Border.Effect>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="MaxWidth" Value="260" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Content}" Value="">
                                <Setter Property="Control.Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Content}" Value="{x:Null}">
                                <Setter Property="Control.Visibility" Value="Hidden" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Height="36" Margin="0,0,0,4">
        <Grid Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="4" Grid.ColumnSpan="5"/>
            <Viewbox Margin="6" Stretch="Uniform" Height="16" Width="16">
                <Canvas
                    Width="1024.0"
                    Height="1024.0"
                    UseLayoutRounding="False">
                    <Canvas.Clip>
                        <RectangleGeometry Rect="0.0,0.0,1024.0,1024.0" />
                    </Canvas.Clip>
                    <Path Fill="#8B97AF">
                        <Path.Data>
                            <PathGeometry Figures="M 746.048 520.704 c 51.84 -55.68 53.248 -144.448 3.072 -198.272 c -50.176 -53.888 -132.864 -52.352 -184.704 3.328 l -312.96 336 l 60.48 65.024 l 312.96 -336 c 17.344 -18.56 44.928 -19.136 61.632 -1.152 c 15.488 16.64 16.256 43.392 2.432 61.952 l -3.456 4.16 l -312.96 336 c -51.904 55.68 -134.592 57.152 -184.768 3.328 c -48.32 -51.904 -48.768 -136.32 -2.24 -192.192 l 5.376 -6.08 l 312.96 -336 c 86.4 -92.8 224.256 -95.36 307.84 -5.568 c 81.408 87.36 81.28 229.952 1.472 323.008 l -6.656 7.488 l -250.368 268.8 l 60.544 65.024 l 250.368 -268.8 c 120.96 -129.92 124.224 -337.152 7.232 -462.72 c -116.992 -125.696 -309.952 -122.24 -430.976 7.68 L 130.368 531.84 c -86.4 92.8 -88.768 240.768 -5.12 330.496 c 83.52 89.728 221.376 87.296 307.84 -5.504 l 312.96 -336 z" FillRule="Nonzero" />
                        </Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>
            <Border
                Name="PART_TypeBorder"
                Grid.Column="1"
                Margin="1,0,0,0"
                VerticalAlignment="Center"
                Background="#1EFF8910"
                CornerRadius="4"
                IsHitTestVisible="False">
                <TextBlock
                    Name="PART_TypeTextblock"
                    Margin="4,1,4,1"
                    Foreground="#FF8910 "
                    Text="本地" />
            </Border>
            <TextBlock
                Name="PART_FileName"
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent"
                Cursor="Arrow"
                FontSize="13"
                Foreground="#0085FF"
                Style="{x:Null}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTip="{DynamicResource UCAnnex.xaml_ToolTip_DisableDownload}" />
            <Button
                Name="PART_Button_Replace"
                Grid.Column="3"
                Width="16"
                Height="16"
                Content="{StaticResource Icon.Folder}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="{DynamicResource UCAnnex.xaml_ToolTip_DisableReplace}" />
            <Button
                Grid.Column="4"
                Margin="8,0,8,0"
                Width="16"
                Height="16"
                Content="{StaticResource Icon.Delete}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="{DynamicResource UCAnnex.xaml_ToolTip_DisableDelete}" />
        </Grid>
    </Grid>
</UserControl>
