<UserControl x:Class="II.RPA.Plugin.Dialog.UCControl.UCSeparator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="436" x:Name="my">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="16,20,16,6"   Orientation ="Horizontal" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top">
        <Label Name="LAB"  Content="{DynamicResource UCSeparator.xaml_JiBenShuXing}" FontWeight="Bold"  />
        <Line x:Name="LINE"  Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=ActualWidth}"  Stretch="Uniform" Stroke="#d0d5e0"  X2="2"/>
    </StackPanel>
</UserControl>
