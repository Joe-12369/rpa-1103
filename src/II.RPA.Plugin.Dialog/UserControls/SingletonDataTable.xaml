<UserControl x:Class="II.RPA.Plugin.Dialog.UserControls.SingletonDataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:II.RPA.Plugin.Dialog.UserControls"
             xmlns:custom="clr-namespace:II.RPA.Plugin.Dialog"
             xmlns:helper="clr-namespace:II.RPA.Plugin.Dialog.Helpers"
             xmlns:conv ="clr-namespace:II.RPA.Plugin.Dialog.Converts"
             xmlns:pu="clr-namespace:Panuon.UI.Silver;assembly=Panuon.UI.Silver"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

	<DataGrid MaxHeight="240"
                        Name="TABLE"  AutoGenerateColumns="True"  VirtualizingStackPanel.VirtualizationMode="Standard"
                        CanUserAddRows="False" IsReadOnly="True"
                        SelectionUnit="CellOrRowHeader" CanUserReorderColumns="False"
                        FontSize="13" HeadersVisibility="All" BorderThickness="0,0,0,0"
                        RowHeight="24" ColumnHeaderHeight="26"
                        pu:DataGridHelper.SelectedBackground="#44B5B5B5"
                        pu:DataGridHelper.HoverBackground="#22B5B5B5" >
	</DataGrid>
</UserControl>
