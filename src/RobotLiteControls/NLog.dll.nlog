<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
	  maxArchiveFiles ="100"
	internalLogFile="c:\temp\nlog-internal.log">

	<!-- optional, add some variables
  https://github.com/nlog/NLog/wiki/Configuration-file#variables
  -->
	<variable name="user" value="default"/>

	<targets async="true">
		<target name="FactoryLogger" xsi:type="File"
				fileName="${specialfolder:folder=ApplicationData}/Z-Factory/logs/${shortdate}/dll_logs/LiteControl.log"
				layout="[${longdate}] [${processid}] [${threadid}] [${level}]: ${message}${newline}${exception}"
				archiveFileName="${specialfolder:folder=ApplicationData}/Z-Factory/logs/${shortdate}/dll_logs/LiteControl.{#####}.log"
				maxArchiveFiles="100" archiveAboveSize="10240000" archiveNumbering="Sequence" encoding="utf-8"/>
		<target name="BotLogger" xsi:type="File"
				fileName="${specialfolder:folder=ApplicationData}/Z-Bot/logs/${shortdate}/dll_logs/LiteControl.log"
				layout="[${longdate}] [${processid}] [${threadid}] [${level}]: ${message}${newline}${exception}"
				archiveFileName="${specialfolder:folder=ApplicationData}/Z-Bot/logs/${shortdate}/dll_logs/LiteControl.{#####}.log"
				maxArchiveFiles="100" archiveAboveSize="10240000" archiveNumbering="Sequence" encoding="utf-8"/>
		<target name="AppLogger" xsi:type="File"
				fileName="Logs/${shortdate}/LiteControl.log"
				layout="[${longdate}] [${processid}] [${threadid}] [${level}]: ${message}${newline}${exception}"
				archiveFileName="Logs/${shortdate}/LiteControl.{#####}.log"
				maxArchiveFiles="50"
				archiveAboveSize="10240000" archiveNumbering="Sequence" encoding="utf-8"/>
	</targets>

	<!--Trace，Debug，Info，Warn，Error，Fatal-->

	<rules>
		<logger name="FactoryLogger" minlevel="Trace" writeTo="FactoryLogger" />
		<logger name="BotLogger" minlevel="Info" writeTo="BotLogger" />
		<logger name="AppLogger" minlevel="Trace" writeTo="AppLogger" />
	</rules>
</nlog>
