<UserControl x:Class="RobotLiteControls.UCControl.UCPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <Label Name="LAB"  Content="密码框"/>
            <PasswordBox Name="BOX" Height ="36" PreviewMouseWheel="BOX_PreviewMouseWheel"/>
        </StackPanel>
    </StackPanel>
</UserControl>
