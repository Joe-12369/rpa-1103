<UserControl x:Class="RobotLiteControls.UCControl.SubUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="436">
    <Grid Height="28" Margin="0,0,0,4">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="18"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Background="{x:Null}" BorderBrush="{x:Null}">
            <WrapPanel >
                <Image Height="14" Width="18" Source="../Image/annex.png"/>
                <TextBlock x:Name="FileName" TextWrapping="Wrap" Text="将文件拖拽到此或点击添加文件"  FontSize="12" VerticalAlignment="Center" Padding="5,0,0,0"/>
            </WrapPanel>
        </Label>
        <Button Width="18" Height="18"  Grid.Column="1"  Background="{x:Null}" BorderBrush="{x:Null}" Click="Button_Click" >
            <WrapPanel >
                <Image Source="../Image/delete.png"/>
            </WrapPanel>
        </Button>
    </Grid>
</UserControl>
