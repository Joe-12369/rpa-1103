<UserControl x:Class="RobotLiteControls.UCControl.UCBrowserFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <Label Name="LAB"  Content="文件选择"/>
            <StackPanel Height ="36" Orientation="Horizontal">
                <TextBox x:Name="txtSelect" Width="362" Margin="0,0,4,0" HorizontalAlignment="Left"></TextBox>
                <Button Width="38" HorizontalAlignment="Right" Click="Button_Click">
                    <Button.Template>
                        <ControlTemplate>
                            <Grid>
                                <Image Margin="2" Source="../Image/open.png" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
