<UserControl x:Class="RobotLiteControls.UCControl.UCUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Width="436">
        <StackPanel Margin="16,8,16,8">
            <Label Name="LAB" Content="上传附件"/>
            <Button  Width="404" Height="52" Style="{StaticResource ButtonImage}" DragEnter="GroupBox_DragEnter" Click="Button_Click" AllowDrop="True">
                <WrapPanel >
                    <Image Height="14" Width="18" Source="../Image/upload.png"/>
                    <TextBlock x:Name="TIPS" TextWrapping="Wrap" Text="将文件拖拽到此或点击添加文件"  FontSize="12" VerticalAlignment="Center" Padding="5,0,0,0"/>
                </WrapPanel>
            </Button>
            <StackPanel x:Name="SP">

            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
