<UserControl x:Class="RobotLiteControls.UCControl.SubAnnex"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="436" HorizontalContentAlignment="Left">
    <UserControl.Resources>
        <Style x:Key="MyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <WrapPanel >
                            <Image Height="14" Width="18" Source="../Image/annexblue.png"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Content,RelativeSource={RelativeSource TemplatedParent}}" Foreground="#0085FF"  FontSize="13" VerticalAlignment="Center" Padding="5,0,0,0"/>
                        </WrapPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Height="28" Margin="0,0,0,4">
        <Button  x:Name="FileName" Click="Button_Click" Style="{StaticResource MyButton}">
        </Button>
    </Grid>
</UserControl>
