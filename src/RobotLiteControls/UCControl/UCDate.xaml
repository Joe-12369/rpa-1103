<UserControl x:Class="RobotLiteControls.UCControl.UCDate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:rubyer="clr-namespace:Rubyer;assembly=Rubyer" 
             xmlns:wfi ="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:wf ="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rubyer;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Primary" Color="#F7F7F7"/>
            <SolidColorBrush x:Key="BorderGray" Color="#d9e0e8"/>
            <SolidColorBrush x:Key="PrimaryForeground" Color="Black"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8" >
            <Label Name="LAB"  Content="日期控件"/>
            <rubyer:DateTimePicker Name="RB_DATE" DateTimeFormat="yyyy-MM-dd" />
        </StackPanel>
    </StackPanel>
</UserControl>
