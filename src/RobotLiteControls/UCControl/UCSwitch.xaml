<UserControl x:Class="RobotLiteControls.UCControl.UCSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="36" d:DesignWidth="436">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Switch.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Height="36">
        <StackPanel Margin="16,0,16,10"   Orientation ="Horizontal" HorizontalAlignment="Left" Height="36" VerticalAlignment="Top">
            <Label Name="LAB" Width="Auto" HorizontalAlignment ="Left"  Content="开关" FontSize="13"  Foreground="#FF5C6F88" Padding="0" VerticalContentAlignment="Center" />
            <CheckBox x:Name="CBOX" Style="{StaticResource SliderCheckBox}" Width="Auto" Height="16" Margin="16,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
