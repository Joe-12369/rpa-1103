<UserControl x:Class="RobotLiteControls.UCControl.UCMultiComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:silver="clr-namespace:Panuon.UI.Silver;assembly=Panuon.UI.Silver"
             xmlns:local="clr-namespace:RobotLiteControls.UCControl"
             mc:Ignorable="d" 
             d:DesignHeight="74" d:DesignWidth="475">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Skin/Font.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="16,8,16,8">
            <Label Name="LAB"  Content="多选下拉列表"/>
            <StackPanel>
                <silver:MultiComboBox Name="MCMB" Height="36" Watermark="请选择" CornerRadius="4" DisplayMemberPath="Content" FontSize="13">
                </silver:MultiComboBox>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
