<UserControl x:Class="RobotLiteControls.BroswerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotLiteControls"
             xmlns:Fluent="clr-namespace:Fluent;assembly=Fluent"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="IIDefaultStyle.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="32px"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Fluent:TextBox x:Name="txtSelect" Grid.Column="0" Margin="0,0,8,0"/>
        <Button x:Name="btnBroswer" HorizontalAlignment="Left"  VerticalAlignment="Top" Style="{StaticResource BtnImgStyle}" Grid.Column="1" Click="btnBroswer_Click" Content="浏览"/>
    </Grid>
</UserControl>
