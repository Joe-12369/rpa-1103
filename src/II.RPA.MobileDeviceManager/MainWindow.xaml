<coreui:FluentWindow
    x:Class="II.RPA.MobileDeviceManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreui="clr-namespace:II.RPA.Plugin.Core.Wpf.Controls.Windows;assembly=II.RPA.Plugin.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.MobileDeviceManager"
    xmlns:lview="clr-namespace:II.RPA.MobileDeviceManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rc="https://ii.rpa/control"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:valconvert="clr-namespace:II.RPA.MobileDeviceManager.ValueTypeConvert"
    xmlns:zxc="clr-namespace:II.RPA.MobileDeviceManager.Controls"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility"
    Title="{x:Static res:II_RPA_Resource.MainWindow_B2D99A75}"
    Width="360"
    Height="734"
    MinWidth="360"
    MinHeight="734"
    d:Height="790"
    d:Width="564"
    BorderThickness="0"
    Style="{StaticResource FluentWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <coreui:FluentWindow.Resources>
        <valconvert:Bool2VisibilityConverter x:Key="Bool2VisibilityConverter" />
        <valconvert:Bool2VisibilityInvertConverter x:Key="Bool2VisibilityInvertConverter" />
        <Style x:Key="VerticalScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <!--  滚动条颜色  -->
                            <Border
                                Background="#646465"
                                CornerRadius="5"
                                Opacity="0.2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <RepeatButton
                                Grid.Row="0"
                                Command="{x:Static ScrollBar.PageUpCommand}"
                                Style="{StaticResource VerticalScrollBarPageButton}" />
                            <Track
                                x:Name="PART_Track"
                                Grid.Row="1"
                                IsDirectionReversed="true"
                                IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource VerticalScrollBarPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource VerticalScrollBarPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                            <RepeatButton
                                Grid.Row="2"
                                Command="{x:Static ScrollBar.PageDownCommand}"
                                Style="{StaticResource VerticalScrollBarPageButton}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
                    <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Height" Value="5" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton
                                        Grid.Row="0"
                                        Command="{x:Static ScrollBar.PageLeftCommand}"
                                        Style="{StaticResource HorizontalScrollBarPageButton}" />
                                    <Track
                                        x:Name="PART_Track"
                                        Grid.Row="1"
                                        IsEnabled="{TemplateBinding IsMouseOver}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource HorizontalScrollBarPageButton}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource HorizontalScrollBarPageButton}" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                    <RepeatButton
                                        Grid.Row="2"
                                        Command="{x:Static ScrollBar.PageRightCommand}"
                                        Style="{StaticResource HorizontalScrollBarPageButton}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </coreui:FluentWindow.Resources>
    <coreui:FluentWindow.WindowTitleBar>
        <coreui:FluentWindowTitleBar Style="{StaticResource WindowTitleBarStyle}">
            <rc:IconButton
                Width="23"
                Height="23"
                Margin="0,0,4,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AllowsAnimation="False"
                Click="LinkHelp_Clinck"
                Cursor="Hand"
                FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                Foreground="#5E5E5E"
                Icon="&#xe781;"
                IconSize="16"
                MouseOverBackground="#F4F6F8"
                MouseOverForeground="#5E5E5E"
                PressedForeground="#5E5E5E"
                RenderOptions.EdgeMode="Unspecified" />
            <rc:IconButton
                Width="21"
                Height="21"
                Margin="0,-2,4,0"
                AllowsAnimation="False"
                Click="Pin_Click"
                Cursor="Hand"
                FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                FontSize="16"
                Foreground="#5E5E5E"
                Icon="{Binding PinWinIcon}"
                MouseOverBackground="#F4F6F8"
                MouseOverForeground="#5E5E5E"
                PressedForeground="#5E5E5E" />
        </coreui:FluentWindowTitleBar>
    </coreui:FluentWindow.WindowTitleBar>
    <coreui:FluentWindow.WindowTitleBarClose>
        <coreui:FluentWindowTitleBar Style="{StaticResource WindowTitleBarStyle}">
            <Button
                x:Name="CloseWin"
                Margin="1,2,1,0"
                VerticalAlignment="Center"
                Background="{StaticResource ButtonMouseOverBackgroundRedBrush}"
                Click="CloseWin_Click"
                Style="{StaticResource CloseButtonStyle}" />
        </coreui:FluentWindowTitleBar>
    </coreui:FluentWindow.WindowTitleBarClose>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            VerticalAlignment="Stretch"
            Background="#FFFFFF"
            MouseDown="Grid_MouseDown"
            MouseRightButtonUp="Grid_MouseRightButtonUp">

            <TextBlock
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#323232"
                Text="手机管理器" />
            <rc:IconButton
                Width="21"
                Height="21"
                Margin="75,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AllowsAnimation="False"
                Cursor="Hand"
                FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                Foreground="#999DA8"
                Icon="&#xe781;"
                IconSize="14"
                RenderOptions.EdgeMode="Unspecified" />

            <StackPanel
                Margin="0,-2,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <rc:IconButton
                    Width="21"
                    Height="21"
                    Margin="0,0,12,0"
                    AllowsAnimation="False"
                    Click="Pin_Click"
                    Cursor="Hand"
                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                    FontSize="12"
                    Foreground="#848A90"
                    Icon="{Binding PinWinIcon}" />
                <rc:IconButton
                    Width="21"
                    Height="21"
                    Margin="0,0,12,0"
                    AllowsAnimation="False"
                    Click="MinWin_Click"
                    Cursor="Hand"
                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                    FontSize="12"
                    Foreground="#999DA8"
                    Icon="&#xe717;" />
                <rc:IconButton
                    Width="21"
                    Height="21"
                    Margin="0,2,12,0"
                    AllowsAnimation="False"
                    Click="MaxWin_Click"
                    Cursor="Hand"
                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                    Foreground="#999DA8"
                    Icon="{Binding MaxMinIcon}"
                    IconSize="14" />
                <rc:IconButton
                    Width="21"
                    Height="21"
                    Margin="0,0,12,0"
                    AllowsAnimation="False"
                    Click="CloseWin_Click"
                    Cursor="Hand"
                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                    Foreground="#999DA8"
                    Icon="&#xe6e7;"
                    IconSize="16" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Width="auto"
            CornerRadius="0">
            <!--<Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.5"
                    ShadowDepth="0"
                    Color="Black" />
            </Border.Effect>-->
            <!--<Grid MinWidth="360" MinHeight="750">-->
            <Grid MinWidth="360">
                <Border
                    Padding="0"
                    Panel.ZIndex="99999"
                    Visibility="{Binding IsLoadingMask, Converter={StaticResource Bool2VisibilityConverter}}">
                    <local:UsercontrolLoadingMantle x:Name="LoadingMask" />
                </Border>
                <Grid
                    Width="auto"
                    Background="Transparent"
                    Visibility="{Binding IsInstallMobileTool, Converter={StaticResource Bool2VisibilityConverter}}">
                    <Border Background="#FFFFFF" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Name="List_Col_Expand"
                                    Width="auto"
                                    MaxWidth="440" />
                                <ColumnDefinition Name="List_Col_Collapse" Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GridSplitter
                                Grid.Column="0"
                                Width="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch" />
                            <Grid Grid.Column="0">
                                <!--<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">-->
                                <Border
                                    Background="#FFFFFF"
                                    CornerRadius="0,0,0,8"
                                    IsHitTestVisible="True"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                            <RowDefinition Height="40" />
                                            <RowDefinition MaxHeight="900" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock
                                                Margin="12,10,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Style="{StaticResource CommonTextBlockTitleStyle}"
                                                Text="我的手机" />
                                        </Grid>
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="12,0,0,0"
                                            Cursor="Hand"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,0,0"
                                                FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                                                FontSize="13"
                                                Foreground="#FF8910"
                                                Style="{StaticResource CommonTextBlockStyle}"
                                                Text="&#xe68f;" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                Cursor="Hand"
                                                FontSize="13"
                                                Foreground="#FF8910"
                                                Style="{StaticResource CommonTextBlockStyle}"
                                                Text="添加手机">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Command="{Binding AddDeviceCommand}" MouseAction="LeftClick" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Row="2" MinWidth="210">
                                            <ListBox
                                                x:Name="UserInfoList"
                                                Width="auto"
                                                Height="auto"
                                                Background="Transparent"
                                                BorderBrush="#eaeaeb"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource UserInfoListStyle}"
                                                ItemsSource="{Binding Devices}"
                                                ScrollViewer.VerticalScrollBarVisibility="Visible">
                                                <!--<ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBox">
                                                                    <Border
                                                                        x:Name="Bd"
                                                                        Padding="0,0,0,4"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ScrollViewer Focusable="False">
                                                                            <ItemsPresenter />
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.Style>-->
                                            </ListBox>
                                        </Border>
                                    </Grid>
                                </Border>
                                <!--</StackPanel>-->
                            </Grid>
                            <Grid Grid.Column="1" />
                            <lview:DeviceScreenView
                                x:Name="DeviceScreen"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#F1F4F7"
                                Visibility="{Binding IsInstallMobileTool, Converter={StaticResource Bool2VisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>


                <Grid Background="Transparent" Visibility="{Binding IsInstallMobileTool, Converter={StaticResource Bool2VisibilityInvertConverter}}">

                    <Border
                        Width="auto"
                        Background="#F1F4F7"
                        CornerRadius="0">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <Border
                                    Margin="0,-150,0,0"
                                    Background="#F1F4F7"
                                    CornerRadius="0,0,8,8"
                                    Visibility="{Binding IsShowInstalling, Converter={StaticResource Bool2VisibilityConverter}}">
                                    <StackPanel Orientation="Vertical">
                                        <zxc:ProgressRing
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#161923"
                                            Progress="{Binding DownloadProgressBar, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="0,35,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="Microsoft YaHei"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#161923"
                                            Style="{DynamicResource CommonTextBlockStyle}"
                                            Text="正在安装手机管理器" />
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="Microsoft YaHei"
                                            FontSize="12"
                                            FontWeight="Regular"
                                            Foreground="#161923"
                                            Style="{DynamicResource CommonTextBlockStyle}"
                                            Text="请保持网络连接" />

                                    </StackPanel>
                                </Border>
                                <Border
                                    Background="#F1F4F7"
                                    CornerRadius="0,0,8,8"
                                    Visibility="{Binding IsShowTips, Converter={StaticResource Bool2VisibilityConverter}}">
                                    <StackPanel Margin="0,40,0,0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="20"
                                                Height="20"
                                                Background="#FF8910"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#FFFFFF"
                                                    Text="1" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,5,0,0"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#161923"
                                                LineHeight="22"
                                                Text="手机连接电脑，并打开调试模式" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Microsoft YaHei"
                                            FontSize="12"
                                            FontWeight="Regular"
                                            Foreground="#000000"
                                            LineHeight="18"
                                            Text="如何开启调试？" />
                                        <zxc:GifPlayBox
                                            Width="260"
                                            Height="582"
                                            Margin="0,20,0,0"
                                            HorizontalAlignment="Center"
                                            GifUrl="./Resources/Images/tips_01.gif" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="0,-150,0,0"
                                    Background="#F1F4F7"
                                    CornerRadius="0,0,8,8"
                                    Visibility="{Binding IsShowInstallFail, Converter={StaticResource Bool2VisibilityConverter}}">
                                    <StackPanel
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Orientation="Vertical">
                                        <Image
                                            Width="122"
                                            Height="122"
                                            Source="{StaticResource Install_Fail}" />
                                        <TextBlock
                                            Margin="0,20,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="Microsoft YaHei"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#161923"
                                            LineHeight="20"
                                            Text="手机管理器安装失败" />
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="Microsoft YaHei"
                                            FontSize="12"
                                            FontWeight="Regular"
                                            Foreground="#161923"
                                            LineHeight="18">
                                            <Run Text="请保持网络连接，" />
                                            <Run
                                                Cursor="Hand"
                                                Foreground="#FF8910"
                                                MouseLeftButtonDown="ReInstall_MouseLeftButtonDown"
                                                Text="重新安装" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                            <Border
                                Width="320"
                                Height="98"
                                Margin="0,0,0,40"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="#FFFFFF"
                                Visibility="{Binding IsShowTips, Converter={StaticResource Bool2VisibilityInvertConverter}}">
                                <StackPanel Margin="16,0,16,0" Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        FontSize="12"
                                        Foreground="#161923"
                                        Style="{DynamicResource CommonTextBlockStyle}">
                                        <Run FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont" Text="&#xe6e2;" />
                                        <Run Text="这样做，更高效！" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Foreground="#7A8187"
                                        LineHeight="18"
                                        Style="{DynamicResource CommonTextBlockStyle}"
                                        Text="手机管理器配置过程约3分钟，您可以边做流程边等待配置，以高效完成流程设计。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <ContentPresenter x:Name="RootContentDialog" Grid.RowSpan="2" />
    </Grid>
</coreui:FluentWindow>
