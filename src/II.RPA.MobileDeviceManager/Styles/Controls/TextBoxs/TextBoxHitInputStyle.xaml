<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <VisualBrush
        x:Key="HintInputText"
        AlignmentX="Left"
        Stretch="None"
        TileMode="None">
        <VisualBrush.Visual>
            <TextBlock
                Margin="8,0,0,0"
                Padding="8,0,0,0"
                FontSize="12"
                Foreground="#66505962"
                Text="{DynamicResource HomeModule.Process.SearchBoxWaterText}" />
        </VisualBrush.Visual>
    </VisualBrush>

    <Style x:Key="TextBoxHitInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource CodeMasterFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="borderWaterMark" VerticalAlignment="Center">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="borderWaterMark" Property="Background" Value="{StaticResource HintInputText}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="borderWaterMark" Property="Background" Value="{StaticResource HintInputText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="PasswdBoxgHitInputStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource CodeMasterFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxLength" Value="128" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>
                        <Border
                            x:Name="borderContentHost"
                            Grid.Column="1"
                            Height="32"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#CCCCCD"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Border
                                x:Name="borderWaterMark"
                                Margin="10,3,10,5"
                                VerticalAlignment="Center">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="borderContentHost" Property="BorderBrush" Value="#FFCCCCCD" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borderContentHost" Property="BorderBrush" Value="#FFF76900" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borderContentHost" Property="BorderBrush" Value="#FFF76900" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>