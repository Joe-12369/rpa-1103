<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/II.RPA.MobileDeviceManager;component/Styles/Controls/TextBlocks/Default.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style
        x:Key="CommonTextBlockTitleStyle"
        BasedOn="{StaticResource CommonTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft Yahei" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#161923" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ShellUserNameTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft Yahei" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#FF323232" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ShellUserSettingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft Yahei" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="#FF161923" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
</ResourceDictionary>