<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://ii.rpa/handycontrol"
    xmlns:rc="https://ii.rpa/control">
    <Style x:Key="TbkHover" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFF9810" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ButtonHover" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFF9810" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>