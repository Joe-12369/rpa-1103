<UserControl
    x:Class="II.RPA.MobileDeviceManager.Controls.IIProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.MobileDeviceManager.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="150"
    mc:Ignorable="d">
    <Grid Name="layout" Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}">
        <Ellipse
            Name="backEllipse"
            Stroke="{Binding BackColor, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
            StrokeThickness="8" />
        <Path
            Name="path"
            Data="M75.001 5 A70 70 0 1 1 75 5"
            Stroke="{Binding ForeColor, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
            StrokeThickness="6" />
        <Viewbox Margin="25">
            <TextBlock
                x:Name="percentText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{Binding ElementName=root, Path=Foreground}"
                Text="{Binding Value, ElementName=root}" />
        </Viewbox>
        <Grid Margin="0,-3,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Canvas>
                <TextBlock
                    Canvas.Right="8"
                    HorizontalAlignment="Right"
                    FontSize="9"
                    Foreground="#55ffffff"
                    Text="{Binding ElementName=root, Path=Header}" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
