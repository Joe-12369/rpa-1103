<UserControl
    x:Class="II.RPA.MobileDeviceManager.Views.DeviceScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.MobileDeviceManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rc="https://ii.rpa/control"
    xmlns:valconvert="clr-namespace:II.RPA.MobileDeviceManager.ValueTypeConvert"
    xmlns:zxc="clr-namespace:II.RPA.MobileDeviceManager.Controls"
    d:DesignHeight="600"
    d:DesignWidth="300"
    SizeChanged="DeviceSimulatorView_SizeChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <valconvert:Bool2VisibilityConverter x:Key="Bool2VisibilityConverter" />
        <valconvert:Bool2VisibilityInvertConverter x:Key="Bool2VisibilityInvertConverter" />
    </UserControl.Resources>
    <Grid Margin="20,0,20,0">
        <Grid Visibility="{Binding IsShowConnecting, Converter={StaticResource Bool2VisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        MaxWidth="100"
                        FontSize="12"
                        Foreground="#848A90"
                        Text="{Binding DeviceName}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        x:Name="positionM"
                        Orientation="Horizontal"
                        Visibility="Visible">
                        <TextBlock
                            Margin="96,0,0,0"
                            FontSize="12"
                            Foreground="#848A90"
                            Text="X：" />
                        <TextBlock
                            x:Name="positionX"
                            Margin="0,0,0,0"
                            FontSize="12"
                            Foreground="#848A90"
                            Text="-" />
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="12"
                            Foreground="#848A90"
                            Text="Y：" />
                        <TextBlock
                            x:Name="positionY"
                            Margin="0,0,0,0"
                            FontSize="12"
                            Foreground="#848A90"
                            Text="-" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="connectLoading">
                    <!--
                        MinWidth="300"
                        MinHeight="600"
                    -->
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        Background="#FFFFFF"
                        Orientation="Vertical">
                        <zxc:GifPlayBox
                            Width="122"
                            Height="122"
                            Margin="0,178,0,0"
                            HorizontalAlignment="Center"
                            GifUrl="./Resources/Images/connectloading.gif" />
                        <TextBlock
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Microsoft YaHei;"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#161923"
                            LineHeight="20"
                            Text="设备连接中..." />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Microsoft YaHei;"
                            FontSize="12"
                            FontWeight="Regular"
                            Foreground="#7A8187"
                            LineHeight="18"
                            Text="请保持手机当前状态" />
                    </StackPanel>
                </Grid>
                <Grid
                    Name="hostVertical"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                    <Grid Name="gridVertical">
                        <Image Name="imageVertical" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <Grid
                    Name="hostHorizontal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Visibility="Collapsed">
                    <Grid Name="gridHorizontal">
                        <Image Name="imageHorizontal" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Border
                    Width="204"
                    Height="40"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="#FFFFFF"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="0"
                            Opacity="0.2"
                            ShadowDepth="0"
                            Color="#000000" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <rc:IconButton
                            Width="21"
                            Height="21"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center"
                            AllowsAnimation="False"
                            Command="{Binding BackCommand}"
                            Cursor="Hand"
                            FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                            FontSize="12"
                            Foreground="#7A8187"
                            Icon="&#xe632;" />
                        <rc:IconButton
                            Width="21"
                            Height="21"
                            Margin="40,0,0,0"
                            VerticalAlignment="Center"
                            AllowsAnimation="False"
                            Command="{Binding HomeCommand}"
                            Cursor="Hand"
                            FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                            FontSize="12"
                            Foreground="#7A8187"
                            Icon="&#xe638;" />
                        <rc:IconButton
                            Width="21"
                            Height="21"
                            Margin="40,0,0,0"
                            VerticalAlignment="Center"
                            AllowsAnimation="False"
                            Command="{Binding SwitchCommand}"
                            Cursor="Hand"
                            FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                            FontSize="12"
                            Foreground="#7A8187"
                            Icon="&#xe634;" />
                    </StackPanel>
                </Border>
                <Border
                    Width="40"
                    Height="40"
                    Margin="12,0,0,12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="#FFFFFF"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="0"
                            Opacity="0.2"
                            ShadowDepth="0"
                            Color="#000000" />
                    </Border.Effect>
                    <rc:IconButton
                        Width="21"
                        Height="21"
                        VerticalAlignment="Center"
                        AllowsAnimation="False"
                        Command="{Binding RevolveScreenCommand}"
                        Cursor="Hand"
                        FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                        FontSize="12"
                        Foreground="#7A8187"
                        Icon="&#xe633;" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsShowAnimeTipsFirst, Converter={StaticResource Bool2VisibilityConverter}}">
            <Border Background="#F1F4F7" CornerRadius="0,0,8,8">
                <StackPanel Margin="0,40,0,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="20"
                            Height="20"
                            Background="#FF8910"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FFFFFF"
                                Text="1" />
                        </Border>
                        <TextBlock
                            Margin="8,5,0,0"
                            FontFamily="Microsoft YaHei"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#161923"
                            LineHeight="22"
                            Text="手机连接电脑，并打开调试模式" />

                    </StackPanel>
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Microsoft YaHei"
                        FontSize="12"
                        FontWeight="Regular"
                        Foreground="#000000"
                        LineHeight="18"
                        Text="如何开启调试？" />
                    <zxc:GifPlayBox
                        Width="260"
                        Height="582"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        GifUrl="./Resources/Images/tips_01.gif" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsShowAnimeTipsSecond, Converter={StaticResource Bool2VisibilityConverter}}">
            <Border Background="#F1F4F7" CornerRadius="0,0,8,8">
                <StackPanel Margin="0,40,0,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="20"
                            Height="20"
                            Background="#FF8910"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FFFFFF"
                                Text="2" />
                        </Border>
                        <TextBlock
                            Margin="8,5,0,0"
                            FontFamily="Microsoft YaHei"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#161923"
                            LineHeight="22"
                            Text="手机连接电脑，并打开调试模式" />

                    </StackPanel>
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Microsoft YaHei"
                        FontSize="12"
                        FontWeight="Regular"
                        Foreground="#000000"
                        LineHeight="18"
                        Text="如何开启调试？" />
                    <zxc:GifPlayBox
                        Width="260"
                        Height="582"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        GifUrl="./Resources/Images/tips_02.gif" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsShowConnectFail, Converter={StaticResource Bool2VisibilityConverter}}">
            <!--<Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F1F4F7"
                CornerRadius="0,0,8,8">-->
            <StackPanel
                Margin="0,200,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <Image
                    Width="122"
                    Height="122"
                    Source="{StaticResource DisConnect}" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Microsoft YaHei"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#161923"
                    LineHeight="20"
                    Text="连接失败" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Microsoft YaHei"
                    FontSize="12"
                    FontWeight="Regular"
                    Foreground="#161923"
                    LineHeight="18">
                    <Run Text="请插拔设备后重新连接，或" />
                    <Hyperlink
                        NavigateUri="https://rpa-college.ai-indeed.com/doc/7345.html"
                        RequestNavigate="Hyperlink_RequestNavigate"
                        TextDecorations="None">
                        <Run
                            Cursor="Hand"
                            Foreground="#FF8910"
                            Text="查看帮助" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <!--</Border>-->
        </Grid>

        <Grid Visibility="{Binding IsShowDisConnect, Converter={StaticResource Bool2VisibilityConverter}}">
            <StackPanel
                Margin="0,200,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <Image
                    Width="122"
                    Height="122"
                    Source="{StaticResource DisConnect}" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Microsoft YaHei"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#161923"
                    LineHeight="20"
                    Text="暂未连接手机" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Microsoft YaHei"
                    FontSize="12"
                    FontWeight="Regular"
                    Foreground="#7A8187"
                    LineHeight="18">
                    <Run Text="请连接已有手机，或" />
                    <Run
                        Cursor="Hand"
                        Foreground="#FF8910"
                        MouseLeftButtonDown="Run_MouseLeftButtonDown"
                        Text="添加新手机" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
