<ui:FluentWindow
    x:Class="II.RPA.MobileDeviceManager.Views.ModifyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.MobileDeviceManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rc="https://ii.rpa/control"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility"
    Title="ModifyWindow"
    Width="360"
    Height="228"
    MinWidth="360"
    MinHeight="228"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Window.ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="#7FF2F5F7">
            <TextBlock
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#161923"
                Text="设备名称" />
            <StackPanel
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <rc:IconButton
                    Width="21"
                    Height="21"
                    Margin="0,0,12,0"
                    AllowsAnimation="False"
                    Click="CloseWin_Click"
                    Cursor="Hand"
                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                    Foreground="#5E5E5E"
                    Icon="&#xe6e7;"
                    IconSize="16" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Background="#FFFFFF">
            <StackPanel
                Margin="0,30,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Text="设备名称" />
                <!--<rc:TextBoxWithWatermark
                    x:Name="DeviceNameTxt"
                    Width="240"
                    Height="32"
                    Margin="20,0,0,0"
                    Foreground="#161923"
                    Watermark="请输入设备名称" />-->
                <TextBox
                    x:Name="DeviceNameTxt"
                    Width="240"
                    Height="32"
                    Margin="20,0,0,0"
                    FontSize="12"
                    Foreground="#161923"
                    Style="{StaticResource WatermarkTextBoxStyle}" />

            </StackPanel>
            <StackPanel
                Margin="0,24,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Text="设备ID" />
                <TextBox
                    x:Name="DeviceIdTxt"
                    Width="240"
                    Height="32"
                    Margin="32,0,0,0"
                    Background="#ECEEF2"
                    BorderBrush="#D9DDE6"
                    Foreground="#848A90"
                    IsEnabled="False">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#ECEEF2" />
                                    <Setter Property="BorderBrush" Value="#D9DDE6" />
                                    <Setter Property="Foreground" Value="#848A90" />
                                    <Setter Property="Padding" Value="7,0,0,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

            </StackPanel>
            <StackPanel
                Margin="0,20,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <rc:CommonButton
                    Width="80"
                    Height="30"
                    Background="#FFFFFF"
                    BorderBrush="#D9DDE6 "
                    BorderThickness="1"
                    Click="CloseWin_Click"
                    Content="{x:Static res:II_RPA_Resource.ModifyWindow_949856B3}"
                    Foreground="#505962"
                    MouseOverBackground="#FFFFFF"
                    MouseOverBorderBrush="#D9DDE6"
                    MouseOverForeground="#505962" />
                <rc:CommonButton
                    Width="80"
                    Height="30"
                    Margin="12,0,0,0"
                    Background="#FF8910"
                    BorderThickness="0"
                    Click="Confirm_Click"
                    Content="{x:Static res:II_RPA_Resource.ModifyWindow_621A8231}"
                    Foreground="White"
                    MouseOverBackground="#AAFF8910"
                    MouseOverForeground="White" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
