<UserControl
    x:Class="II.RPA.MobileDeviceManager.Views.DeviceListBoxItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:II.RPA.MobileDeviceManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rc="https://ii.rpa/control"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    xmlns:res="clr-namespace:II.RPA.WinAutomation.CommonUtility.Resource;assembly=II.RPA.WinAutomation.CommonUtility">
    <UserControl.Resources>
        <Style x:Key="DeviceInfoListStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid
                            x:Name="grid"
                            Height="32"
                            MaxWidth="192">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="10"
                                    Height="14"
                                    Margin="11,9,0,9"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                                        FontSize="14"
                                        Foreground="#7A8187"
                                        Text="&#xe894;" />
                                </Border>
                                <TextBlock
                                    Width="96"
                                    Margin="10,7,0,0"
                                    FontFamily="Microsoft YaHei;"
                                    FontSize="13"
                                    Text="{Binding Name}" />
                                <StackPanel
                                    x:Name="btnControls"
                                    Margin="0,6,4,0"
                                    HorizontalAlignment="Right"
                                    Visibility="Hidden">
                                    <rc:CommonButton
                                        Width="32"
                                        Height="20"
                                        Background="#FF8910"
                                        Click="Connect_Click"
                                        Content="{x:Static res:II_RPA_Resource.DeviceListBoxItem_1EF591AC}"
                                        CornerRadius="2"
                                        FontSize="12"
                                        Foreground="#FFFFFF"
                                        Visibility="Visible" />
                                    <rc:CommonButton
                                        Width="32"
                                        Height="20"
                                        Background="#9CABB9"
                                        Command="{Binding DataContext.DisConnectCommand}"
                                        Content="{x:Static res:II_RPA_Resource.DeviceListBoxItem_24865DA8}"
                                        CornerRadius="2"
                                        FontSize="12"
                                        Foreground="#7A8187"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <rc:IconButton
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AllowsAnimation="False"
                                    FontFamily="/II.RPA.MobileDeviceManager;component/Icon/#iconfont"
                                    Foreground="#7A8187"
                                    Icon="&#xe6ca;"
                                    IconMargin="0"
                                    IconSize="16"
                                    MouseOverForeground="#9CABB9" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="grid" Property="Background" Value="#F4F6F8" />
                                <Setter TargetName="btnControls" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="false">
                                <Setter TargetName="grid" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="btnControls" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ListBox
        x:Name="DeviceInfoList"
        Width="auto"
        Height="auto"
        Margin="0,11,0,0"
        Background="Transparent"
        BorderBrush="#eaeaeb"
        BorderThickness="0"
        ItemContainerStyle="{StaticResource DeviceInfoListStyle}"
        ItemsSource="{Binding Devices}">
        <ListBox.Style>
            <Style TargetType="ListBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border
                                x:Name="Bd"
                                Padding="0,0,0,4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.Style>
    </ListBox>

</UserControl>
