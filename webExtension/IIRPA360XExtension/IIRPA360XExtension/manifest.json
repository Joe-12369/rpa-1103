{
"update_url": "https://clients2.google.com/service/update2/crx",

  "name": "实在智能 RPA 插件",
  "version": "2.7",
  "description": "Ai-indeed WebBrowser Automation",
  "web_accessible_resources": ["executor/index.js"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "permissions": [
    "nativeMessaging",
    "management",
    "tabs",
    "webNavigation",
    "cookies",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "debugger",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "jquery.js",
      "rpa_server.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "match_about_blank": true,
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*",
        "ftp://*/*"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/AiIndeedRPA16.png",
    "48": "icons/AiIndeedRPA48.png",
    "128": "icons/AiIndeedRPA128.png"
  },
  "manifest_version": 2
}